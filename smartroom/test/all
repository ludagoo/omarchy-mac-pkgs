#!/bin/bash
# Every SmartRoom recipe test (Linux, offline, no root): smartroom/test/*-test.sh.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
fail=0
for t in "$here"/*-test.sh; do
  echo "== ${t##*/}"
  bash "$t" || { echo "FAIL ${t##*/}"; fail=1; }
done
release=$here/../../smartroom-release/test/all
echo "== smartroom-release/test/all"
if [[ ! -f $release ]]; then
  echo "FAIL smartroom-release/test/all is missing"
  fail=1
else
  bash "$release" || { echo "FAIL smartroom-release/test/all"; fail=1; }
fi
(( fail == 0 )) && echo "all SmartRoom recipe tests passed"
exit $fail
