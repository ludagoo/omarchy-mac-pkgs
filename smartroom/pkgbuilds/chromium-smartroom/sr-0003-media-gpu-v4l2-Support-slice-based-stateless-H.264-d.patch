diff --git a/media/gpu/v4l2/v4l2_h264_slice.cc b/media/gpu/v4l2/v4l2_h264_slice.cc
new file mode 100644
index 0000000..8a0ea1b
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_h264_slice.cc
@@ -0,0 +1,199 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/v4l2_h264_slice.h"
+
+#include <algorithm>
+
+#include "base/logging.h"
+#include "media/gpu/macros.h"
+
+namespace media {
+
+bool H264DecodeModeIsSliceBased(int32_t decode_mode) {
+  return decode_mode == V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED;
+}
+
+bool H264DecodeModeNeedsRefLists(int32_t decode_mode) {
+  return H264DecodeModeIsSliceBased(decode_mode);
+}
+
+int32_t ChooseH264DecodeMode(int32_t default_mode, bool frame_based_offered) {
+  return frame_based_offered ? V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED
+                             : default_mode;
+}
+
+size_t H264StartCodePrefixSize(int32_t start_code) {
+  return start_code == V4L2_STATELESS_H264_START_CODE_NONE ? 0u : 3u;
+}
+
+size_t H264NalPayloadSize(base::span<const uint8_t> nal, bool raw_nal) {
+  size_t payload = nal.size();
+  if (raw_nal) {
+    while (payload > 1 && nal[payload - 1] == 0x00) {
+      --payload;
+    }
+  }
+  return payload;
+}
+
+int FindH264DpbIndex(base::span<H264Picture* const> dpb,
+                     const H264Picture* pic) {
+  if (!pic) {
+    return -1;
+  }
+  for (size_t i = 0; i < dpb.size(); ++i) {
+    if (dpb[i] == pic) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+bool FillH264RefList(base::span<H264Picture* const> dpb,
+                     const H264Picture::Vector& refs,
+                     v4l2_h264_reference* out,
+                     int count,
+                     bool repeat_spare_slots) {
+  if (count < 0 || count > V4L2_H264_REF_LIST_LEN || !out) {
+    return false;
+  }
+  // The slice header asks for num_ref_idx_lX_active entries. Early in a GOP
+  // fewer reference pictures exist, and the parser leaves the spare slots
+  // null.
+  int fallback = -1;
+  for (int i = 0; i < count; ++i) {
+    int index = -1;
+    if (i < static_cast<int>(refs.size()) && refs[i]) {
+      index = FindH264DpbIndex(dpb, refs[i].get());
+      if (index < 0) {
+        return false;
+      }
+      fallback = index;
+    } else if (repeat_spare_slots && fallback >= 0) {
+      index = fallback;
+    } else {
+      return false;
+    }
+    out[i].index = static_cast<__u8>(index);
+    out[i].fields = V4L2_H264_FRAME_REF;
+  }
+  return true;
+}
+
+bool FillH264SliceParams(const H264PPS* pps,
+                         const H264SliceHeader* slice_hdr,
+                         base::span<H264Picture* const> dpb,
+                         const H264Picture::Vector& ref_pic_list0,
+                         const H264Picture::Vector& ref_pic_list1,
+                         bool repeat_spare_slots,
+                         v4l2_ctrl_h264_slice_params* slice,
+                         v4l2_ctrl_h264_pred_weights* weights,
+                         bool* pred_weights_required) {
+  if (!pps || !slice_hdr || !slice || !weights || !pred_weights_required) {
+    return false;
+  }
+  if (slice_hdr->header_bit_size < 0) {
+    return false;
+  }
+
+  const int slice_type = slice_hdr->slice_type % 5;
+  *slice = {};
+  // header_bit_size counts RBSP bits from the first byte of the NAL (the NAL
+  // header), with emulation-prevention bytes excluded. The kernel scanner
+  // skips those bytes itself and adds the CABAC alignment.
+  slice->header_bit_size = static_cast<__u32>(slice_hdr->header_bit_size);
+  slice->first_mb_in_slice = static_cast<__u32>(slice_hdr->first_mb_in_slice);
+  slice->slice_type = static_cast<__u8>(slice_type);
+  slice->colour_plane_id = static_cast<__u8>(slice_hdr->colour_plane_id);
+  slice->redundant_pic_cnt = static_cast<__u8>(slice_hdr->redundant_pic_cnt);
+  slice->cabac_init_idc = static_cast<__u8>(slice_hdr->cabac_init_idc);
+  slice->slice_qp_delta = static_cast<__s8>(slice_hdr->slice_qp_delta);
+  slice->slice_qs_delta = static_cast<__s8>(slice_hdr->slice_qs_delta);
+  slice->disable_deblocking_filter_idc =
+      static_cast<__u8>(slice_hdr->disable_deblocking_filter_idc);
+  slice->slice_alpha_c0_offset_div2 =
+      static_cast<__s8>(slice_hdr->slice_alpha_c0_offset_div2);
+  slice->slice_beta_offset_div2 =
+      static_cast<__s8>(slice_hdr->slice_beta_offset_div2);
+  slice->num_ref_idx_l0_active_minus1 =
+      static_cast<__u8>(slice_hdr->num_ref_idx_l0_active_minus1);
+  slice->num_ref_idx_l1_active_minus1 =
+      static_cast<__u8>(slice_hdr->num_ref_idx_l1_active_minus1);
+  if (slice_type == V4L2_H264_SLICE_TYPE_B &&
+      slice_hdr->direct_spatial_mv_pred_flag) {
+    slice->flags |= V4L2_H264_SLICE_FLAG_DIRECT_SPATIAL_MV_PRED;
+  }
+  if (slice_hdr->sp_for_switch_flag) {
+    slice->flags |= V4L2_H264_SLICE_FLAG_SP_FOR_SWITCH;
+  }
+
+  if (slice_type == V4L2_H264_SLICE_TYPE_P ||
+      slice_type == V4L2_H264_SLICE_TYPE_SP ||
+      slice_type == V4L2_H264_SLICE_TYPE_B) {
+    if (!FillH264RefList(dpb, ref_pic_list0, slice->ref_pic_list0,
+                         slice_hdr->num_ref_idx_l0_active_minus1 + 1,
+                         repeat_spare_slots)) {
+      VLOGF(1) << "H.264 L0 reference is not in the DPB"
+               << " list=" << ref_pic_list0.size()
+               << " active=" << (slice_hdr->num_ref_idx_l0_active_minus1 + 1)
+               << " dpb=" << dpb.size();
+      return false;
+    }
+  }
+  if (slice_type == V4L2_H264_SLICE_TYPE_B) {
+    if (!FillH264RefList(dpb, ref_pic_list1, slice->ref_pic_list1,
+                         slice_hdr->num_ref_idx_l1_active_minus1 + 1,
+                         repeat_spare_slots)) {
+      VLOGF(1) << "H.264 L1 reference is not in the DPB"
+               << " list=" << ref_pic_list1.size()
+               << " active=" << (slice_hdr->num_ref_idx_l1_active_minus1 + 1)
+               << " dpb=" << dpb.size();
+      return false;
+    }
+  }
+
+  *pred_weights_required = false;
+  const bool weighted =
+      (pps->weighted_pred_flag && (slice_type == V4L2_H264_SLICE_TYPE_P ||
+                                   slice_type == V4L2_H264_SLICE_TYPE_SP)) ||
+      (pps->weighted_bipred_idc == 1 && slice_type == V4L2_H264_SLICE_TYPE_B);
+  if (weighted) {
+    *pred_weights_required = true;
+    *weights = {};
+    weights->luma_log2_weight_denom =
+        static_cast<__u16>(slice_hdr->luma_log2_weight_denom);
+    weights->chroma_log2_weight_denom =
+        static_cast<__u16>(slice_hdr->chroma_log2_weight_denom);
+    const int n0 = std::min(slice_hdr->num_ref_idx_l0_active_minus1 + 1, 32);
+    const int n1 = std::min(slice_hdr->num_ref_idx_l1_active_minus1 + 1, 32);
+    for (int i = 0; i < n0; ++i) {
+      weights->weight_factors[0].luma_weight[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l0.luma_weight[i]);
+      weights->weight_factors[0].luma_offset[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l0.luma_offset[i]);
+      for (int j = 0; j < 2; ++j) {
+        weights->weight_factors[0].chroma_weight[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l0.chroma_weight[i][j]);
+        weights->weight_factors[0].chroma_offset[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l0.chroma_offset[i][j]);
+      }
+    }
+    for (int i = 0; i < n1; ++i) {
+      weights->weight_factors[1].luma_weight[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l1.luma_weight[i]);
+      weights->weight_factors[1].luma_offset[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l1.luma_offset[i]);
+      for (int j = 0; j < 2; ++j) {
+        weights->weight_factors[1].chroma_weight[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l1.chroma_weight[i][j]);
+        weights->weight_factors[1].chroma_offset[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l1.chroma_offset[i][j]);
+      }
+    }
+  }
+  return true;
+}
+
+}  // namespace media
diff --git a/media/gpu/v4l2/v4l2_h264_slice.h b/media/gpu/v4l2/v4l2_h264_slice.h
new file mode 100644
index 0000000..0a3cd13
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_h264_slice.h
@@ -0,0 +1,69 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_GPU_V4L2_V4L2_H264_SLICE_H_
+#define MEDIA_GPU_V4L2_V4L2_H264_SLICE_H_
+
+#include <linux/v4l2-controls.h>
+
+#include <stdint.h>
+
+#include <vector>
+
+#include "base/containers/span.h"
+#include "media/gpu/h264_dpb.h"
+#include "media/parsers/h264_parser.h"
+
+namespace media {
+
+// The driver's default decode mode. Slice-based devices want one slice per
+// request and V4L2_CID_STATELESS_H264_SLICE_PARAMS. Frame-based devices parse
+// the slice header themselves and keep the historical path.
+bool H264DecodeModeIsSliceBased(int32_t decode_mode);
+
+// True when the parser must build ref_pic_list0/1. Frame-based hardware does
+// that itself, so the default (false) stays.
+bool H264DecodeModeNeedsRefLists(int32_t decode_mode);
+
+// FRAME_BASED whenever the device offers it, so a device that supports both
+// modes stays on the frame-based path. Otherwise the driver's default.
+int32_t ChooseH264DecodeMode(int32_t default_mode, bool frame_based_offered);
+
+// Annex-B devices want a 3-byte start code. START_CODE_NONE wants the raw NAL.
+size_t H264StartCodePrefixSize(int32_t start_code);
+
+// A raw NAL ends on rbsp_trailing_bits. Trailing 0x00 bytes are the next
+// start code's zero_byte, which some clients leave attached. A slice-based
+// decoder treats them as slice data. |raw_nal| is false for Annex-B, which
+// keeps every byte. Returns 0 when nothing remains.
+size_t H264NalPayloadSize(base::span<const uint8_t> nal, bool raw_nal);
+
+// Index of |pic| in |dpb|, or -1. Slice reference lists name these slots.
+int FindH264DpbIndex(base::span<H264Picture* const> dpb, const H264Picture* pic);
+
+// Fills |count| entries of |out| from |refs|. |count| is
+// num_ref_idx_lX_active_minus1 + 1. When |repeat_spare_slots| is set, a null
+// slot early in a GOP repeats the last real reference: the driver checks every
+// active index, and the bitstream does not address the spare ones. A real
+// reference that is not in |dpb| still fails.
+bool FillH264RefList(base::span<H264Picture* const> dpb,
+                     const H264Picture::Vector& refs,
+                     v4l2_h264_reference* out,
+                     int count,
+                     bool repeat_spare_slots);
+
+// One slice of a picture. Does not decide how many requests the picture uses.
+bool FillH264SliceParams(const H264PPS* pps,
+                         const H264SliceHeader* slice_hdr,
+                         base::span<H264Picture* const> dpb,
+                         const H264Picture::Vector& ref_pic_list0,
+                         const H264Picture::Vector& ref_pic_list1,
+                         bool repeat_spare_slots,
+                         v4l2_ctrl_h264_slice_params* slice,
+                         v4l2_ctrl_h264_pred_weights* weights,
+                         bool* pred_weights_required);
+
+}  // namespace media
+
+#endif  // MEDIA_GPU_V4L2_V4L2_H264_SLICE_H_
diff --git a/media/gpu/v4l2/v4l2_h264_slice_unittest.cc b/media/gpu/v4l2/v4l2_h264_slice_unittest.cc
new file mode 100644
index 0000000..d81fe29
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_h264_slice_unittest.cc
@@ -0,0 +1,121 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/v4l2_h264_slice.h"
+
+#include "base/memory/scoped_refptr.h"
+#include "media/gpu/h264_dpb.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace media {
+namespace {
+
+scoped_refptr<H264Picture> MakePic(int frame_num, bool is_ref, bool long_term) {
+  auto pic = base::MakeRefCounted<H264Picture>();
+  pic->frame_num = frame_num;
+  pic->pic_num = frame_num;
+  pic->ref = is_ref;
+  pic->long_term = long_term;
+  if (long_term) {
+    pic->long_term_frame_idx = frame_num;
+    pic->long_term_pic_num = frame_num;
+  }
+  pic->top_field_order_cnt = frame_num * 2;
+  pic->bottom_field_order_cnt = frame_num * 2;
+  return pic;
+}
+
+}  // namespace
+
+TEST(V4L2H264SliceTest, SliceModeIsNotTheFrameBasedDefault) {
+  EXPECT_FALSE(H264DecodeModeIsSliceBased(
+      V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED));
+  EXPECT_FALSE(H264DecodeModeNeedsRefLists(
+      V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED));
+  EXPECT_TRUE(H264DecodeModeIsSliceBased(
+      V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED));
+  EXPECT_TRUE(H264DecodeModeNeedsRefLists(
+      V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED));
+}
+
+TEST(V4L2H264SliceTest, FrameBasedWheneverOffered) {
+  EXPECT_EQ(V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+            ChooseH264DecodeMode(V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED,
+                                 /*frame_based_offered=*/true));
+  EXPECT_EQ(V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+            ChooseH264DecodeMode(V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+                                 /*frame_based_offered=*/true));
+  EXPECT_EQ(V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED,
+            ChooseH264DecodeMode(V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED,
+                                 /*frame_based_offered=*/false));
+}
+
+TEST(V4L2H264SliceTest, StartCodeAndTrailingZeros) {
+  EXPECT_EQ(3u, H264StartCodePrefixSize(
+                    V4L2_STATELESS_H264_START_CODE_ANNEX_B));
+  EXPECT_EQ(0u, H264StartCodePrefixSize(V4L2_STATELESS_H264_START_CODE_NONE));
+
+  const uint8_t nal[] = {0x65, 0x88, 0x84, 0x00, 0x00};
+  EXPECT_EQ(5u, H264NalPayloadSize(nal, /*raw_nal=*/false));
+  // One payload byte is kept so a NAL of only zeros is not emptied by the
+  // trim, and the attached zero_byte of the next start code is dropped.
+  EXPECT_EQ(3u, H264NalPayloadSize(nal, /*raw_nal=*/true));
+  EXPECT_EQ(0u, H264NalPayloadSize({}, /*raw_nal=*/true));
+}
+
+TEST(V4L2H264SliceTest, RefListMapsSlotsAndRepeatsSpare) {
+  auto ref0 = MakePic(1, true, false);
+  auto ref1 = MakePic(2, true, false);
+  std::vector<H264Picture*> dpb = {ref0.get(), ref1.get()};
+  H264Picture::Vector refs = {ref1, nullptr, nullptr};
+  v4l2_h264_reference out[4] = {};
+
+  EXPECT_FALSE(FillH264RefList(dpb, refs, out, 3, /*repeat_spare_slots=*/false));
+
+  ASSERT_TRUE(FillH264RefList(dpb, refs, out, 3, /*repeat_spare_slots=*/true));
+  EXPECT_EQ(1u, out[0].index);
+  EXPECT_EQ(1u, out[1].index);
+  EXPECT_EQ(1u, out[2].index);
+  EXPECT_EQ(V4L2_H264_FRAME_REF, out[0].fields);
+
+  H264Picture::Vector missing = {MakePic(9, true, false)};
+  EXPECT_FALSE(
+      FillH264RefList(dpb, missing, out, 1, /*repeat_spare_slots=*/true));
+}
+
+TEST(V4L2H264SliceTest, ISliceHasNoRefListAndPSliceDoes) {
+  auto ref = MakePic(4, true, false);
+  std::vector<H264Picture*> dpb = {ref.get()};
+  H264PPS pps;
+  H264SliceHeader i_slice;
+  i_slice.slice_type = H264SliceHeader::kISlice;
+  i_slice.header_bit_size = 40;
+  i_slice.first_mb_in_slice = 0;
+  i_slice.slice_qp_delta = 2;
+  v4l2_ctrl_h264_slice_params slice = {};
+  v4l2_ctrl_h264_pred_weights weights = {};
+  bool pred_weights = true;
+  ASSERT_TRUE(FillH264SliceParams(&pps, &i_slice, dpb, {}, {}, true, &slice,
+                                  &weights, &pred_weights));
+  EXPECT_EQ(40u, slice.header_bit_size);
+  EXPECT_EQ(V4L2_H264_SLICE_TYPE_I, slice.slice_type);
+  EXPECT_EQ(2, slice.slice_qp_delta);
+  EXPECT_FALSE(pred_weights);
+  EXPECT_EQ(0u, slice.ref_pic_list0[0].fields);
+
+  H264SliceHeader p_slice;
+  p_slice.slice_type = H264SliceHeader::kPSlice;
+  p_slice.header_bit_size = 24;
+  p_slice.num_ref_idx_l0_active_minus1 = 0;
+  H264Picture::Vector refs = {ref};
+  pred_weights = true;
+  ASSERT_TRUE(FillH264SliceParams(&pps, &p_slice, dpb, refs, {}, true, &slice,
+                                  &weights, &pred_weights));
+  EXPECT_EQ(V4L2_H264_SLICE_TYPE_P, slice.slice_type);
+  EXPECT_EQ(0u, slice.ref_pic_list0[0].index);
+  EXPECT_EQ(V4L2_H264_FRAME_REF, slice.ref_pic_list0[0].fields);
+  EXPECT_FALSE(pred_weights);
+}
