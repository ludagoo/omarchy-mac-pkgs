From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lucas Goossen <lucas.goossen@hey.com>
Date: Fri, 20 Nov 2026 15:20:00 -0300
Subject: [PATCH] room: Copy V4L2 encoder input into a device-sized buffer

Apple's AVE pads the NV12 input height to a multiple of 16 in the
sizeimage it reports (640x360 -> 640x368, 353280 bytes), but reads the
picture as the driver's own format says: Y for 360 rows, then the chroma
plane right after them. Chromium sizes the shared memory it hands the
encoder from the visible size (345600 bytes), and the USERPTR path in
EnqueueInputRecord() rejects it ("Input shmem smaller than device
requirements for plane 0: size=353280, shm_size=345600"). WebRTC falls
back to OpenH264 for the rest of the call, so every 640x360 layer of a
Zoom class was encoded in software. 1280x720 is a multiple of 16 and is
not affected, which is why the loopback test at 720p never saw it.

Queue the frame's own memory only when it covers the plane sizes the
driver asked for and has the driver's strides and plane offsets.
Otherwise copy the picture into a page-aligned buffer of the size the
driver asked for, laid out as the driver's format says, and queue that.
The copy is one 345 KB memcpy per 640x360 frame. The buffers belong to the
input buffer index, so they stay valid until the driver is done with the
frame.

Room package only (the upstream follow-up patch is separate).

Assisted-by: Claude:claude-opus-5-5
---
 media/gpu/v4l2/v4l2_video_encode_accelerator.cc | 126 ++++++++++++++++++++++++++++++-------
 media/gpu/v4l2/v4l2_video_encode_accelerator.h | 16 ++++++++++++++++
 2 files changed, 135 insertions(+), 7 deletions(-)

diff --git a/media/gpu/v4l2/v4l2_video_encode_accelerator.cc b/media/gpu/v4l2/v4l2_video_encode_accelerator.cc
--- a/media/gpu/v4l2/v4l2_video_encode_accelerator.cc
+++ b/media/gpu/v4l2/v4l2_video_encode_accelerator.cc
@@ -12,6 +12,7 @@
 #include <sys/ioctl.h>
 #include <sys/mman.h>
 
+#include <algorithm>
 #include <memory>
 #include <numeric>
 #include <optional>
@@ -26,6 +27,7 @@
 #include "base/functional/callback_helpers.h"
 #include "base/memory/shared_memory_mapping.h"
 #include "base/memory/unsafe_shared_memory_region.h"
+#include "base/numerics/checked_math.h"
 #include "base/numerics/safe_conversions.h"
 #include "base/strings/strcat.h"
 #include "base/strings/string_number_conversions.h"
@@ -1699,9 +1701,19 @@
                        "VideoFrame doesn't have shared memory"});
         return false;
       }
+      // The driver reads |device_input_layout_->planes()[i].size| bytes of
+      // every plane (its sizeimage), and sizeimage may be larger than the
+      // frame: Apple's AVE pads the height to a multiple of 16, so a 640x360
+      // frame needs 640x368 bytes of memory (the picture itself ends at 360
+      // rows, the chroma plane starts right after them). A client that sized
+      // its shared memory from the visible size, as WebRTC does, hands over
+      // less. Queue the frame's own memory when it covers what the driver
+      // reads and has the layout the driver expects; otherwise copy it into
+      // a device-sized buffer.
       // The frame data is readable only and the driver doesn't actually write
       // the buffer. But USRPTR buffer needs void*. So const_cast<> is required.
       std::vector<void*> user_ptrs(num_planes);
+      bool frame_memory_fits = true;
       for (size_t i = 0; i < num_planes; ++i) {
         const size_t plane_offset = frame->layout().planes()[i].offset;
         const size_t plane_size = device_input_layout_->planes()[i].size;
@@ -1714,16 +1726,35 @@
           return false;
         }
         if (plane_end.ValueOrDie() > shm_size) {
-          LOG(ERROR)
-              << "Input shmem smaller than device requirements for plane " << i
-              << ": offset=" << plane_offset << ", size=" << plane_size
-              << ", shm_size=" << shm_size;
-          SetErrorState({EncoderStatus::Codes::kInvalidInputFrame,
-                         "Input shmem smaller than device sizeimage"});
-          return false;
+          DVLOGF(2) << "Input memory is smaller than the device requirements "
+                       "for plane "
+                    << i << ": offset=" << plane_offset
+                    << ", size=" << plane_size << ", memory size=" << shm_size
+                    << "; copying into a device-sized buffer";
+          frame_memory_fits = false;
         }
         user_ptrs[i] = const_cast<uint8_t*>(frame->data(i));
       }
+      const size_t num_color_planes = VideoFrame::NumPlanes(frame->format());
+      for (size_t i = 0; i < num_color_planes && frame_memory_fits; ++i) {
+        if (frame->layout().planes()[i].stride !=
+                device_input_layout_->planes()[i].stride ||
+            (num_planes == 1 && frame->layout().planes()[i].offset !=
+                                    device_input_layout_->planes()[i].offset)) {
+          DVLOGF(2) << "Input frame layout differs from the device layout in "
+                       "plane "
+                    << i << ": " << frame->layout() << " vs "
+                    << *device_input_layout_ << "; copying";
+          frame_memory_fits = false;
+        }
+      }
+      if (!frame_memory_fits &&
+          !CopyFrameToDeviceBuffers(*frame, buffer_id, num_planes,
+                                    user_ptrs)) {
+        SetErrorState({EncoderStatus::Codes::kInvalidInputFrame,
+                       "Input frame does not fit the device input layout"});
+        return false;
+      }
       if (!std::move(input_buf).QueueUserPtr(std::move(user_ptrs))) {
         SetErrorState(
             {EncoderStatus::Codes::kEncoderHardwareDriverError,
@@ -1768,6 +1799,86 @@
   return true;
 }
 
+bool V4L2VideoEncodeAccelerator::CopyFrameToDeviceBuffers(
+    const VideoFrame& frame,
+    size_t buffer_id,
+    size_t num_planes,
+    std::vector<void*>& user_ptrs) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(encoder_sequence_checker_);
+  CHECK(device_input_layout_);
+  const VideoFrameLayout& device_layout = *device_input_layout_;
+  const VideoPixelFormat format = frame.format();
+  const size_t num_color_planes = VideoFrame::NumPlanes(format);
+  if (num_planes == 0 || num_planes > num_color_planes ||
+      (num_planes != 1 && num_planes != num_color_planes) ||
+      device_layout.planes().size() < num_color_planes ||
+      frame.layout().planes().size() < num_color_planes ||
+      user_ptrs.size() != num_planes) {
+    LOG(ERROR) << "Cannot copy frame " << frame.AsHumanReadableString()
+               << " to the device layout " << device_layout;
+    return false;
+  }
+
+  const size_t num_copies = base::CheckMul(buffer_id + 1, num_planes)
+                                .ValueOrDie();
+  if (input_device_copies_.size() < num_copies) {
+    // Moving a HeapArray keeps the memory it owns where it is, so the
+    // buffers of frames that the driver still reads do not move.
+    input_device_copies_.resize(num_copies);
+  }
+  for (size_t i = 0; i < num_planes; ++i) {
+    auto& copy = input_device_copies_[buffer_id * num_planes + i];
+    const size_t size = base::bits::AlignUp<size_t>(
+        std::max<size_t>(device_layout.planes()[i].size, 1), 4096);
+    if (copy.size() < size) {
+      // Zeroed, so the padding rows below the picture never hold stale data.
+      copy = base::AlignedZeroed<uint8_t>(size, 4096);
+    }
+    user_ptrs[i] = copy.data();
+  }
+
+  // The part of the picture the driver reads.
+  const int width = std::min(frame.coded_size().width(),
+                             device_layout.coded_size().width());
+  const int height = std::min(frame.coded_size().height(),
+                              device_layout.coded_size().height());
+  for (size_t plane = 0; plane < num_color_planes; ++plane) {
+    // A single-buffer format has all its color planes in V4L2 plane 0.
+    auto& copy = input_device_copies_[buffer_id * num_planes +
+                                      (num_planes == 1 ? 0 : plane)];
+    const ColorPlaneLayout& device_plane = device_layout.planes()[plane];
+    const size_t row_bytes = VideoFrame::RowBytes(plane, format, width);
+    const size_t rows = VideoFrame::Rows(plane, format, height);
+    const int source_stride = frame.stride(plane);
+    if (rows == 0 || row_bytes == 0 || source_stride < 0 ||
+        row_bytes > static_cast<size_t>(source_stride) ||
+        row_bytes > device_plane.stride) {
+      LOG(ERROR) << "Cannot copy plane " << plane << " of "
+                 << frame.AsHumanReadableString() << " to " << device_layout;
+      return false;
+    }
+    const size_t destination_stride = device_plane.stride;
+    base::CheckedNumeric<size_t> end = rows - 1;
+    end *= destination_stride;
+    end += device_plane.offset;
+    end += row_bytes;
+    if (!end.IsValid() || end.ValueOrDie() > copy.size()) {
+      LOG(ERROR) << "Device plane " << plane << " does not fit its buffer: "
+                 << device_layout;
+      return false;
+    }
+    const uint8_t* source = frame.data(plane);
+    base::span<uint8_t> destination = copy.as_span();
+    for (size_t row = 0; row < rows; ++row) {
+      destination.subspan(device_plane.offset + row * destination_stride,
+                          row_bytes)
+          .copy_from(UNSAFE_TODO(base::span<const uint8_t>(
+              source + row * static_cast<size_t>(source_stride), row_bytes)));
+    }
+  }
+  return true;
+}
+
 bool V4L2VideoEncodeAccelerator::EnqueueOutputRecord(
     V4L2WritableBufferRef output_buf) {
   DVLOGF(4);
@@ -2468,6 +2579,7 @@
     VLOGF(1) << "Failed to deallocate V4L2 input buffers";
 
   input_buffer_map_.clear();
+  input_device_copies_.clear();
 }
 
