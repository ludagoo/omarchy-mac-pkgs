diff --git a/media/gpu/v4l2/v4l2_video_encode_accelerator.h b/media/gpu/v4l2/v4l2_video_encode_accelerator.h
--- a/media/gpu/v4l2/v4l2_video_encode_accelerator.h
+++ b/media/gpu/v4l2/v4l2_video_encode_accelerator.h
@@ -16,6 +16,7 @@
 #include "base/containers/circular_deque.h"
 #include "base/containers/queue.h"
 #include "base/files/scoped_file.h"
+#include "base/memory/aligned_memory.h"
 #include "base/memory/scoped_refptr.h"
 #include "base/memory/weak_ptr.h"
 #include "base/sequence_checker.h"
@@ -175,6 +176,17 @@
   void Dequeue();
   // Enqueue a buffer on the corresponding queue.  Returns false on fatal error.
   bool EnqueueInputRecord(V4L2WritableBufferRef input_buf);
+
+  // Copies |frame| into page-aligned buffers laid out the way the driver
+  // reads its input (|device_input_layout_|, every V4L2 plane at the size the
+  // driver asked for), and returns one pointer per V4L2 plane in |user_ptrs|.
+  // For USERPTR input whose shared memory is smaller than what the driver's
+  // sizeimage asks for, or laid out differently. The buffers belong to input
+  // buffer |buffer_id| and stay valid until the next copy into it.
+  bool CopyFrameToDeviceBuffers(const VideoFrame& frame,
+                                size_t buffer_id,
+                                size_t num_planes,
+                                std::vector<void*>& user_ptrs);
   bool EnqueueOutputRecord(V4L2WritableBufferRef output_buf);
 
   // Attempt to start/stop device_poll_thread_.
@@ -357,6 +369,10 @@
 
   // Mapping of int index to input buffer record.
   std::vector<InputRecord> input_buffer_map_;
+
+  // Device-sized copies of USERPTR input frames, |num_planes| entries per
+  // input buffer, see CopyFrameToDeviceBuffers().
+  std::vector<base::AlignedHeapArray<uint8_t>> input_device_copies_;
   v4l2_memory input_memory_type_;
 
   scoped_refptr<V4L2Queue> input_queue_;
