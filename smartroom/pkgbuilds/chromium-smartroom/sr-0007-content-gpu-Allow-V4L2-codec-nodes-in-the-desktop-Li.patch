diff --git a/media/gpu/v4l2/v4l2_codec_nodes.cc b/media/gpu/v4l2/v4l2_codec_nodes.cc
new file mode 100644
index 0000000..0a111d7
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_codec_nodes.cc
@@ -0,0 +1,212 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/v4l2_codec_nodes.h"
+
+#include <fcntl.h>
+#include <linux/media.h>
+#include <linux/videodev2.h>
+#include <sys/ioctl.h>
+
+#include <algorithm>
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/scoped_file.h"
+#include "base/logging.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_util.h"
+
+namespace media {
+
+namespace {
+
+bool IsStillImageFormat(uint32_t fourcc) {
+  return fourcc == V4L2_PIX_FMT_JPEG || fourcc == V4L2_PIX_FMT_MJPEG;
+}
+
+bool HasCompressedVideoFormat(base::span<const V4L2FormatDesc> formats) {
+  return std::ranges::any_of(formats, [](const V4L2FormatDesc& f) {
+    return f.compressed && !IsStillImageFormat(f.fourcc);
+  });
+}
+
+bool HasCompressedFormat(base::span<const V4L2FormatDesc> formats) {
+  return std::ranges::any_of(
+      formats, [](const V4L2FormatDesc& f) { return f.compressed; });
+}
+
+// The kernel's fixed-size strings are NUL-terminated unless they fill the
+// array.
+template <typename T, size_t N>
+std::string KernelString(const T (&chars)[N]) {
+  base::span<const T> s(chars);
+  return std::string(s.begin(), std::ranges::find(s, T{0}));
+}
+
+std::vector<V4L2FormatDesc> EnumerateFormats(int fd, v4l2_buf_type type) {
+  std::vector<V4L2FormatDesc> formats;
+  for (uint32_t index = 0; index < 64; ++index) {
+    struct v4l2_fmtdesc desc = {};
+    desc.index = index;
+    desc.type = type;
+    if (HANDLE_EINTR(ioctl(fd, VIDIOC_ENUM_FMT, &desc)) != 0) {
+      break;
+    }
+    formats.push_back(
+        {desc.pixelformat, (desc.flags & V4L2_FMT_FLAG_COMPRESSED) != 0});
+  }
+  return formats;
+}
+
+struct VideoNode {
+  std::string path;
+  V4L2CodecNodeKind kind = V4L2CodecNodeKind::kNone;
+  std::string driver;
+  std::string bus_info;
+};
+
+// Only the kernel's own names. Symlinks such as /dev/video-dec0 are
+// allowed separately by the sandbox hook.
+bool IsNumberedNode(const base::FilePath& path, std::string_view prefix) {
+  const std::string name = path.BaseName().value();
+  if (!name.starts_with(prefix) || name.size() == prefix.size()) {
+    return false;
+  }
+  return std::ranges::all_of(name.substr(prefix.size()),
+                             [](char c) { return base::IsAsciiDigit(c); });
+}
+
+std::vector<VideoNode> FindVideoNodes() {
+  std::vector<VideoNode> nodes;
+  base::FileEnumerator enumerator(base::FilePath("/dev"), /*recursive=*/false,
+                                  base::FileEnumerator::FILES,
+                                  "video*");
+  for (base::FilePath path = enumerator.Next(); !path.empty();
+       path = enumerator.Next()) {
+    if (!IsNumberedNode(path, "video")) {
+      continue;
+    }
+    base::ScopedFD fd(HANDLE_EINTR(
+        open(path.value().c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC)));
+    if (!fd.is_valid()) {
+      continue;
+    }
+    struct v4l2_capability caps = {};
+    if (HANDLE_EINTR(ioctl(fd.get(), VIDIOC_QUERYCAP, &caps)) != 0) {
+      continue;
+    }
+    const uint32_t device_caps = (caps.capabilities & V4L2_CAP_DEVICE_CAPS)
+                                     ? caps.device_caps
+                                     : caps.capabilities;
+    if (!(device_caps & (V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_VIDEO_M2M))) {
+      // Do not enumerate formats on cameras.
+      continue;
+    }
+    const bool mplane = device_caps & V4L2_CAP_VIDEO_M2M_MPLANE;
+    const std::vector<V4L2FormatDesc> output_formats = EnumerateFormats(
+        fd.get(), mplane ? V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE
+                         : V4L2_BUF_TYPE_VIDEO_OUTPUT);
+    const std::vector<V4L2FormatDesc> capture_formats = EnumerateFormats(
+        fd.get(), mplane ? V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE
+                         : V4L2_BUF_TYPE_VIDEO_CAPTURE);
+    VideoNode node;
+    node.kind = ClassifyV4L2Node(device_caps, output_formats, capture_formats);
+    if (node.kind == V4L2CodecNodeKind::kNone) {
+      continue;
+    }
+    node.path = path.value();
+    node.driver = KernelString(caps.driver);
+    node.bus_info = KernelString(caps.bus_info);
+    nodes.push_back(std::move(node));
+  }
+  return nodes;
+}
+
+}  // namespace
+
+V4L2CodecNodeKind ClassifyV4L2Node(
+    uint32_t device_caps,
+    base::span<const V4L2FormatDesc> output_formats,
+    base::span<const V4L2FormatDesc> capture_formats) {
+  if (!(device_caps & (V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_VIDEO_M2M))) {
+    return V4L2CodecNodeKind::kNone;
+  }
+  if (HasCompressedVideoFormat(output_formats) &&
+      !HasCompressedFormat(capture_formats)) {
+    return V4L2CodecNodeKind::kDecoder;
+  }
+  if (HasCompressedVideoFormat(capture_formats) &&
+      !HasCompressedFormat(output_formats)) {
+    return V4L2CodecNodeKind::kEncoder;
+  }
+  return V4L2CodecNodeKind::kNone;
+}
+
+bool V4L2MediaNodeMatches(std::string_view video_driver,
+                          std::string_view video_bus_info,
+                          std::string_view media_driver,
+                          std::string_view media_bus_info) {
+  if (video_driver.empty() || video_driver != media_driver) {
+    return false;
+  }
+  if (!video_bus_info.empty() && !media_bus_info.empty()) {
+    return video_bus_info == media_bus_info;
+  }
+  return true;
+}
+
+std::vector<std::string> FindV4L2CodecDevicePaths(bool decoders,
+                                                  bool encoders) {
+  std::vector<std::string> paths;
+  if (!decoders && !encoders) {
+    return paths;
+  }
+  const std::vector<VideoNode> nodes = FindVideoNodes();
+  bool have_decoder = false;
+  for (const auto& node : nodes) {
+    if ((decoders && node.kind == V4L2CodecNodeKind::kDecoder) ||
+        (encoders && node.kind == V4L2CodecNodeKind::kEncoder)) {
+      VLOG(1) << "V4L2 codec node for the GPU sandbox: " << node.path;
+      paths.push_back(node.path);
+      have_decoder |= node.kind == V4L2CodecNodeKind::kDecoder;
+    }
+  }
+  if (!have_decoder) {
+    return paths;
+  }
+
+  base::FileEnumerator enumerator(base::FilePath("/dev"), /*recursive=*/false,
+                                  base::FileEnumerator::FILES,
+                                  "media*");
+  for (base::FilePath path = enumerator.Next(); !path.empty();
+       path = enumerator.Next()) {
+    if (!IsNumberedNode(path, "media")) {
+      continue;
+    }
+    base::ScopedFD fd(
+        HANDLE_EINTR(open(path.value().c_str(), O_RDWR | O_CLOEXEC)));
+    if (!fd.is_valid()) {
+      continue;
+    }
+    struct media_device_info info = {};
+    if (HANDLE_EINTR(ioctl(fd.get(), MEDIA_IOC_DEVICE_INFO, &info)) != 0) {
+      continue;
+    }
+    const bool matches = std::ranges::any_of(nodes, [&](const VideoNode& n) {
+      return n.kind == V4L2CodecNodeKind::kDecoder &&
+             V4L2MediaNodeMatches(n.driver, n.bus_info,
+                                  KernelString(info.driver),
+                                  KernelString(info.bus_info));
+    });
+    if (matches) {
+      VLOG(1) << "V4L2 media node for the GPU sandbox: " << path.value();
+      paths.push_back(path.value());
+    }
+  }
+  return paths;
+}
+
+}  // namespace media
diff --git a/media/gpu/v4l2/v4l2_codec_nodes.h b/media/gpu/v4l2/v4l2_codec_nodes.h
new file mode 100644
index 0000000..6ad1eac
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_codec_nodes.h
@@ -0,0 +1,70 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_GPU_V4L2_V4L2_CODEC_NODES_H_
+#define MEDIA_GPU_V4L2_V4L2_CODEC_NODES_H_
+
+#include <stdint.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "media/gpu/media_gpu_export.h"
+
+namespace media {
+
+enum class V4L2CodecNodeKind {
+  kNone,
+  kDecoder,
+  kEncoder,
+};
+
+// One entry of VIDIOC_ENUM_FMT.
+struct V4L2FormatDesc {
+  uint32_t fourcc;
+  // V4L2_FMT_FLAG_COMPRESSED.
+  bool compressed;
+};
+
+// Classifies a /dev/videoN node. |device_caps| is VIDIOC_QUERYCAP's
+// device_caps (or capabilities when V4L2_CAP_DEVICE_CAPS is not set).
+// |output_formats| and |capture_formats| are what VIDIOC_ENUM_FMT lists on
+// the OUTPUT and CAPTURE queues.
+//
+// A decoder is a memory-to-memory node that takes a compressed video format
+// on OUTPUT and produces no compressed format on CAPTURE. An encoder is the
+// reverse. Cameras, capture cards and v4l2loopback nodes are not
+// memory-to-memory, and JPEG codecs and image processors are not video
+// codecs, so they are all kNone.
+MEDIA_GPU_EXPORT V4L2CodecNodeKind
+ClassifyV4L2Node(uint32_t device_caps,
+                 base::span<const V4L2FormatDesc> output_formats,
+                 base::span<const V4L2FormatDesc> capture_formats);
+
+// True when the media controller described by MEDIA_IOC_DEVICE_INFO
+// (|media_driver|, |media_bus_info|) belongs to the video node described by
+// VIDIOC_QUERYCAP (|video_driver|, |video_bus_info|). Stateless decoders need
+// that /dev/mediaN for the request API. bus_info is compared only when both
+// are set, because some drivers leave it empty on one of the two.
+MEDIA_GPU_EXPORT bool V4L2MediaNodeMatches(std::string_view video_driver,
+                                           std::string_view video_bus_info,
+                                           std::string_view media_driver,
+                                           std::string_view media_bus_info);
+
+// Lists the /dev/videoN codec nodes (decoders if |decoders|, encoders if
+// |encoders|) and, for decoders, the /dev/mediaN nodes of the same devices.
+// It opens and queries device nodes, so it must run before the GPU process
+// sandbox is engaged. Desktop Linux uses it to allow exactly those paths in
+// the GPU broker: kernels name codec nodes /dev/videoN, next to cameras, and
+// the ChromeOS names (/dev/video-decN, /dev/video-encN) exist only when a
+// udev rule creates them.
+MEDIA_GPU_EXPORT std::vector<std::string> FindV4L2CodecDevicePaths(
+    bool decoders,
+    bool encoders);
+
+}  // namespace media
+
+#endif  // MEDIA_GPU_V4L2_V4L2_CODEC_NODES_H_
diff --git a/media/gpu/v4l2/v4l2_codec_nodes_unittest.cc b/media/gpu/v4l2/v4l2_codec_nodes_unittest.cc
new file mode 100644
index 0000000..57821d0
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_codec_nodes_unittest.cc
@@ -0,0 +1,82 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/v4l2_codec_nodes.h"
+
+#include <linux/videodev2.h>
+
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace media {
+namespace {
+
+constexpr uint32_t kM2MMplane =
+    V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING | V4L2_CAP_DEVICE_CAPS;
+
+const std::vector<V4L2FormatDesc> kRaw = {{V4L2_PIX_FMT_NV12, false},
+                                          {V4L2_PIX_FMT_NV12M, false}};
+
+TEST(V4L2CodecNodesTest, StatelessAndStatefulDecoders) {
+  const std::vector<V4L2FormatDesc> stateless = {
+      {V4L2_PIX_FMT_H264_SLICE, true},
+      {V4L2_PIX_FMT_HEVC_SLICE, true},
+      {V4L2_PIX_FMT_VP9_FRAME, true}};
+  EXPECT_EQ(V4L2CodecNodeKind::kDecoder,
+            ClassifyV4L2Node(kM2MMplane, stateless, kRaw));
+
+  const std::vector<V4L2FormatDesc> stateful = {{V4L2_PIX_FMT_H264, true}};
+  EXPECT_EQ(V4L2CodecNodeKind::kDecoder,
+            ClassifyV4L2Node(V4L2_CAP_VIDEO_M2M, stateful, kRaw));
+}
+
+TEST(V4L2CodecNodesTest, Encoder) {
+  const std::vector<V4L2FormatDesc> coded = {{V4L2_PIX_FMT_H264, true},
+                                             {V4L2_PIX_FMT_HEVC, true}};
+  EXPECT_EQ(V4L2CodecNodeKind::kEncoder,
+            ClassifyV4L2Node(kM2MMplane, kRaw, coded));
+}
+
+TEST(V4L2CodecNodesTest, CamerasAndLoopbackAreNotCodecs) {
+  // A UVC camera that streams H.264 is a capture device, not M2M.
+  const std::vector<V4L2FormatDesc> uvc = {{V4L2_PIX_FMT_H264, true},
+                                           {V4L2_PIX_FMT_YUYV, false}};
+  EXPECT_EQ(V4L2CodecNodeKind::kNone,
+            ClassifyV4L2Node(V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING,
+                             {}, uvc));
+  // v4l2loopback advertises capture and output, but not M2M.
+  EXPECT_EQ(V4L2CodecNodeKind::kNone,
+            ClassifyV4L2Node(V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_VIDEO_OUTPUT,
+                             kRaw, kRaw));
+}
+
+TEST(V4L2CodecNodesTest, JpegCodecsAndImageProcessorsAreNotVideoCodecs) {
+  const std::vector<V4L2FormatDesc> jpeg = {{V4L2_PIX_FMT_JPEG, true}};
+  EXPECT_EQ(V4L2CodecNodeKind::kNone,
+            ClassifyV4L2Node(kM2MMplane, jpeg, kRaw));
+  EXPECT_EQ(V4L2CodecNodeKind::kNone,
+            ClassifyV4L2Node(kM2MMplane, kRaw, jpeg));
+  EXPECT_EQ(V4L2CodecNodeKind::kNone, ClassifyV4L2Node(kM2MMplane, kRaw, kRaw));
+  // A transcoder (coded on both queues) is neither.
+  const std::vector<V4L2FormatDesc> coded = {{V4L2_PIX_FMT_H264, true}};
+  EXPECT_EQ(V4L2CodecNodeKind::kNone,
+            ClassifyV4L2Node(kM2MMplane, coded, coded));
+}
+
+TEST(V4L2CodecNodesTest, MediaNodeMatchesTheDecoder) {
+  // Apple AVD: /dev/video0 and /dev/media0 both say avd, platform:avd.
+  EXPECT_TRUE(
+      V4L2MediaNodeMatches("avd", "platform:avd", "avd", "platform:avd"));
+  // Two instances of one driver are told apart by bus_info.
+  EXPECT_FALSE(V4L2MediaNodeMatches("rkvdec", "platform:fdc38100.video-codec",
+                                    "rkvdec", "platform:fdc40000.video-codec"));
+  // An empty bus_info on either side falls back to the driver name.
+  EXPECT_TRUE(V4L2MediaNodeMatches("cedrus", "", "cedrus", "platform:cedrus"));
+  EXPECT_FALSE(V4L2MediaNodeMatches("hantro-vpu", "", "uvcvideo", ""));
+  EXPECT_FALSE(V4L2MediaNodeMatches("", "", "", ""));
+}
+
+}  // namespace
+}  // namespace media
