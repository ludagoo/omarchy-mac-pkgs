index 2e53794..f336597 100644
--- a/content/common/gpu_pre_sandbox_hook_linux.cc
+++ b/content/common/gpu_pre_sandbox_hook_linux.cc
@@ -38,6 +38,7 @@
 #include "sandbox/policy/linux/sandbox_linux.h"
 
 #if BUILDFLAG(USE_V4L2_CODEC)
+#include "media/gpu/v4l2/v4l2_codec_nodes.h"
 #include "media/gpu/v4l2/v4l2_device.h"
 #endif
 
@@ -191,6 +192,26 @@ void AddV4L2GpuPermissions(
   }
 }
 
+// Desktop Linux. Kernels name V4L2 codecs /dev/videoN and /dev/mediaN, the
+// same prefixes as cameras, so the nodes are found by what they are before
+// the sandbox starts. Only memory-to-memory nodes with a compressed video
+// format are allowed, never a camera. The ChromeOS names are allowed too, for
+// distributions whose udev rules publish /dev/video-decN and /dev/video-encN.
+// Without this, a build with use_v4l2_codec finds no decoder or encoder once
+// the GPU sandbox is on.
+void AddLinuxV4L2GpuPermissions(
+    std::vector<BrokerFilePermission>* permissions,
+    const sandbox::policy::SandboxSeccompBPF::Options& options) {
+#if BUILDFLAG(USE_V4L2_CODEC)
+  AddV4L2GpuPermissions(permissions, options);
+  for (const std::string& path : media::FindV4L2CodecDevicePaths(
+           options.accelerated_video_decode_enabled,
+           options.accelerated_video_encode_enabled)) {
+    permissions->push_back(BrokerFilePermission::ReadWrite(path));
+  }
+#endif
+}
+
 void AddArmMaliGpuPermissions(std::vector<BrokerFilePermission>* permissions) {
   // Device file needed by the ARM GPU userspace.
   static const char kMali0Path[] = "/dev/mali0";
@@ -666,6 +687,8 @@ std::vector<BrokerFilePermission> FilePermissionsForGpu(
       AddChromecastArmGpuPermissions(&permissions);
       return permissions;
     }
+  } else if (UseV4L2Codec(options)) {
+    AddLinuxV4L2GpuPermissions(&permissions, options);
   }
 
   AddStandardGpuPermissions(&permissions);
