diff --git a/media/gpu/v4l2/v4l2_video_decoder_delegate_h264.cc b/media/gpu/v4l2/v4l2_video_decoder_delegate_h264.cc
index 6e67074..03581c8 100644
--- a/media/gpu/v4l2/v4l2_video_decoder_delegate_h264.cc
+++ b/media/gpu/v4l2/v4l2_video_decoder_delegate_h264.cc
@@ -51,6 +51,16 @@ struct DecRefPicMarking {
   uint32_t long_term_frame_idx;
   uint32_t max_long_term_frame_idx_plus1;
 };
+
+// One slice of a picture. Slice-based decoders submit each of these as its
+// own media request when the picture has more than one slice. The bytes are
+// the NAL the driver asked for (raw, or with a 3-byte start code).
+struct PendingH264Slice {
+  std::vector<uint8_t> bytes;
+  struct v4l2_ctrl_h264_slice_params params = {};
+  struct v4l2_ctrl_h264_pred_weights weights = {};
+  bool pred_weights_required = false;
+};
 }  // namespace
 
 // This struct contains the kernel-specific parts of the H264 acceleration,
@@ -71,6 +81,16 @@ struct V4L2VideoDecoderDelegateH264Private {
   int32_t decode_mode = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED;
   int32_t start_code = V4L2_STATELESS_H264_START_CODE_ANNEX_B;
   bool controls_queried = false;
+  // OUTPUT queue advertises V4L2_BUF_CAP_SUPPORTS_M2M_HOLD_CAPTURE_BUF.
+  // Some drivers set that only when the coded format is selected, so this is
+  // queried from SubmitDecode, after S_FMT.
+  bool hold_capture = false;
+  bool hold_queried = false;
+  struct v4l2_ctrl_h264_sps v4l2_sps = {};
+  struct v4l2_ctrl_h264_pps v4l2_pps = {};
+  struct v4l2_ctrl_h264_scaling_matrix v4l2_scaling = {};
+  bool have_picture_controls = false;
+  std::vector<PendingH264Slice> slices;
 };
 
 void QueryH264StatelessControls(V4L2Device* device,
@@ -102,6 +122,61 @@ void QueryH264StatelessControls(V4L2Device* device,
            << " start_code=" << priv->start_code;
 }
 
+// The hold-capture flag is a property of the coded format, not of the device.
+// Call this after VIDIOC_S_FMT. A count of 0 only reports capabilities.
+void QueryHoldCapture(V4L2Device* device,
+                      V4L2VideoDecoderDelegateH264Private* priv) {
+  if (priv->hold_queried) {
+    return;
+  }
+  struct v4l2_create_buffers create = {};
+  create.count = 0;
+  create.memory = V4L2_MEMORY_MMAP;
+  create.format.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+  if (device->Ioctl(VIDIOC_CREATE_BUFS, &create) != 0) {
+    VLOGF(1) << "VIDIOC_CREATE_BUFS hold-capture query failed";
+    return;
+  }
+  priv->hold_queried = true;
+  priv->hold_capture =
+      (create.capabilities & V4L2_BUF_CAP_SUPPORTS_M2M_HOLD_CAPTURE_BUF) != 0;
+  VLOGF(1) << "H.264 hold_capture=" << priv->hold_capture
+           << " capabilities=" << create.capabilities;
+}
+
+void AppendExtCtrl(std::vector<struct v4l2_ext_control>* ctrls,
+                   __u32 id,
+                   void* ptr,
+                   __u32 size) {
+  struct v4l2_ext_control ctrl = {};
+  ctrl.id = id;
+  ctrl.ptr = ptr;
+  ctrl.size = size;
+  ctrls->push_back(ctrl);
+}
+
+// Picture-level controls plus this slice. Same set on every slice request:
+// SPS, PPS, scaling matrix, decode params, slice params, and prediction
+// weights when the slice uses them.
+void AppendHeldSliceControls(V4L2VideoDecoderDelegateH264Private* priv,
