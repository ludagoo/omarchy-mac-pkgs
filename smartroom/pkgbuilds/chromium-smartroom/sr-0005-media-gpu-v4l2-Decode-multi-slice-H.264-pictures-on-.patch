   virtual void DecodeSurface(scoped_refptr<V4L2DecodeSurface> dec_surface) = 0;
 
+  // Queue one slice of a picture on its own media request, with
+  // V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF. |queue_capture| is true only for the
+  // first slice: that is the only time the picture's CAPTURE buffer is queued.
+  // |ctrls| is applied to this slice's request. The bitstream buffer is waited
