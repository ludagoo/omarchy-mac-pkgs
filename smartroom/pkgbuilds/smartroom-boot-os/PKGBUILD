# SmartRoom only: choose the Mac's startup volume (macOS or SmartRoom
# Firmware) from Linux.
# - Apple Silicon: Omarchy's aurora-bless
# - Intel T2 (Macmini8,1): efibootmgr + efivarfs
pkgname=smartroom-boot-os
pkgver=${SMARTROOM_MAC_PKGS_DATE:?set by smartroom/build-packages}
pkgrel=1
pkgdesc='Switch a room Mac between SmartRoom Firmware and macOS (aurora-bless / efibootmgr)'
arch=('any')
url='https://github.com/ludagoo/omarchy-mac-pkgs'
license=('MIT')
makedepends=('git')
depends=('bash' 'systemd')
optdepends=(
  'aurora-bless: Apple Silicon startup target switching'
  'efibootmgr: Intel T2 UEFI NVRAM startup target switching'
)
_commit=${SMARTROOM_MAC_PKGS_COMMIT:?set by smartroom/build-packages}
source=("omarchy-mac-pkgs::git+https://github.com/ludagoo/omarchy-mac-pkgs.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  [[ $(git -C "$srcdir/omarchy-mac-pkgs" rev-parse HEAD) == "$_commit" ]]
}

check() {
  "$srcdir/omarchy-mac-pkgs/smartroom-boot-os/test/all"
}

package() {
  install -Dm0755 "$srcdir/omarchy-mac-pkgs/smartroom-boot-os/smartroom-boot-os" "$pkgdir/usr/bin/smartroom-boot-os"
  install -Dm0644 "$srcdir/omarchy-mac-pkgs/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
