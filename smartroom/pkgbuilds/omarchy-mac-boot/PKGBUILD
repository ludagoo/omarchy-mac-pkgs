# SmartRoom build of omarchy-mac-boot. Copied from omacom/omarchy-pkgs
# pkgbuilds/omarchy-mac-boot (master f795d0481e24, pkgver 20261104-2) with
# three changes, each marked "SmartRoom:" (see CARRY.md):
#   - the source is ludagoo/omarchy-mac-pkgs smartroom/edge, not omacom main
#   - depends: smartroom-omarchy-helpers (+ sudo) instead of omarchy
#   - pkgver/_commit come from the build (smartroom/build-packages)
# Maintainer (upstream recipe): Marcelo Alcantara <maralc@gmail.com>

pkgname=omarchy-mac-boot
# SmartRoom: the UTC commit date of _commit, passed in by smartroom/build-packages.
pkgver=${SMARTROOM_MAC_PKGS_DATE:?set by smartroom/build-packages}
pkgrel=1
pkgdesc='Apple Silicon boot support for Omarchy: initramfs, in-place encryption, first boot and Limine activation (SmartRoom build)'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/ludagoo/omarchy-mac-pkgs'
license=('MIT')
makedepends=('git')
checkdepends=('dtc')
provides=('omarchy-apple-boot' 'omarchy-first-boot')
conflicts=('omarchy-apple-boot' 'omarchy-first-boot')
replaces=('omarchy-apple-boot' 'omarchy-first-boot')
install=omarchy-mac-boot.install
# SmartRoom: an exact ludagoo/omarchy-mac-pkgs commit (the release's pkgs ref).
_commit=${SMARTROOM_MAC_PKGS_COMMIT:?set by smartroom/build-packages}
# user4k.patch is omacom/omarchy-mac-pkgs#46. The grub-console change is the
# upstream one, on this fork's base; its test cases follow upstream's M4 cases
# at the end of the console test, which leave an M4 device tree behind.
source=("omarchy-mac-pkgs::git+https://github.com/ludagoo/omarchy-mac-pkgs.git#commit=${_commit}"
        user4k.patch)
sha256sums=('SKIP'
            '7b46477969914e5e30a9df2292a622fd0e827253e8c82b9669c1ed2b88887270')

prepare() {
  rm -rf "$srcdir/boot"
  cp -a "$srcdir/omarchy-mac-pkgs/omarchy-mac-boot" "$srcdir/boot"
  patch -d "$srcdir/boot" -Np2 <"$srcdir/user4k.patch"
  [[ $(git -C "$srcdir/omarchy-mac-pkgs" rev-parse HEAD) == "$_commit" ]]
  [[ $(TZ=UTC0 git -C "$srcdir/omarchy-mac-pkgs" show -s --format=%cd --date=format-local:%Y%m%d HEAD) == "$pkgver" ]]
}

check() {
  "$srcdir/boot/test/all"
}

package() {
  # Runtime-only, so the builder stages and tests the payload without the
  # desktop. 1.39.0-2 is the first limine-mkinitcpio-hook that leaves a Mac's
  # /boot to mkinitcpio until Limine is activated. update-m1n1 builds stage 2
  # from m1n1 and U-Boot, so neither can be removed; m1n1 is the virtual name,
  # leaving its provider (m1n1-aurora) to the image, as the kernel is. First
  # boot populates the Asahi repository's keyring.
  # SmartRoom: smartroom-omarchy-helpers (the runtime files this package calls,
  # copied unchanged from omacom/omarchy) replaces 'omarchy'; sudo came with
  # omarchy-settings and limine-boot.sh runs it. asahi-scripts, not
  # aurora-scripts: the stable channel's 20261104-1 depends on it, and stable
  # carries no aurora-scripts.
  depends=('smartroom-omarchy-helpers' 'sudo' 'limine' 'limine-mkinitcpio-hook>=1.39.0-2' 'limine-snapper-sync' 'asahi-scripts'
           'm1n1' 'uboot-asahi' 'asahi-alarm-keyring'
           'bash' 'binutils' 'btrfs-progs' 'coreutils' 'cpio' 'cryptsetup' 'diffutils' 'gawk' 'gnupg' 'grep'
           'gum' 'gzip' 'kbd' 'mkinitcpio' 'sed' 'systemd' 'util-linux')

  "$srcdir/boot/install" "$pkgdir"
  # Once the source drops its own Plymouth fragment (omacom/omarchy-mac#544),
  # the Apple drop-ins build on omarchy-settings' HOOKS baseline
  # (/etc/mkinitcpio.conf.d/00-omarchy-hooks.conf, omacom/omarchy-mac#536), and
  # an older settings package leaves Plymouth out of the Mac initramfs. A
  # settings version cannot say so (quattro candidates sort below stock
  # releases, and omarchy pins its settings exactly), so the settings packages
  # that ship the baseline provide it by name.
  [[ -e $pkgdir/etc/mkinitcpio.conf.d/93-omarchy-mac-plymouth.conf ]] ||
    depends+=('omarchy-mkinitcpio-hooks-baseline')
  printf '%s\n' "$_commit" | install -Dm644 /dev/stdin "$pkgdir/usr/share/omarchy-mac/boot-source-revision"

  # Administrator-editable: every /etc file and the initramfs helpers an image
  # may rewrite.
  mapfile -t backup < <(cd "$pkgdir" && find etc usr/lib/omarchy/initcpio -type f | sort)
}
