# What makes this room this room. smartroom-release copies each of these from
# the running root into the new release's root before its first boot, so an
# update never changes the room's identity, network or Room Controller state.
# One absolute path per line; * and ? match inside the last name only.
# Keep this list short and about the room, not about the release.
/etc/machine-id
/etc/hostname
/etc/hosts
/etc/localtime
/etc/ssh/ssh_host_*
/etc/smartroomos/unique-id
# The Room Controller (/opt/smartroom/agent + venv + systemd unit) is installed
# by firstboot and self-updates independently of OS images; carry the program
# and its install-unit drop-ins while letting the new OS release supply its own
# snapshot-helper.conf, no-wayland-wait.conf, and serial-uucp.conf.
/etc/systemd/system/smartroom-agent.service
/etc/systemd/system/multi-user.target.wants/smartroom-agent.service
/etc/systemd/system/smartroom-agent.service.d/clear-wayland-wait.conf
/etc/systemd/system/smartroom-agent.service.d/kiosk-user.conf
/etc/systemd/system/smartroom-agent.service.d/serial-groups.conf
/etc/systemd/system/smartroom-agent.service.d/server-url.conf
/etc/NetworkManager/system-connections
/var/lib/NetworkManager
/var/lib/iwd
/var/lib/bluetooth
# The Studio first boot's latch: without it a new root would register again.
/var/lib/smartroomos
# First-boot state the room already completed: keeping its package keyring
# and vendor firmware stamp stops an image-built release from reinitializing them.
/etc/pacman.d/gnupg
/var/lib/omarchy/mac-first-boot/install.conf
/var/lib/omarchy/mac-first-boot/keyring
/var/lib/omarchy/vendor-firmware.stamp
/opt/smartroom/agent
/opt/smartroom/agent-prev
/opt/smartroom/bin
/opt/smartroom/install
/opt/smartroom/venv
/opt/smartroom/config
/opt/smartroom/state
/opt/smartroom/chrome-profiles
# Room-specific health settings, if the room has any.
/etc/smartroomos/release.conf
