class Fail(Exception):
    def __init__(self, message: str, code: str = "tool-failed"):
        super().__init__(message)
        self.message = message
        self.code = code


# --------------------------------------------------------------------------
# files


def fsync_dir(path: Path) -> None:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def write_atomic(path: Path, data: bytes, mode: int = 0o600) -> None:
    """Write beside, flush, rename. A power cut leaves the old file or the new."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".new")
    try:
        with open(tmp, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        with contextlib.suppress(OSError):
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except OSError as exc:
        with contextlib.suppress(OSError):
            tmp.unlink()
        code = "esp-full" if getattr(exc, "errno", None) == errno.ENOSPC else "io-error"
        raise Fail(f"cannot write {path.name}: {exc}", code) from exc
    fsync_dir(path.parent)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        while chunk := stream.read(1 << 20):
            digest.update(chunk)
    return digest.hexdigest()


def copy_atomic(src: Path, dst: Path, expect: Optional[str] = None) -> str:
    """Copy src beside dst, check it reads back with the same sha256, rename."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_name(dst.name + ".new")
    digest = hashlib.sha256()
    try:
        try:
            with open(src, "rb") as source, open(tmp, "wb") as target:
                while chunk := source.read(1 << 20):
                    digest.update(chunk)
                    target.write(chunk)
                target.flush()
                os.fsync(target.fileno())
            got = digest.hexdigest()
            if expect is not None and got != expect:
                raise Fail(f"{src.name}: sha256 {got} is not the expected {expect}")
            if sha256_file(tmp) != got:
                raise Fail(f"{dst.name}: the copy does not read back the same")
            os.replace(tmp, dst)
        except OSError as exc:
            code = "esp-full" if getattr(exc, "errno", None) == errno.ENOSPC else "io-error"
            raise Fail(f"cannot write {dst.name}: {exc}", code) from exc
    finally:
        with contextlib.suppress(OSError):
            tmp.unlink()
    fsync_dir(dst.parent)
    return got


def remove(path: Path) -> None:
    with contextlib.suppress(FileNotFoundError):
        path.unlink()


def file_size(path: Path) -> int:
    try:
        return path.stat().st_size
    except OSError:
        return 0


# --------------------------------------------------------------------------
# boot-store (btrfs): kept-release UKI/boot files; ESP holds current + one fallback


def boot_store_root(host: Host) -> Path:
    return host.p(BOOT_STORE)


def boot_store_dir(host: Host, release: str) -> Path:
    return boot_store_root(host) / safe_id(release)


def boot_store_meta(host: Host, release: str) -> Optional[dict]:
    meta = boot_store_dir(host, release) / "meta.json"
    if not meta.is_file():
        return None
    try:
        return json.loads(meta.read_text())
    except ValueError:
        return None


def boot_store_paths(host: Host, release: str) -> tuple[Optional[Path], Optional[Path]]:
    """(uki, boot) paths in the store when present and sha256 matches meta."""
    d = boot_store_dir(host, release)
    meta = boot_store_meta(host, release)
    if not meta:
        return None, None
    uki = d / "uki.efi"
    boot = d / "boot.bin"
    uki_ok = uki.is_file() and meta.get("uki_sha256") == sha256_file(uki)
    boot_ok = True
    boot_path: Optional[Path] = None
    if meta.get("boot_sha256"):
        boot_ok = boot.is_file() and meta.get("boot_sha256") == sha256_file(boot)
        boot_path = boot if boot_ok else None
    elif boot.is_file():
        boot_path = boot
    return (uki if uki_ok else None), (boot_path if boot_ok else None)


def boot_store_put(host: Host, release: str, uki: Path, boot: Optional[Path] = None,
                   uki_sha: Optional[str] = None, boot_sha: Optional[str] = None) -> dict:
    """Copy boot files into the btrfs store; verify sha256; write meta.json."""
    if not release:
        raise Fail("boot-store put needs a release id")
    if not uki.is_file():
        raise Fail(f"boot-store: UKI missing at {uki}")
    d = boot_store_dir(host, release)
    d.mkdir(parents=True, exist_ok=True)
    got_uki = copy_atomic(uki, d / "uki.efi", uki_sha)
    got_boot = None
    if boot is not None and boot.is_file():
        got_boot = copy_atomic(boot, d / "boot.bin", boot_sha)
    meta = {
        "release": release,
        "uki_sha256": got_uki,
        "uki_size": file_size(d / "uki.efi"),
        "boot_sha256": got_boot,
        "boot_size": file_size(d / "boot.bin") if got_boot else 0,
        "stored_at": host.stamp(),
    }
    write_atomic(d / "meta.json", (json.dumps(meta, indent=2, sort_keys=True) + "\n").encode())
    return meta


def boot_store_has(host: Host, release: str) -> bool:
    uki, _ = boot_store_paths(host, release)
    return uki is not None


def _shared_esp_slots(layout: BootLayout) -> set[str]:
    """ESP paths that rotate between releases; never treat as one release's archive."""
    return {p for p in (
        layout.configured_uki, layout.previous_uki, layout.trial_uki,
        layout.configured_boot, layout.previous_boot, layout.trial_boot,
        CONFIGURED_UKI, PREVIOUS_UKI, TRIAL_UKI,
        CONFIGURED_BOOT, PREVIOUS_BOOT, TRIAL_BOOT,
    ) if p}


def resolve_boot_files(host: Host, entry: dict,
                       state: Optional[dict] = None) -> tuple[Path, Optional[Path]]:
    """Locate UKI (+ stage2) for a kept release.

    Prefer btrfs boot-store and the legacy named ESP store. Shared ESP slots
    (configured/previous/trial) are only used when this entry currently owns
    that slot — otherwise history would pick up another release's bytes.
    """
    layout = host.layout()
    esp = host.esp()
    release = entry.get("release") or ""
    shared = _shared_esp_slots(layout)
    uki_src: Optional[Path] = None
    boot_src: Optional[Path] = None
    conf = ((state or {}).get("configured") or {}).get("release")
    prev = ((state or {}).get("previous") or {}).get("release")

    stored_u, stored_b = boot_store_paths(host, release)
    if stored_u is not None:
        uki_src, boot_src = stored_u, stored_b

    if uki_src is None:
        legacy = esp / STATE_DIR / "uki" / f"{release}.efi"
        if legacy.is_file():
            uki_src = legacy

    if uki_src is None and entry.get("uki"):
        rel = entry["uki"]
        path = esp / rel
        if path.is_file():
            if rel not in shared:
                uki_src = path
            elif rel in (layout.configured_uki, CONFIGURED_UKI) and conf == release:
                uki_src = path
            elif rel in (layout.previous_uki, PREVIOUS_UKI) and prev == release:
                uki_src = path

    if uki_src is None:
        raise Fail(f"the release {release}'s UKI is gone", "not-found")

    if layout.uses_aura:
        if boot_src is None:
            legacy_b = esp / STATE_DIR / "boot" / f"{release}.bin"
            if legacy_b.is_file():
                boot_src = legacy_b
        if boot_src is None and entry.get("boot"):
            rel = entry["boot"]
            path = esp / rel
            if path.is_file():
                if rel not in shared:
                    boot_src = path
                elif rel in (layout.configured_boot, CONFIGURED_BOOT) and conf == release:
                    boot_src = path
                elif rel in (layout.previous_boot, PREVIOUS_BOOT) and prev == release:
                    boot_src = path
        if boot_src is None:
            raise Fail(f"the release {release}'s boot files are gone", "not-found")
    return uki_src, boot_src


def keep_release_ids(state: dict) -> set[str]:
    ids = {(state.get("configured") or {}).get("release")}
    for entry in [state.get("previous")] + list(state.get("history") or []):
        if entry and entry.get("release"):
            ids.add(entry["release"])
    if state.get("trial") and state["trial"].get("release"):
        ids.add(state["trial"]["release"])
    mig = state.get("migration") or {}
    if mig.get("kept_until_confirmed") and mig.get("old_release"):
        ids.add(mig["old_release"])
    ids.discard(None)
    ids.discard("")
    return ids


def migrate_esp_uki_store(host: Host, state: dict) -> list[str]:
    """Move legacy ESP smartroom-release/uki|boot copies into the btrfs boot-store."""
    esp = host.esp()
    moved: list[str] = []
    layout = host.layout()
    for uki in sorted((esp / STATE_DIR / "uki").glob("*.efi")) if (esp / STATE_DIR / "uki").is_dir() else []:
        rid = uki.stem
        boot = esp / STATE_DIR / "boot" / f"{rid}.bin"
        boot_path = boot if layout.uses_aura and boot.is_file() else None
        existing_u, _ = boot_store_paths(host, rid)
        if existing_u is not None and sha256_file(existing_u) == sha256_file(uki):
            remove(uki)
            if boot_path:
                remove(boot_path)
            moved.append(f"{rid}:duplicate")
            continue
        boot_store_put(host, rid, uki, boot_path)
        remove(uki)
        if boot_path:
            remove(boot_path)
        moved.append(rid)
    # Drop empty legacy dirs when drained.
    for sub in ("uki", "boot"):
        d = esp / STATE_DIR / sub
        if d.is_dir() and not any(d.iterdir()):
            with contextlib.suppress(OSError):
                d.rmdir()
    return moved


def ingest_esp_hold(host: Host, state: dict, hold: Optional[Path] = None) -> list[str]:
    """Place WS13d-parked ESP files into the boot-store or delete sha256 duplicates.

    Leaves *-pre / *-orig safety folders alone. Only touches ws13d-* names.
    """
    hold = hold or host.p(ESP_HOLD_DEFAULT)
    if not hold.is_dir():
        return []
    actions: list[str] = []
    # Index known store sha256 -> release
    known: dict[str, str] = {}
    root = boot_store_root(host)
    if root.is_dir():
        for meta_path in root.glob("*/meta.json"):
            try:
                meta = json.loads(meta_path.read_text())
            except ValueError:
                continue
            if meta.get("uki_sha256"):
                known[meta["uki_sha256"]] = meta.get("release") or meta_path.parent.name
            if meta.get("boot_sha256"):
                known[meta["boot_sha256"]] = meta.get("release") or meta_path.parent.name
    # Also index live ESP configured/previous
    esp = host.esp()
    layout = host.layout()
    for rel, role in ((layout.configured_uki, "configured"), (layout.previous_uki, "previous"),
                      (layout.configured_boot, "configured-boot"), (layout.previous_boot, "previous-boot")):
        if not rel:
            continue
        p = esp / rel
        if p.is_file():
            known[sha256_file(p)] = role

    def handle_file(path: Path, hint: str) -> None:
        if not path.is_file():
            return
        digest = sha256_file(path)
        if digest in known:
            remove(path)
            actions.append(f"delete-duplicate:{path.name}:{known[digest]}")
            return
        # Prefer a kept history id when the filename names one.
        rid = None
        for kid in keep_release_ids(state):
            if kid and kid in path.name:
                rid = kid
                break
        if rid is None:
            rid = f"esp-hold-{hint}-{digest[:12]}"
        if path.name.endswith(".efi") or "uki" in path.name or "aurora" in path.name:
            boot_store_put(host, rid, path, None)
            known[digest] = rid
            remove(path)
            actions.append(f"store-uki:{path.name}->{rid}")
        elif path.name.endswith(".bin") or "boot" in path.name:
            # Need a UKI already in store for this id, or store boot beside a new stub id.
            d = boot_store_dir(host, rid)
            if (d / "uki.efi").is_file():
                copy_atomic(path, d / "boot.bin")
                meta = boot_store_meta(host, rid) or {"release": rid}
                meta["boot_sha256"] = sha256_file(d / "boot.bin")
                meta["boot_size"] = file_size(d / "boot.bin")
                write_atomic(d / "meta.json", (json.dumps(meta, indent=2, sort_keys=True) + "\n").encode())
            else:
                d.mkdir(parents=True, exist_ok=True)
                copy_atomic(path, d / "boot.bin")
                write_atomic(d / "meta.json", (json.dumps({
                    "release": rid, "uki_sha256": None, "boot_sha256": sha256_file(d / "boot.bin"),
                    "uki_size": 0, "boot_size": file_size(d / "boot.bin"), "stored_at": host.stamp(),
                }, indent=2, sort_keys=True) + "\n").encode())
            known[digest] = rid
            remove(path)
            actions.append(f"store-boot:{path.name}->{rid}")

    for child in sorted(hold.iterdir()):
        name = child.name
        # Leave older *-pre / *-orig safety copies alone (brief).
        if name.endswith("-pre") or name.endswith("-orig"):
            continue
        if not name.startswith("ws13d"):
            continue
        if child.is_dir():
            for f in sorted(child.iterdir()):
                handle_file(f, child.name)
            with contextlib.suppress(OSError):
                if child.is_dir() and not any(child.iterdir()):
                    child.rmdir()
        elif child.is_file():
            handle_file(child, name)
    return actions


def ensure_entry_in_boot_store(host: Host, entry: Optional[dict],
                               state: Optional[dict] = None) -> None:
    if not entry or not entry.get("release"):
        return
    release = entry["release"]
    if boot_store_has(host, release):
        return
    try:
        uki, boot = resolve_boot_files(host, entry, state=state)
    except Fail:
        return
    boot_store_put(host, release, uki, boot)


def esp_offload_non_essential(host: Host, state: dict, for_trial: bool = False) -> list[str]:
    """ESP keeps configured (+ trial while staged) and at most one previous fallback.

    Everything else (legacy ESP UKI store, extra previous while staging a trial) moves
    to the btrfs boot-store or is deleted when already stored with matching sha256.
    """
    actions = migrate_esp_uki_store(host, state)
    layout = host.layout()
    esp = host.esp()
    # Ensure configured + previous + history are durable on btrfs.
    ensure_entry_in_boot_store(host, state.get("configured"), state=state)
    ensure_entry_in_boot_store(host, state.get("previous"), state=state)
    for entry in state.get("history") or []:
        ensure_entry_in_boot_store(host, entry, state=state)
    # While staging/arming a trial, previous ESP slots are not needed for fallback
    # (aura/Limine fall back to configured). Free them for the trial + promote reserve.
    trial = state.get("trial")
    trial_busy = bool(trial and trial.get("phase") in ("staged", "armed", "booting", "promoting"))
    if for_trial or trial_busy:
        for rel in (layout.previous_uki, layout.previous_boot):
            if rel and (esp / rel).is_file():
                # Already in boot-store via ensure_entry above.
                remove(esp / rel)
                actions.append(f"offload-previous:{rel}")
    return actions


def esp_budget_bytes(host: Host, uki_size: int, boot_size: int) -> dict:
    """Worst-case ESP bytes a stage+promote cycle needs free (beyond configured files).

    Sequential peak (after previous has been offloaded): write trial, then at promote
    write previous, then one .new temp while configured+previous+trial coexist.
    Spare is max(temp, ESP_MARGIN) so a 59 MiB UKI .new is covered even when
    ESP_MARGIN is 32 MiB.
    """
    layout = host.layout()
    trial = uki_size + (boot_size if layout.uses_aura else 0)
    previous = uki_size + (boot_size if layout.uses_aura else 0)
    temp = max(uki_size, boot_size if layout.uses_aura else uki_size, 1)
    spare = max(temp, ESP_MARGIN)
    need = trial + previous + spare
    return {
        "trial": trial,
        "previous_reserve": previous,
        "temp": temp,
        "margin": ESP_MARGIN,
        "spare": spare,
        "need": need,
        "uki_size": uki_size,
        "boot_size": boot_size if layout.uses_aura else 0,
    }


def esp_free_bytes(esp: Path) -> int:
    return shutil.disk_usage(esp).free


def limine_history_bytes(esp: Path) -> int:
    total = 0
    for path in esp.glob("**/limine_history/**"):
        if path.is_file():
            total += file_size(path)
    return total


def restore_previous_to_esp(host: Host, state: dict) -> None:
    """Copy the previous release's boot files back onto the ESP fallback slots."""
    prev = state.get("previous")
    if not prev or not prev.get("release"):
        return
    layout = host.layout()
    esp = host.esp()
    if layout.previous_uki and (esp / layout.previous_uki).is_file():
        return
    uki, boot = resolve_boot_files(host, prev, state=state)
    copy_atomic(uki, esp / layout.previous_uki)
    if layout.uses_aura and boot is not None and layout.previous_boot:
        copy_atomic(boot, esp / layout.previous_boot)
    prev["uki"] = layout.previous_uki
    if layout.uses_aura:
        prev["boot"] = layout.previous_boot
    state["previous"] = prev


# --------------------------------------------------------------------------
# the host: every path and command goes through here, so tests can move it


class Host:
    def __init__(self, prefix: str = ""):
        self.prefix = prefix.rstrip("/")
        self._conf: Optional[dict] = None
        self._top_mounted = False

    def p(self, absolute: str) -> Path:
        return Path(self.prefix + absolute)

    # configuration ------------------------------------------------------
    @property
    def conf(self) -> dict:
        if self._conf is None:
            values = dict(DEFAULTS)
            path = self.p("/etc/smartroomos/release.conf")
            if path.is_file():
                for line in path.read_text().splitlines():
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    key, _, value = line.partition("=")
                    key = key.strip()
                    if key in DEFAULTS:
                        values[key] = value.strip().strip('"')
            for key in ("quiet_seconds", "limit_seconds", "sample_seconds"):
                values[key] = int(values[key])
            self._conf = values
        return self._conf

    # time ----------------------------------------------------------------
    def now(self) -> float:
        return time.time()

    def monotonic(self) -> float:
        return time.monotonic()

    def sleep(self, seconds: float) -> None:
        time.sleep(seconds)

    def stamp(self) -> str:
        return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(self.now()))

    # commands --------------------------------------------------------------
    def run(self, argv: list[str], check: bool = True, input: Optional[bytes] = None,
            env: Optional[dict] = None) -> subprocess.CompletedProcess:
        run_env = None
        if env:
            run_env = os.environ.copy()
            run_env.update(env)
        try:
            done = subprocess.run(argv, input=input, capture_output=True, check=False, env=run_env)
        except FileNotFoundError:
            raise Fail(f"{argv[0]} is not installed")
        if check and done.returncode != 0:
            tail = (done.stderr or done.stdout).decode(errors="replace").strip().splitlines()[-3:]
            raise Fail(f"{' '.join(argv[:3])} failed ({done.returncode}): {' | '.join(tail)}")
        return done

    # boot facts --------------------------------------------------------------
    def esp(self) -> Path:
        if not self.prefix:
            done = subprocess.run(["omarchy-mac-esp"], capture_output=True, text=True, check=False) \
                if shutil.which("omarchy-mac-esp") else None
            if done is not None and done.returncode == 0 and done.stdout.strip():
                return Path(done.stdout.strip())
        # Studio: /boot/efi. Mini: Limine UKI lives under /boot (no separate efi mount).
        efi = self.p("/boot/efi")
        if (efi / "limine.conf").is_file() or (efi / "EFI").is_dir():
            return efi
        boot = self.p("/boot")
        if (boot / "limine.conf").is_file() or (boot / "EFI").is_dir():
            return boot
        return efi

    def line(self) -> str:
        """studio (Apple Silicon / aura) or mini (Intel T2 / Limine-only)."""
        if self.p("/etc/smartroomos/omarchy-base").is_file():
            return "studio"
        esp = self.esp()
        if (esp / CONFIGURED_BOOT).is_file() or (esp / CONFIGURED_UKI).is_file():
            return "studio"
        if (esp / LAYOUT_MINI.configured_uki).is_file():
            return "mini"
        # Prefer Mini when there is no aura stage2 and the machine looks Intel.
        if not (esp / "m1n1").is_dir():
            return "mini"
        return "studio"

    def layout(self) -> BootLayout:
        return LAYOUT_STUDIO if self.line() == "studio" else LAYOUT_MINI

    def cmdline(self) -> str:
        return self.p("/proc/cmdline").read_text().strip()

    def dt_trial(self) -> Optional[str]:
        path = self.p("/proc/device-tree/chosen/aurora,trial")
        try:
            return path.read_bytes().rstrip(b"\0").decode() or None
        except OSError:
            return None

    def boot_id(self) -> str:
        try:
            return self.p("/proc/sys/kernel/random/boot_id").read_text().strip()
        except OSError:
            return ""

    def uptime(self) -> float:
        try:
            return float(self.p("/proc/uptime").read_text().split()[0])
        except (OSError, ValueError, IndexError):
            return 0.0

    # btrfs -----------------------------------------------------------------
    def btrfs_device(self) -> str:
        """Block device that holds the room's btrfs.

        A normal @ boot has FSTYPE=btrfs. A snapshot boot runs under
        sd-btrfs-overlayfs, so findmnt SOURCE / is "overlay"; the real
        device is still mounted underneath (and is named on the cmdline).
        Old Minis hit this whenever LoaderEntryDefault still names a
        Snapshots.* entry — migrate/build-release must still find the disk.
        """
        if self.prefix:
            return "prefix"
        fstype = self.run(["findmnt", "-no", "FSTYPE", "/"], check=False).stdout.decode().strip()
        source = self.run(["findmnt", "-no", "SOURCE", "/"], check=False).stdout.decode().strip()
        device = re.sub(r"\[.*\]$", "", source)
        if fstype == "btrfs" and device and Path(device).exists():
            return device
        # Prefer a btrfs SOURCE that still names a snapshot / @ subvol.
        listed = self.run(["findmnt", "-nro", "SOURCE", "-t", "btrfs"], check=False).stdout.decode()
        preferred = []
        fallback = []
        for line in listed.splitlines():
            line = line.strip()
            if not line:
                continue
            dev = re.sub(r"\[.*\]$", "", line)
            if not (dev and Path(dev).exists()):
                continue
            if ".snapshots/" in line or "[/@" in line or line.endswith("[@]"):
                preferred.append(dev)
            else:
                fallback.append(dev)
        if preferred:
            return preferred[0]
        if fallback:
            return fallback[0]
        cmd = self.cmdline()
        m = re.search(r"root=UUID=([^\s]+)", cmd)
        if m:
            by_uuid = Path(f"/dev/disk/by-uuid/{m.group(1)}")
            if by_uuid.exists():
                return str(by_uuid)
        m = re.search(r"root=(/dev/\S+)", cmd)
        if m and Path(m.group(1)).exists():
            return m.group(1)
        raise Fail(
            f"cannot find btrfs device for / (fstype={fstype or '?'}, source={source or '?'})",
            "no-btrfs",
        )

    @contextlib.contextmanager
    def top(self):
        """The btrfs top level (subvolid 5), where the root subvolumes live."""
        if self.prefix:
            top = self.p("/top")
            top.mkdir(parents=True, exist_ok=True)
            yield top
            return
        mount = Path("/run/smartroom-release/top")
        device = self.btrfs_device()
        mounted = subprocess.run(["findmnt", "-M", str(mount)], capture_output=True).returncode == 0
        did = False
        if not mounted:
            mount.mkdir(parents=True, exist_ok=True)
            self.run(["mount", "-o", "subvolid=5,noatime", device, str(mount)])
            did = True
        try:
            yield mount
        finally:
            if did:
                subprocess.run(["umount", str(mount)], capture_output=True, check=False)

    # health signals ------------------------------------------------------------
    def agent_connected(self) -> bool:
        """The Room Controller holds a live TCP connection to its server."""
        # Offline Intel VM scenarios cannot open a real Room Controller session.
        # When SMARTROOM_RELEASE_VM=1, a root-owned marker means "pretend connected"
        # so promote/fallback paths can be exercised without a server.
        if os.environ.get("SMARTROOM_RELEASE_VM") == "1":
            for rel in ("/run/smartroomos/release-vm-healthy",
                        "/etc/smartroomos/release-vm-healthy"):
                if self.p(rel).is_file():
                    return True
        conf = self.p("/opt/smartroom/config/agent.json")
        try:
            url = json.loads(conf.read_text()).get("serverUrl", "")
        except (OSError, ValueError):
            return False
        match = re.match(r"^(https?)://[^/:]+(?::(\d+))?", url or "")
        if not match:
            return False
        port = match.group(2) or ("443" if match.group(1) == "https" else "80")
        shown = self.run(["systemctl", "show", "-p", "MainPID", "--value", "smartroom-agent.service"], check=False)
        pid = shown.stdout.decode().strip()
        if not pid or pid == "0":
            return False
        sockets = self.run(["ss", "-Htnp", "state", "established"], check=False).stdout.decode()
        for line in sockets.splitlines():
            fields = line.split()
            if len(fields) < 4 or f"pid={pid}," not in line:
                continue
            peer = fields[3]
            host, _, peer_port = peer.rpartition(":")
            if peer_port == port and not host.startswith(("127.", "[::1]")):
                return True
        return False

    def network_up(self) -> bool:
        try:
            rows = self.p("/proc/net/route").read_text().splitlines()[1:]
        except OSError:
            return False
        for row in rows:
            fields = row.split()
            if len(fields) > 3 and fields[1] == "00000000" and int(fields[3], 16) & 1:
                return True
        return False

    def room_pages_up(self) -> int:
        """Room pages running: kiosk browser main processes (no --type=) of the Room
        Controller user whose URL names a room role. 2026-11-24: on edge-c the kiosk
        Chromium could not start (a missing library) and the trial still passed."""
        uid = _id_by_name(_read_small(str(self.p("/etc/passwd"))), RC_USER)
        if uid is None:
            return 0
        count = 0
        for proc in self.p("/proc").glob("[0-9]*"):
            try:
                if (proc / "comm").read_text().strip() not in ("chromium", "chrome"):
                    continue
                owner = next((line.split()[1] for line in (proc / "status").read_text().splitlines()
                              if line.startswith("Uid:")), None)
                if owner != str(uid):
                    continue
                # Chromium rewrites its process title: one space-joined string, not NUL-separated.
                args = re.split(rb"[\0 ]+", (proc / "cmdline").read_bytes())
            except (OSError, IndexError, StopIteration):
                continue
            if any(a.startswith(b"--type=") for a in args):
                continue
            if any(re.match(rb"(--app=)?https?://\S*[?&]role=\w", a) for a in args):
                count += 1
        return count

    def displays(self) -> int:
        count = 0
        base = self.p("/sys/class/drm")
        if not base.is_dir():
            return 0
        for status in sorted(base.glob("card*-*/status")):
            try:
                if status.read_text().strip() == "connected":
                    count += 1
            except OSError:
                pass
        return count

    # EFI variables ----------------------------------------------------------------
    def efivar(self, name: str) -> Path:
        return self.p("/sys/firmware/efi/efivars") / name

    def set_oneshot(self, entry_id: Optional[str]) -> None:
        var = self.efivar(ONESHOT)
        with contextlib.suppress(Exception):
            subprocess.run(["chattr", "-i", str(var)], capture_output=True, check=False)
        remove(var)
        if entry_id is None:
            return
        payload = (7).to_bytes(4, "little") + entry_id.encode("utf-16-le") + b"\0\0"
        fd = os.open(var, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        try:
            os.write(fd, payload)
        finally:
            os.close(fd)

    def save_efi_vars(self) -> None:
        """Studio: persist U-Boot RAM efivars to ubootefi.var. Mini: no-op (NVRAM)."""
        if self.line() == "mini":
            return
        saver = self.p(EFI_VARS_SAVE)
        alt = self.p("/usr/local/sbin/smartroomos-efi-vars-save")
        if not self.prefix and not saver.exists() and not alt.exists():
            raise Fail("omarchy-mac-boot's efi-vars-save is not installed")
        for candidate in (saver, alt):
            if candidate.exists():
                self.run([str(candidate)])
                return

    def oneshot_saved(self) -> bool:
        """True when the one-shot will survive reboot (ubootefi.var or NVRAM)."""
        if self.line() == "mini":
            var = self.efivar(ONESHOT)
            try:
                data = var.read_bytes()
            except OSError:
                return False
            # efivarfs: 4-byte attributes + UTF-16LE entry id
            return len(data) > 4
        needle = "LoaderEntryOneShot".encode("utf-16-le")
        try:
            return needle in (self.esp() / "ubootefi.var").read_bytes()
        except OSError:
            return False

    def ensure_watchdog_module(self) -> None:
        """Mini: prefer iTCO_wdt, else softdog, so /dev/watchdog exists for trials."""
        if self.line() != "mini" or self.prefix:
            return
        if self.p("/dev/watchdog").exists():
            return
        for mod in ("iTCO_wdt", "softdog"):
            subprocess.run(["modprobe", mod], capture_output=True, check=False)
            if self.p("/dev/watchdog").exists():
                return

    # reboot ---------------------------------------------------------------------------
    def save_journal(self) -> None:
        """Put this boot's journal on disk before a rollback reboot, so the health-run
        log of the boot that failed survives it. Bounded; never stops the reboot."""
        for flag in ("--flush", "--sync"):
            with contextlib.suppress(OSError, subprocess.SubprocessError):
                subprocess.run(["journalctl", flag], capture_output=True, check=False, timeout=15)

    def reboot(self) -> None:
        self.save_journal()
        hook = self.conf["reboot_hook"]
        if hook:
            subprocess.run(hook, shell=True, check=False)
        subprocess.run(["systemctl", "reboot", "--no-block"], check=False)

    def hard_reboot(self) -> None:
        with contextlib.suppress(OSError):
            Path("/proc/sys/kernel/sysrq").write_text("1")
            Path("/proc/sysrq-trigger").write_text("b")

    # the root invariant ---------------------------------------------------------
    def root_ids(self, rel: str, uid: int, gid: int) -> tuple[int, int]:
        """Owners as the invariant sees them: the real ones (tests map theirs)."""
        return uid, gid

    def check_root(self, path: Path) -> "RootReport":
        return check_root(path, self.root_ids)

    def record_integrity(self) -> None:
        tool = self.p("/usr/local/sbin/smartroomos-integrity")
        if not os.access(tool, os.X_OK):
            return
        env = dict(os.environ, SMARTROOMOS_ROOT=str(self.p("/"))) if self.prefix else None
        subprocess.run([str(tool), "record", "--by", "smartroom-release"], check=False, env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([str(tool), "check", "--manual"], check=False, env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# --------------------------------------------------------------------------
# the watchdog the health service holds during a trial


class Watchdog:
    def __init__(self, device: str):
        self.device = device
        self.fd: Optional[int] = None

    def open(self) -> bool:
        try:
            self.fd = os.open(self.device, os.O_WRONLY)
            return True
        except OSError:
            self.fd = None
            return False

    def feed(self) -> None:
        if self.fd is not None:
            with contextlib.suppress(OSError):
                os.write(self.fd, b"\0")

    def disarm(self) -> None:
        """Magic close: the room is healthy, nothing needs the reset."""
        if self.fd is not None:
            with contextlib.suppress(OSError):
                os.write(self.fd, b"V")
            os.close(self.fd)
            self.fd = None

    def leave_armed(self) -> None:
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None


# --------------------------------------------------------------------------
# state, kept on the ESP: the one place every release shares


def state_path(host: Host) -> Path:
    return host.esp() / STATE_DIR / STATE_FILE


def load_state(host: Host) -> dict:
    path = state_path(host)
    if path.is_file():
        try:
            return json.loads(path.read_text())
        except ValueError:
            raise Fail(f"{path} is not valid JSON; leaving it alone")
    layout = host.layout()
    return {
        "schema": SCHEMA,
        "counter": 0,
        "line": layout.line,
        "configured": {"release": INSTALLED, "number": 0, "root": running_root(host),
                       "uki": layout.configured_uki, "boot": layout.configured_boot},
        "previous": None,
        "history": [],
        "trial": None,
        "promoting": None,
        "last_result": None,
        "events": [],
    }


def save_state(host: Host, state: dict) -> None:
    state["events"] = state.get("events", [])[-EVENTS_KEEP:]
    write_atomic(state_path(host), (json.dumps(state, indent=2, sort_keys=True) + "\n").encode())


def event(host: Host, state: dict, name: str, **fields: Any) -> None:
    record = {"event": name, "at": host.stamp()}
    record.update(fields)
    state.setdefault("events", []).append(record)


def running_root(host: Host) -> str:
    """The subvolume this boot's root was mounted from (rootflags=subvol=)."""
    match = re.search(r"(?:^|[ ,=])subvol=/?([^\s,]+)", host.cmdline())
    return match.group(1) if match else "@"


def running_release(host: Host, state: dict) -> str:
    match = re.search(rf"(?:^|\s){re.escape(RELEASE_PARAM)}=(\S+)", host.cmdline())
    if match:
        return match.group(1)
    root = running_root(host)
    for key in ("configured", "previous"):
        entry = state.get(key) or {}
        if entry.get("root") == root:
            return entry.get("release", INSTALLED)
    return INSTALLED


# --------------------------------------------------------------------------
# limine.conf: only the kernel entry and our one trial entry are touched


def _entry_blocks(lines: list[str]) -> list[tuple[int, int, str]]:
    """(first line, end line, title) of every menu entry (any depth)."""
    marks = []
    for i, line in enumerate(lines):
        match = re.match(r"^\s*(/+)\+?(.*)$", line)
        if match:
            marks.append((i, match.group(2).strip()))
    blocks = []
    for n, (start, title) in enumerate(marks):
        end = marks[n + 1][0] if n + 1 < len(marks) else len(lines)
        blocks.append((start, end, title))
    return blocks


def strip_trial_entry(text: str) -> str:
    lines = text.splitlines()
    for start, end, title in reversed(_entry_blocks(lines)):
        if title == TRIAL_ENTRY_NAME and re.match(r"^/[^/]", lines[start]):
            del lines[start:end]
    while lines and not lines[-1].strip():
        lines.pop()
    return "\n".join(lines) + "\n" if lines else ""


def with_trial_entry(text: str, release: str, uki: str, cmdline: str) -> str:
    base = strip_trial_entry(text)
    block = (
        f"\n/{TRIAL_ENTRY_NAME}\n"
        f"    comment: smartroom-release trial of {release}; Limine takes it once\n"
        "    protocol: efi\n"
        f"    path: boot():/{uki}\n"
        f"    cmdline: {cmdline}\n"
    )
    return base + block


def _is_kernel_uki_path(path_line: str) -> bool:
    return any(n in path_line for n in ("/EFI/Linux/omarchy_", "/EFI/Linux/smartroomos_"))


def kernel_entry(text: str) -> Optional[tuple[str, str]]:
    """(path, cmdline) of the entry that boots the configured UKI."""
    lines = text.splitlines()
    for start, end, title in _entry_blocks(lines):
        if title == TRIAL_ENTRY_NAME:
            continue
        path = cmd = None
        for line in lines[start:end]:
            stripped = line.strip()
            if stripped.startswith("path:") and _is_kernel_uki_path(stripped):
                path = stripped[len("path:"):].strip()
            elif stripped.startswith("cmdline:"):
                cmd = stripped[len("cmdline:"):].strip()
        if path is not None and cmd is not None:
            return path, cmd
    return None


def set_kernel_entry(text: str, uki: str, cmdline: str) -> str:
    """Point the configured kernel entry at UKI (ESP path) with CMDLINE."""
    lines = text.splitlines()
    done = False
    for start, end, title in _entry_blocks(lines):
        if title == TRIAL_ENTRY_NAME or done:
            continue
        has_uki = any(l.strip().startswith("path:") and _is_kernel_uki_path(l) for l in lines[start:end])
        if not has_uki:
            continue
        for i in range(start, end):
            stripped = lines[i].strip()
            indent = lines[i][: len(lines[i]) - len(lines[i].lstrip())]
            if stripped.startswith("path:"):
                lines[i] = f"{indent}path: boot():/{uki}"
            elif stripped.startswith("cmdline:"):
                lines[i] = f"{indent}cmdline: {cmdline}"
        done = True
    if not done:
        raise Fail("limine.conf has no kernel entry for the UKI; not touching it")
    return "\n".join(lines) + "\n"


def ensure_unattended_limine(text: str) -> str:
    """Old Minis ship timeout: 1; a release trial must never park at a menu."""
    lines = text.splitlines()
    out = []
    seen = False
    for line in lines:
        if re.match(r"^timeout:\s*", line):
            out.append("timeout: 0")
            seen = True
        else:
            out.append(line)
    if not seen:
        out.insert(0, "timeout: 0")
    return "\n".join(out) + ("\n" if text.endswith("\n") or not text else "\n")


def with_subvol(cmdline: str, subvol: str, release: Optional[str]) -> str:
    """CMDLINE for the root SUBVOL and RELEASE; trial-only parameters removed."""
    words = [w for w in cmdline.split() if w not in TRIAL_ONLY_PARAMS
             and not w.startswith(RELEASE_PARAM + "=")]
    found = False
    for i, word in enumerate(words):
        if word.startswith("rootflags="):
            parts = [p for p in word[len("rootflags="):].split(",") if not p.startswith("subvol=")]
            parts.insert(0, f"subvol={subvol}")
            words[i] = "rootflags=" + ",".join(parts)
            found = True
    if not found:
        words.append(f"rootflags=subvol={subvol}")
    if release:
        words.append(f"{RELEASE_PARAM}={release}")
    return " ".join(words)


def trial_cmdline(cmdline: str, subvol: str, release: str) -> str:
    return with_subvol(cmdline, subvol, release) + " " + " ".join(TRIAL_ONLY_PARAMS)


def require_zero_touch(cmdline: str) -> None:
    if not re.search(r"(?:^|\s)panic=10(?:\s|$)", cmdline):
        raise Fail("the release's kernel command line has no panic=10; refusing: a panic must reboot the room")


# --------------------------------------------------------------------------
# releases


def safe_id(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", value or ""):
        raise Fail(f"bad release id {value!r}: letters, digits, . _ - only")
    return value


def subvol_name(release: str) -> str:
    return f"@r-{release}"


def verify_signature(host: Host, directory: Path, unsigned: bool) -> bool:
    sig = directory / (MANIFEST + ".sig")
    if unsigned:
        return False
    keyring = host.p(host.conf["keyring"])
    if not keyring.is_file():
        raise Fail(f"no release keyring at {keyring}; a signed release cannot be checked "
                   "(--unsigned is for development only)", "unsigned")
    if not sig.is_file():
        raise Fail("the release has no manifest.json.sig", "unsigned")
    done = host.run(["gpgv", "--keyring", str(keyring), str(sig), str(directory / MANIFEST)], check=False)
    if done.returncode != 0:
        raise Fail("the manifest signature does not verify", "bad-signature")
    return True


def load_manifest(directory: Path) -> dict:
    try:
        manifest = json.loads((directory / MANIFEST).read_text())
    except (OSError, ValueError) as exc:
        raise Fail(f"cannot read {directory / MANIFEST}: {exc}")
    if manifest.get("schema") != SCHEMA:
        raise Fail(f"manifest schema {manifest.get('schema')!r} is not {SCHEMA}")
    safe_id(manifest.get("id", ""))
    for key in ("root", "boot"):
        if key not in manifest:
            raise Fail(f"manifest has no {key}")
    roles = {item.get("role"): item for item in manifest["boot"]}
    if "uki" not in roles:
        raise Fail("manifest boot list has no uki")
    line = manifest.get("line")  # optional: "studio" | "mini"
    if line not in (None, "studio", "mini"):
        raise Fail(f"manifest line {line!r} is not studio or mini")
    if line != "mini" and "stage2" not in roles:
        # Studio releases need aura stage2; Mini releases are UKI-only.
        raise Fail("manifest boot list has no stage2")
    for item in [manifest["root"]] + list(manifest["boot"]):
        name = item.get("file") or item.get("path")
        if not name or name.startswith("/") or ".." in Path(name).parts:
            raise Fail(f"unsafe file name in manifest: {name!r}")
        if not re.fullmatch(r"[0-9a-f]{64}", item.get("sha256", "")):
            raise Fail(f"manifest has no sha256 for {name}")
    return manifest


def fetch(host: Host, location: str) -> Path:
    """A release directory: local, or downloaded from an https base URL."""
    if not re.match(r"^[a-z]+://", location):
        directory = Path(location)
        if not directory.is_dir():
            raise Fail(f"{location} is not a directory")
        return directory
    if not location.startswith("https://"):
        raise Fail("a release URL must be https://", "insecure-url")
    base = location.rstrip("/")
    work = host.p("/var/lib/smartroom-release/incoming") / re.sub(r"[^A-Za-z0-9._-]+", "_", base)
    work.mkdir(parents=True, exist_ok=True)

    def get(name: str, resume: bool = False) -> None:
        host.run(["curl", "--fail", "--silent", "--show-error", "--location", "--proto", "=https",
                  "--retry", "5", *(["-C", "-"] if resume else []), "-o", str(work / name), f"{base}/{name}"])

    get(MANIFEST)
    get(MANIFEST + ".sig")
    manifest = load_manifest(work)
    names = [manifest["root"]["file"]] + [item["path"] for item in manifest["boot"]]
    for name in names:
        (work / name).parent.mkdir(parents=True, exist_ok=True)
        get(name, resume=True)
    return work


def check_files(directory: Path, manifest: dict) -> None:
    items = [(manifest["root"]["file"], manifest["root"]["sha256"])]
    items += [(item["path"], item["sha256"]) for item in manifest["boot"]]
    for name, expect in items:
        path = directory / name
        if not path.is_file():
            raise Fail(f"release file is missing: {name}")
        if sha256_file(path) != expect:
            raise Fail(f"release file does not match its sha256: {name}")


# --------------------------------------------------------------------------
# the carry list: what makes this room this room, copied into each new root


def carry_entries(host: Host) -> list[str]:
    path = host.p(CARRY_LIST)
    if not path.is_file():
        # pkgs tree: bin/smartroom-release → share/release-carry.list
        # bootstrap scp: /usr/bin/smartroom-release + /usr/share/smartroomos/...
        # agent scp of just the binary: look beside the file too
        here = Path(__file__).resolve()
        for candidate in (
            here.parent.parent / "share" / "release-carry.list",
            here.parent / "release-carry.list",
            Path("/usr/share/smartroomos/release-carry.list"),
        ):
            if candidate.is_file():
                path = candidate
                break
    if not path.is_file():
        raise Fail(f"carry list {CARRY_LIST} is missing")
    entries = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            if not line.startswith("/") or ".." in Path(line).parts:
                raise Fail(f"bad carry list entry {line!r}")
            entries.append(line)
    return entries


def _dir_nbytes(path: Path) -> int:
    total = 0
    if not path.exists():
        return 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            try:
                total += (Path(root) / name).stat().st_size
            except OSError:
                pass
    return total


def _clear_archive_content_keep_manifest(archive: Path) -> None:
    """Remove archive payload files but keep manifest.json at the archive root."""
    manifest = archive / "manifest.json"
    saved = None
    if manifest.is_file():
        with contextlib.suppress(OSError):
            saved = manifest.read_bytes()
    for root, dirs, files in os.walk(archive, topdown=False):
        for name in files:
            p = Path(root) / name
            if p == manifest:
                continue
            with contextlib.suppress(OSError):
                p.unlink()
        for name in dirs:
            with contextlib.suppress(OSError):
                (Path(root) / name).rmdir()
    if saved is not None:
        write_atomic(manifest, saved, mode=0o644)


def prune_carried_drift_archive(
    target_smartroomos: Path,
    max_bytes: int = DRIFT_ARCHIVE_CARRY_MAX,
) -> list[dict]:
    """Enforce a total size budget on a carried drift-archive.

    Newest archives that fit are kept intact. For each archive whose content
    is dropped: keep manifest.json and return a content_pruned record. Callers
    mark hand-changes-pending.json / status.json so nothing is silent.
    """
    arch = target_smartroomos / "drift-archive"
    if not arch.is_dir():
        return []
    entries: list[tuple[float, Path, int]] = []
    for child in arch.iterdir():
        if not child.is_dir():
            continue
        try:
            mtime = child.stat().st_mtime
        except OSError:
            mtime = 0.0
        entries.append((mtime, child, _dir_nbytes(child)))
    entries.sort(key=lambda t: t[0], reverse=True)
    kept = 0
    pruned: list[dict] = []
    reason = f"carry_size_budget:{max_bytes}"
    for _mtime, child, size in entries:
        if size <= 0 or kept + size <= max_bytes:
            kept += size
            continue
        _clear_archive_content_keep_manifest(child)
        pruned.append({"id": child.name, "reason": reason, "size": size})
    return pruned


def mark_content_pruned(target_smartroomos: Path, pruned: list[dict]) -> None:
    """Record content_pruned on hand-changes-pending.json and status.json."""
    if not pruned:
        return
    by_id = {p["id"]: p for p in pruned if p.get("id")}
    pending_path = target_smartroomos / "integrity" / "hand-changes-pending.json"
    if pending_path.is_file():
        try:
            doc = json.loads(pending_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            doc = None
        if isinstance(doc, dict):
            for a in doc.get("archives") or []:
                if not isinstance(a, dict):
                    continue
                info = by_id.get(a.get("id"))
                if not info:
                    continue
                a["content_pruned"] = True
                a["content_pruned_reason"] = info["reason"]
            with contextlib.suppress(OSError):
                write_atomic(
                    pending_path,
                    (json.dumps(doc, indent=2, sort_keys=True) + "\n").encode(),
                    mode=pending_path.stat().st_mode & 0o7777,
                )
    status_path = target_smartroomos / "integrity" / "status.json"
    if status_path.is_file():
        try:
            st = json.loads(status_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            st = None
        if isinstance(st, dict):
            h = st.get("hand_changes_pending")
            if isinstance(h, dict):
                info = by_id.get(h.get("archive_id"))
                if info:
                    h["content_pruned"] = True
                    h["content_pruned_reason"] = info["reason"]
            # Also stamp any pruned ids so agents reading status see the reason.
            st.setdefault("drift_archive_pruned", [])
            if isinstance(st["drift_archive_pruned"], list):
                for p in pruned:
                    st["drift_archive_pruned"].append({
                        "id": p["id"], "content_pruned": True,
                        "content_pruned_reason": p["reason"],
                    })
            with contextlib.suppress(OSError):
                write_atomic(
                    status_path,
                    (json.dumps(st, indent=2, sort_keys=True) + "\n").encode(),
                    mode=status_path.stat().st_mode & 0o7777,
                )


def carry_into(host: Host, new_root: Path) -> list[str]:
    """Copy the room's own files from the running root into NEW_ROOT."""
    copied = []
    for entry in carry_entries(host):
        source_dir = host.p(os.path.dirname(entry))
        base = os.path.basename(entry)
        matches = sorted(source_dir.glob(base)) if any(c in base for c in "*?[") else [source_dir / base]
        for source in matches:
            if not (source.exists() or source.is_symlink()):
                continue
            rel = source.relative_to(host.p("/")) if host.prefix else source.relative_to("/")
            target = new_root / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            if target.is_symlink() or target.is_file():
                target.unlink()
            elif target.is_dir():
                shutil.rmtree(target)
            host.run(["cp", "-a", "--no-target-directory", str(source), str(target)])
            # Carry drift-archive (banner + content Lucas requires). Cap total
            # size so nested multi-GB build leftovers cannot ENOSPC the Mini.
            if str(rel) == "var/lib/smartroomos" or str(rel).endswith("var/lib/smartroomos"):
                pruned = prune_carried_drift_archive(
                    target, max_bytes=DRIFT_ARCHIVE_CARRY_MAX,
                )
                mark_content_pruned(target, pruned)
            copied.append("/" + str(rel))
    return copied


def fix_root_files(host: Host, new_root: Path, subvol: str, release: str) -> None:
    """Make the new root name itself: fstab, Limine defaults, the release id."""

    def edit(rel: str, fn) -> None:
        path = new_root / rel
        if path.is_file():
            old = path.read_text()
            new = fn(old)
            if new != old:
                write_atomic(path, new.encode(), mode=path.stat().st_mode & 0o7777)

    def fstab(text: str) -> str:
        out = []
        for line in text.split("\n"):
            if re.match(r"^[^#\s]\S*\s+/\s", line):
                line = re.sub(r"subvol=/?@(?=[\s,]|$)", f"subvol={subvol}", line)
            out.append(line)
        return "\n".join(out)

    edit("etc/fstab", fstab)

    def limine_defaults(text: str) -> str:
        def one(match):
            return match.group(1) + with_subvol(match.group(2), subvol, release) + match.group(3)
        return re.sub(r'^(KERNEL_CMDLINE\[[^\]]*\]=")([^"]*)(")', one, text, flags=re.M)

    edit("etc/default/limine", limine_defaults)
    edit("etc/default/grub", lambda t: re.sub(r"rootflags=subvol=/?@(?=[\s,\"'])", f"rootflags=subvol={subvol}", t))
    # A release built from a fresh image still carries first-boot triggers.
    # An updated room already ran first boot and ships its own verified UKI;
    # clearing those latches stops omarchy-mac-first-boot or deferred hardware
    # setup from rebuilding the UKI and overwriting the configured ESP entry
    # while a trial is running.
    for latch in (
        "var/lib/omarchy/mac-first-boot/pending",
        "var/lib/omarchy/mac-first-boot/deferred-steps",
        "var/lib/omarchy/image/deferred-steps",
        "var/lib/omarchy/image/pacman-keyring",
        "var/lib/omarchy/image/boot-rebuild",
        "var/lib/omarchy/image/initramfs-inputs",
    ):
        remove(new_root / latch)
    target = new_root / "var/lib/omarchy/image/target"
    booted = new_root / "var/lib/omarchy/image/target.booted"
    if target.is_file() or target.is_symlink():
        if not (booted.exists() or booted.is_symlink()):
            os.replace(target, booted)
        else:
            remove(target)
    info = new_root / "usr/share/smartroomos"
    info.mkdir(parents=True, exist_ok=True)
    write_atomic(info / "release-id", (release + "\n").encode(), mode=0o644)
    # Nested .snapshots so snapper works the first time this root is booted
    # (per-root nested subvolume; see docs/disk-drift.md).
    ensure_nested_snapshots(host, new_root)
    # Put the SmartRoom release signing key into pacman's keyring so
    # `pacman -Q` stops asking to import it on rooms that carried an older gnupg.
    import_release_pacman_key(host, new_root)
    # Precompile our Python so the live room never writes __pycache__ at runtime
    # (a planted .pyc must still show as drift; do not IGNORE __pycache__).
    precompile_smartroom_python(new_root)


def ensure_nested_snapshots(host: Host, root: Path) -> None:
    """Create root/.snapshots as a btrfs subvolume when missing."""
    snap = root / ".snapshots"
    if snap.exists():
        return
    if host.prefix:
        snap.mkdir(parents=True, exist_ok=True)
        return
    done = host.run(["btrfs", "subvolume", "create", str(snap)], check=False)
    if done.returncode != 0:
        snap.mkdir(parents=True, exist_ok=True)


def import_release_pacman_key(host: Host, root: Path) -> None:
    """pacman-key --add + --lsign-key for /usr/share/smartroomos/release-keyring.gpg.

    Runs after carry_into (gnupg is carried from the old room) during stage, and
    again at promote on the live root so a room staged by an older
    smartroom-release still stops asking to import the key.
    """
    keyring = root / "usr/share/smartroomos/release-keyring.gpg"
    gnupg = root / "etc/pacman.d/gnupg"
    if not keyring.is_file():
        return
    # Fingerprint of the SmartRoom package signing key (studio-build).
    fpr = "26436A50BDD17118770DE9185FDA1532DC448891"
    if host.prefix:
        # Tests: record that we would import; do not need a real keyring.
        stamp = root / "var/lib/smartroomos/release-key-imported"
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.write_text(fpr + "\n")
        return
    if not gnupg.is_dir():
        return
    # GNUPGHOME must point at the target keyring; otherwise a host agent can
    # leave the carried pubring untouched (seen on the home Studio trial).
    env_add = {"GNUPGHOME": str(gnupg)}
    host.run(
        ["pacman-key", "--gpgdir", str(gnupg), "--add", str(keyring)],
        check=False, env=env_add,
    )
    host.run(
        ["pacman-key", "--gpgdir", str(gnupg), "--lsign-key", fpr],
        check=False, env=env_add,
    )


def precompile_smartroom_python(root: Path) -> None:
    """Write __pycache__ for our shipped Python so runtime imports create no new .pyc."""
    import compileall
    targets = [
        root / "usr/local/lib/smartroomos",
        root / "usr/local/sbin",
        root / "usr/local/bin",
        root / "usr/bin",
    ]
    for path in targets:
        if path.is_dir():
            compileall.compile_dir(str(path), quiet=1, force=False, legacy=False)
        elif path.is_file() and path.suffix == ".py":
            compileall.compile_file(str(path), quiet=1, force=False)


def _set_limine_snapper_root_paths(text: str, subvol: str) -> str:
    """Point limine-snapper-sync at the live release subvol (@ or @r-<id>).

    Without this, after the first promote limine-snapper-sync refuses to run
    (`ROOT_SUBVOLUME_PATH="/@" does not match .../@r-...`) and pacman snapshot
    boot entries stop updating. As-installed stays excluded via type=post.
    """
    root = "/" + subvol.lstrip("/")
    snaps = f"{root}/.snapshots"
    for key, value in (
        ("ROOT_SUBVOLUME_PATH", f'"{root}"'),
        ("ROOT_SNAPSHOTS_PATH", f'"{snaps}"'),
    ):
        if re.search(rf"^{key}=", text, flags=re.M):
            text = re.sub(rf"^{key}=.*$", f"{key}={value}", text, flags=re.M)
        else:
            text = text.rstrip() + f"\n{key}={value}\n"
    return text


def finalize_promoted_root(host: Host, release: str, subvol: str) -> None:
    """Last root edits before the as-installed snapshot (WS13b).

    Re-normalize /etc/default/limine to the configured cmdline (no trial-only
    params) so the snapshot matches what promote leaves on disk. Also point
    limine-snapper-sync at this release's subvol so it keeps working on @r-*.
    """
    path = host.p("/etc/default/limine")
    if path.is_file():
        text = path.read_text()

        def one(match: re.Match[str]) -> str:
            rel = None if release == INSTALLED else release
            return match.group(1) + with_subvol(match.group(2), subvol, rel) + match.group(3)

        new = re.sub(r'^(KERNEL_CMDLINE\[[^\]]*\]=")([^"]*)(")', one, text, flags=re.M)
        new = _set_limine_snapper_root_paths(new, subvol)
        if new != text:
            write_atomic(path, new.encode(), mode=path.stat().st_mode & 0o7777)
    sync_conf = host.p("/etc/limine-snapper-sync.conf")
    if sync_conf.is_file():
        text = sync_conf.read_text()
        new = _set_limine_snapper_root_paths(text, subvol)
        if new != text:
            write_atomic(sync_conf, new.encode(), mode=sync_conf.stat().st_mode & 0o7777)
    precompile_smartroom_python(host.p("/"))


def exclude_as_installed_from_limine_sync(host: Host, *snap_nums: int) -> None:
    """Drop ESP UKI copies limine-snapper-sync made for as-installed snaps.

    As-installed is a drift reference, not a boot target: created as snapper
    type=post so EXCLUDE_SNAPSHOT_TYPES=post skips it. The paired pre (needed
    because snapper rejects orphan --pre-number 0) can still get a UKI copy;
    limine-snapper-remove cleans pre and any post copy that still landed.
    """
    if host.prefix:
        return
    for snap_num in snap_nums:
        if snap_num is None or snap_num < 1:
            continue
        host.run(["limine-snapper-remove", str(snap_num)], check=False)


def _snapper_print_number(done) -> Optional[int]:
    if done is None or done.returncode != 0:
        return None
    try:
        return int(done.stdout.decode().strip().splitlines()[-1])
    except (ValueError, IndexError, AttributeError):
        return None


def take_as_installed_snapshot(host: Host, release: str) -> Optional[int]:
    """Read-only snapper snapshot of the running root after promote. No cleanup algorithm.

    Type=post so limine-snapper-sync's EXCLUDE_SNAPSHOT_TYPES=post skips the
    ESP UKI copy (as-installed is a reference, not a boot target). Snapper
    requires a real pre for every post; we pair a throwaway pre, then remove
    any ESP UKI the pre may have received.
    """
    if host.prefix:
        # Scratch tests: create a marker file the integrity tool can find.
        marker = host.p("/var/lib/smartroomos/integrity/as-installed.json")
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text(json.dumps({
            "snapshot": 1, "uuid": None, "kind": "as-installed",
            "path": str(host.p("/")),
            "description": f"release {release} as installed",
            "note": None,
        }) + "\n")
        return 1
    repair = host.p("/usr/local/sbin/smartroomos-snapper-repair")
    if repair.is_file():
        host.run([str(repair)], check=False)
    desc = f"release {release} as installed"
    userdata = f"release={release},purpose=as-installed"
    pre_desc = f"as-installed pair for {release}"
    pre_done = host.run([
        "snapper", "--no-dbus", "-c", "root", "create",
        "--type", "pre", "--read-only",
        "--description", pre_desc,
        "--cleanup-algorithm", "",
        "--print-number",
    ], check=False)
    pre_num = _snapper_print_number(pre_done)
    num: Optional[int] = None
    if pre_num is not None:
        done = host.run([
            "snapper", "--no-dbus", "-c", "root", "create",
            "--type", "post", "--pre-number", str(pre_num), "--read-only",
            "--description", desc,
            "--cleanup-algorithm", "",
            "--userdata", userdata,
            "--print-number",
        ], check=False)
        num = _snapper_print_number(done)
    if num is None:
        # Older snapper or pre create failed: fall back to single, then remove
        # any ESP copy (EXCLUDE_SNAPSHOT_TYPES=post does not apply to single).
        done = host.run([
            "snapper", "--no-dbus", "-c", "root", "create",
            "--type", "single", "--read-only",
            "--description", desc,
            "--cleanup-algorithm", "",
            "--userdata", userdata,
            "--print-number",
        ], check=False)
        num = _snapper_print_number(done)
        pre_num = None
    if num is None:
        return None
    exclude_as_installed_from_limine_sync(host, *([pre_num] if pre_num else []), num)
    marker = host.p("/var/lib/smartroomos/integrity/as-installed.json")
    marker.parent.mkdir(parents=True, exist_ok=True)
    path = f"/.snapshots/{num}/snapshot"
    write_atomic(marker, (json.dumps({
        "snapshot": num, "uuid": None, "kind": "as-installed", "path": path,
        "description": desc, "note": None,
        "pre_snapshot": pre_num,
    }, indent=2) + "\n").encode(), mode=0o644)
    return num


def take_as_installed_home_snapshot(host: Host, release: str) -> Optional[int]:
    """Read-only snapper snapshot of @home at promote (WS13c).

    Lives under /home/.snapshots on the @home subvolume, so it survives when
    the release root is replaced. Same userdata as the root as-installed.
    """
    if host.prefix:
        marker = host.p("/var/lib/smartroomos/integrity/as-installed-home.json")
        marker.parent.mkdir(parents=True, exist_ok=True)
        home = host.p("/home")
        home.mkdir(parents=True, exist_ok=True)
        marker.write_text(json.dumps({
            "snapshot": 1, "uuid": None, "kind": "as-installed",
            "path": str(home),
            "description": f"release {release} as installed",
            "note": None,
        }) + "\n")
        return 1
    if not host.p("/home").is_dir():
        return None
    repair = host.p("/usr/local/sbin/smartroomos-snapper-repair")
    if repair.is_file():
        host.run([str(repair)], check=False)
    desc = f"release {release} as installed"
    userdata = f"release={release},purpose=as-installed"
    done = host.run([
        "snapper", "--no-dbus", "-c", "home", "create",
        "--type", "single", "--read-only",
        "--description", desc,
        "--cleanup-algorithm", "",
        "--userdata", userdata,
        "--print-number",
    ], check=False)
    num = _snapper_print_number(done)
    if num is None:
        return None
    marker = host.p("/var/lib/smartroomos/integrity/as-installed-home.json")
    marker.parent.mkdir(parents=True, exist_ok=True)
    path = f"/home/.snapshots/{num}/snapshot"
    write_atomic(marker, (json.dumps({
        "snapshot": num, "uuid": None, "kind": "as-installed", "path": path,
        "description": desc, "note": None,
    }, indent=2) + "\n").encode(), mode=0o644)
    return num


def archive_outgoing_drift(host: Host, state: dict, new_release: str) -> None:
    """If the current room has drift, export it before installing a new release.

    Never blocks the update and never re-applies the changes (WS13c).
    """
    if host.prefix:
        # Scratch: call the integrity tool against the fake root when present.
        tool = host.p("/usr/local/sbin/smartroomos-integrity")
        if not tool.is_file():
            return
        old = (state.get("configured") or {}).get("release") or "unknown"
        env = os.environ.copy()
        env["SMARTROOMOS_ROOT"] = str(host.p("/"))
        # Honour the shebang (python or a test stub shell script).
        subprocess.run(
            [str(tool), "archive-outgoing",
             "--old-release", str(old), "--new-release", str(new_release)],
            check=False, env=env,
        )
        return
    tool = Path("/usr/local/sbin/smartroomos-integrity")
    if not tool.is_file():
        return
    old = (state.get("configured") or {}).get("release") or "unknown"
    host.run([
        str(tool), "archive-outgoing",
        "--old-release", str(old), "--new-release", str(new_release),
    ], check=False)


def new_root_cmdline(new_root: Path, fallback: str) -> str:
    path = new_root / "etc/default/limine"
    if path.is_file():
        match = re.search(r'^KERNEL_CMDLINE\[default\]="([^"]*)"', path.read_text(), flags=re.M)
        if match:
            return match.group(1)
    return fallback


# --------------------------------------------------------------------------
# btrfs


def subvol_exists(top: Path, name: str) -> bool:
    return (top / name).exists()


def delete_subvolume(host: Host, top: Path, name: str) -> None:
    """Delete a btrfs subvolume, including nested children (e.g. .snapshots).

    WS13 nested `root/.snapshots` under every @r-* so snapper works on release
    roots. Plain `btrfs subvolume delete` refuses a parent while children
    remain, so prune left every old @r-* on disk after keep-5 (Mini VM: 10
    roots with keepGood=5). Use --recursive (btrfs-progs) after clearing ro.
    """
    target = top / name
    if not target.exists():
        return
    host.run(["btrfs", "property", "set", "-ts", str(target), "ro", "false"], check=False)
    # Also clear ro on nested snapper snapshots so --recursive can remove them.
    listed = host.run(
        ["btrfs", "subvolume", "list", "-o", str(target)], check=False,
    ).stdout.decode(errors="replace")
    for line in listed.splitlines():
        parts = line.rsplit(" path ", 1)
        if len(parts) != 2:
            continue
        rel = parts[1].strip()
        path = top / rel if not rel.startswith(name) else top / rel
        if not str(path).startswith(str(target)):
            path = target / rel
        if path.exists() and path != target:
            host.run(["btrfs", "property", "set", "-ts", str(path), "ro", "false"], check=False)
    host.run(["btrfs", "subvolume", "delete", "--recursive", "--commit-after", str(target)])


def receive_root(host: Host, top: Path, directory: Path, manifest: dict, subvol: str) -> None:
    """zstd -d | btrfs receive, then a writable snapshot named SUBVOL."""
    incoming = top / "@incoming"
    if incoming.exists():
        for child in sorted(incoming.iterdir()):
            delete_subvolume(host, incoming, child.name)
    incoming.mkdir(parents=True, exist_ok=True)
    stream = directory / manifest["root"]["file"]
    pipe = subprocess.Popen(["zstd", "-dc", str(stream)], stdout=subprocess.PIPE)
    try:
        done = subprocess.run(["btrfs", "receive", str(incoming)], stdin=pipe.stdout, capture_output=True)
    except FileNotFoundError:
        pipe.kill()
        raise Fail("btrfs is not installed")
    finally:
        if pipe.stdout:
            pipe.stdout.close()
        pipe.wait()
    if pipe.returncode != 0 or done.returncode != 0:
        tail = done.stderr.decode(errors="replace").strip().splitlines()[-3:]
        raise Fail("receiving the root stream failed: " + " | ".join(tail))
    received = [c for c in incoming.iterdir()]
    if len(received) != 1:
        raise Fail(f"the root stream must hold one subvolume, it held {len(received)}")
    host.run(["btrfs", "subvolume", "snapshot", str(received[0]), str(top / subvol)])
    host.run(["btrfs", "property", "set", "-ts", str(top / subvol), "ro", "false"], check=False)
    delete_subvolume(host, incoming, received[0].name)
    with contextlib.suppress(OSError):
        incoming.rmdir()


# --------------------------------------------------------------------------
# preconditions


def space_check(host: Host, manifest: dict, esp: Path, state: Optional[dict] = None) -> dict:
    """Refuse before anything irreversible when the ESP cannot fit trial + promote reserve.

    Worst case: trial files now, previous set at promote, one .new temp, plus ESP_MARGIN.
    Call after esp_offload_non_essential so history UKI copies are already off the ESP.
    """
    roles = {item["role"]: item for item in manifest["boot"]}
    uki_size = int(roles.get("uki", {}).get("size") or 0)
    boot_size = int(roles.get("stage2", {}).get("size") or 0)
    # Prefer live configured sizes when present (promote copies those bytes).
    layout = host.layout()
    conf_uki = esp / layout.configured_uki
    conf_boot = esp / layout.configured_boot if layout.configured_boot else None
    if conf_uki.is_file():
        uki_size = max(uki_size, file_size(conf_uki))
    if conf_boot is not None and conf_boot.is_file():
        boot_size = max(boot_size, file_size(conf_boot))
    budget = esp_budget_bytes(host, uki_size, boot_size)
    free = esp_free_bytes(esp)
    budget["free"] = free
    budget["limine_history"] = limine_history_bytes(esp)
    if free < budget["need"]:
        raise Fail(
            f"the ESP has {free // 2**20} MiB free; stage+promote needs "
            f"{budget['need'] // 2**20} MiB "
            f"(trial {budget['trial'] // 2**20} + previous reserve "
            f"{budget['previous_reserve'] // 2**20} + "
            f"{budget['spare'] // 2**20} MiB spare for .new)",
            "esp-full",
        )
    return budget


def room_pages_required(host: Host) -> str:
    """"" (off), "display" (when a display is connected) or "always"."""
    value = str(host.conf.get("require_room_pages", "no")).lower()
    return {"yes": "display", "1": "display", "true": "display", "always": "always"}.get(value, "")


def health_now(host: Host) -> dict:
    now = {"connected": host.agent_connected(), "network": host.network_up(), "displays": host.displays()}
    need = room_pages_required(host)
    if need == "always" or (need == "display" and now["displays"] > 0):
        now["pages"] = host.room_pages_up()
    return now


def healthy_sample(host: Host, baseline: dict) -> tuple[int, int, int]:
    """(Room Controller connected, network up, screens ok). Screens ok: no fewer
    displays than before the update and, only when require_room_pages=yes and a
    display is connected, at least one room page running."""
    now = health_now(host)
    want = host.conf["min_displays"]
    need = int(want) if str(want) != "" else int(baseline.get("displays", 0))
    screens = now["displays"] >= need and now.get("pages", 1) > 0
    return (1 if now["connected"] else 0, 1 if now["network"] else 0, 1 if screens else 0)


# --------------------------------------------------------------------------
# the commands


def release_rows(state: dict) -> list[dict]:
    rows = []
    conf = state.get("configured") or {}
    seen = set()
    if conf and conf.get("release"):
        rows.append({
            "number": conf.get("number", 0),
            "release": conf["release"],
            "role": "configured",
            "root": conf.get("root"),
            "bootable": bool(conf.get("uki") or conf.get("boot")),
            "current": False,
        })
        seen.add(conf["release"])
    history = list(state.get("history") or [])
    prev = state.get("previous")
    if prev and prev.get("release") and prev["release"] not in seen:
        history = [prev] + [h for h in history if h.get("release") != prev.get("release")]
    for i, entry in enumerate(history):
        if not entry or not entry.get("release") or entry["release"] in seen:
            continue
        role = "previous" if i == 0 else "history"
        rows.append({
            "number": entry.get("number", 0),
            "release": entry["release"],
            "role": role,
            "root": entry.get("root"),
            "bootable": bool(entry.get("uki") or entry.get("boot")),
            "current": False,
        })
        seen.add(entry["release"])
    return rows


def status_doc(host: Host, state: dict) -> dict:
    root = running_root(host)
    release = running_release(host, state)
    trial_state = state.get("trial")
    conf = state.get("configured") or {}
    prev = state.get("previous")
    layout = host.layout()
    # Studio: aurora,trial stays in the device tree until reboot. After a
    # committed promote on this boot, trust state (trial is None) so status
    # does not keep saying "trial boot" (WS13b / same class as trial_pending).
    if layout.uses_aura:
        on_trial = bool(host.dt_trial()) and bool(trial_state)
        if trial_state is None and (state.get("last_result") or {}).get("result") == "committed":
            on_trial = False
    else:
        on_trial = (
            bool(trial_state) and trial_state.get("phase") in ("booting", "armed")
            and root == trial_state.get("root"))
        # Prefer the cmdline / root fact for Mini once userspace is up.
        if trial_state and root == trial_state.get("root") and release == trial_state.get("release"):
            on_trial = True
    last = state.get("last_result")
    number = 0
    for entry in [conf, prev or {}] + list(state.get("history") or []):
        if entry and entry.get("release") == release:
            number = entry.get("number", 0)
    esp = host.esp()
    used = None
    free = None
    total = None
    with contextlib.suppress(OSError):
        usage = shutil.disk_usage(esp)
        total = usage.total
        free = usage.free
        used = round(100 * (usage.total - usage.free) / usage.total) if usage.total else None
    rows = release_rows(state)
    for row in rows:
        row["current"] = row["release"] == release
        # bootable if ESP slots or btrfs boot-store has the UKI
        if not row["bootable"] and row.get("release"):
            row["bootable"] = boot_store_has(host, row["release"])
        elif row.get("release"):
            row["bootable"] = bool(row["bootable"]) or boot_store_has(host, row["release"])
    budget = state.get("esp_budget")
    doc = {
        "available": True,
        "line": state.get("line") or layout.line,
        "backend": "smartroom-release",
        "keepGood": KEEP_GOOD,
        "running": {"root": "live", "number": number, "entry": root, "release": release, "trial": on_trial},
        "fallback": None,
        "trial": None,
        "firmware": release,
        "count": len(rows),
        "protected": 0,
        "esp": {
            "usedPercent": used,
            "limitPercent": 90,
            "freeBytes": free,
            "totalBytes": total,
            "bootStore": BOOT_STORE,
            "limineHistoryBytes": limine_history_bytes(esp),
            "budget": budget,
        },
        "release": {
            "running": release,
            "configured": conf.get("release"),
            "previous": prev.get("release") if prev else None,
            "boot": "trial" if on_trial else "configured",
            "last_result": last,
        },
        "events": state.get("events", [])[-20:],
    }
    doc["release"]["root_check"] = state.get("root_check")
    kept = load_kept_check(host)
    if kept is not None:
        by_root = {r.get("root"): r for r in kept.get("roots", [])}
        for row in rows:
            found = by_root.get(row.get("root"))
            if found and found.get("release") == row.get("release"):
                row["rootCheck"] = {k: found.get(k) for k in ("ok", "count", "rules", "error", "at")}
        doc["keptRootsCheck"] = {"at": kept.get("at"), "ok": kept.get("ok"),
                                 "note": "information: rollback and restore do not refuse on it yet"}
    if trial_state:
        layers = ["limine", "aura"] if layout.uses_aura else ["limine", "watchdog"]
        doc["trial"] = {"kind": trial_state.get("kind", "update"), "armed": trial_state.get("armed_at"),
                        "layers": layers, "fallbackSnapshot": conf.get("number"),
                        "target": trial_state.get("number"), "phase": trial_state.get("phase")}
    if last and last.get("result") == "rolled-back":
        doc["fallback"] = {"of": last.get("number"), "since": last.get("at"), "reason": last.get("reason")}
    return doc


KEPT_CHECK_FILE = "/var/lib/smartroomos/release-kept-roots.json"   # a cache on the root, not on the ESP
KEPT_FINDINGS = 10


def kept_check_path(host: Host) -> Path:
    return host.p(KEPT_CHECK_FILE)


def load_kept_check(host: Host) -> Optional[dict]:
    with contextlib.suppress(OSError, ValueError):
        doc = json.loads(kept_check_path(host).read_text())
        if isinstance(doc, dict):
            return doc
    return None


def check_kept_roots(host: Host, state: dict) -> dict:
    """The root invariant on every kept release root this room could roll back or
    restore to (not the running root: integrity checks that one). Information only."""
    running = running_root(host)
    roots = []
    targets = [r for r in release_rows(state) if r.get("root") and r.get("root") != running]
    if not targets:
        return {"at": host.stamp(), "checked_unix": host.now(), "ok": True, "running": running, "roots": []}
    with host.top() as top:
        for row in targets:
            item = {"release": row["release"], "root": row["root"], "role": row["role"], "at": host.stamp()}
            path = top / row["root"]
            try:
                if not path.is_dir():
                    raise Fail(f"{row['root']} is not on this disk", "not-found")
                report = host.check_root(path)
                item.update(ok=report.ok, count=report.count, checked=report.checked,
                            rules=report.as_dict()["rules"], findings=report.findings[:KEPT_FINDINGS])
            except Exception as exc:   # noqa: BLE001 - information only
                item.update(ok=None, error=(exc.message if isinstance(exc, Fail) else
                                            f"{type(exc).__name__}: {exc}")[:300])
            roots.append(item)
    verdicts = [r["ok"] for r in roots]
    ok = False if False in verdicts else (None if None in verdicts else True)
    return {"at": host.stamp(), "checked_unix": host.now(), "ok": ok, "running": running,
            "roots": roots}


def cmd_check_kept(host: Host, args) -> int:
    """check-kept [--max-age S]: run (or reuse, when younger than S and the same
    roots) the invariant on the kept rollback targets; cached for status --json."""
    state = load_state(host)
    want = sorted((r["release"], r["root"]) for r in release_rows(state)
                  if r.get("root") and r.get("root") != running_root(host))
    doc = load_kept_check(host)
    fresh = (doc is not None and args.max_age is not None
             and host.now() - float(doc.get("checked_unix") or 0) < args.max_age
             and sorted((r.get("release"), r.get("root")) for r in doc.get("roots", [])) == want)
    if not fresh:
        require_root(host)
        doc = check_kept_roots(host, state)
        write_atomic(kept_check_path(host), json.dumps(doc, indent=2, sort_keys=True).encode(), 0o644)
    if args.json:
        print(json.dumps(doc, sort_keys=True))
    else:
        for r in doc["roots"]:
            verdict = {True: "ok", False: "FAIL", None: "not checked"}[r.get("ok")]
            detail = r.get("error") or ", ".join(f"{k} {v}" for k, v in (r.get("rules") or {}).items())
            print(f"{r['role']:<10} {r['release']:<36} {verdict}  {detail}".rstrip())
    return 0


def cmd_status(host: Host, args) -> int:
    doc = status_doc(host, load_state(host))
    if args.json:
        print(json.dumps(doc, sort_keys=True))
        return 0
    rel = doc["release"]
    print(f"running    {rel['running']} ({rel['boot']} boot, root {doc['running']['entry']})")
    print(f"configured {rel['configured']}")
    print(f"previous   {rel['previous'] or '-'}")
    trial = doc["trial"]
    print(f"trial      {trial['phase'] + ' ' + str(trial['target']) if trial else '-'}")
    if rel["last_result"]:
        print("last       " + json.dumps(rel["last_result"], sort_keys=True))
    for record in doc["events"][-8:]:
        fields = " ".join(f"{k}={v}" for k, v in record.items() if k not in ("event", "at"))
        print(f"event      {record['at']} {record['event']} {fields}".rstrip())
    return 0


def cmd_list(host: Host, args) -> int:
    state = load_state(host)
    rows = release_rows(state)
    running = running_release(host, state)
    for row in rows:
        row["current"] = row["release"] == running
    if args.json:
        print(json.dumps({"snapshots": rows, "status": status_doc(host, state)}, sort_keys=True))
    else:
        for row in rows:
            print(f"{row['number']:>3} {row['release']:<24} {row['role']:<10} {row['root']}"
                  f"{'  (running)' if row['current'] else ''}")
    return 0


def require_root(host: Host) -> None:
    if not host.prefix and os.geteuid() != 0:
        raise Fail("run as root")


def stage_release(host: Host, state: dict, directory: Path, unsigned: bool, kind: str = "update",
                  require_healthy: bool = True) -> dict:
    layout = host.layout()
    state["line"] = layout.line
    manifest = load_manifest(directory)
    release = manifest["id"]
    mline = manifest.get("line")
    if mline and mline != layout.line:
        raise Fail(f"this release is for {mline}, this room is {layout.line}", "wrong-line")
    if layout.line == "studio" and "stage2" not in {i.get("role") for i in manifest["boot"]}:
        raise Fail("a Studio release needs a stage2 boot file")
    if layout.line == "mini" and "stage2" in {i.get("role") for i in manifest["boot"]} and mline == "studio":
        raise Fail("refusing a Studio release on a Mini", "wrong-line")
    signed = verify_signature(host, directory, unsigned)
    if state.get("trial") and state["trial"].get("phase") in ("armed", "booting", "promoting"):
        raise Fail("a trial boot is already pending", "trial-pending")
    if state.get("promoting"):
        raise Fail("a promotion is unfinished; the health service finishes it at boot", "trial-pending")
    known = {state["configured"].get("release")}
    known |= {h.get("release") for h in (state.get("history") or []) if h}
    if (state.get("previous") or {}).get("release"):
        known.add(state["previous"]["release"])
    if release in known and kind != "migrate":
        raise Fail(f"release {release} is already on this room", "not-found")
    esp = host.esp()
    if require_healthy:
        now_ok = healthy_sample(host, {"displays": 0})
        if now_ok[0] == 0 or now_ok[1] == 0:
            raise Fail("this room is not healthy now (Room Controller or network down); "
                       "an update would look like a failed one. Fix that first.", "unhealthy")
    baseline = {"displays": host.displays()}
    check_files(directory, manifest)
    roles = {item["role"]: item for item in manifest["boot"]}
    # WS14: move legacy ESP UKI store + previous fallback off the ESP before budgeting.
    esp_offload_non_essential(host, state, for_trial=True)
    try:
        return _stage_after_offload(host, state, directory, manifest, release, layout, esp,
                                    baseline, roles, signed, kind)
    except BaseException:
        # Refused or failed after the cleanup above moved the previous release's boot
        # files off the ESP: put that one fallback back, whatever the refusal was.
        with contextlib.suppress(Exception):
            restore_previous_to_esp(host, state)
            save_state(host, state)
        raise


def _stage_after_offload(host: Host, state: dict, directory: Path, manifest: dict, release: str,
                         layout: BootLayout, esp: Path, baseline: dict, roles: dict, signed: bool,
                         kind: str) -> dict:
    try:
        budget = space_check(host, manifest, esp, state)
    except Fail as exc:
        if exc.code == "esp-full":
            record_result(host, state, "refused", reason="esp-full", message=exc.message)
            event(host, state, "stage-refused", reason="esp-full", message=exc.message)
            save_state(host, state)
        raise
    subvol = subvol_name(release)
    cmdline = None
    # WS13c: save hand changes from the outgoing root before we replace it.
    # Never blocks; never re-applies. Banner stays until ack.
    archive_outgoing_drift(host, state, release)
    prune(host, state)                 # roots left by failed trials are dead weight; free their space first
    with host.top() as top:
        if subvol_exists(top, subvol):
            delete_subvolume(host, top, subvol)
        receive_root(host, top, directory, manifest, subvol)
        new_root = top / subvol
        carried = carry_into(host, new_root)
        cfg_text = (esp / "limine.conf").read_text()
        found = kernel_entry(cfg_text)
        if not found:
            raise Fail("limine.conf has no kernel entry; this is not a Limine room")
        cmdline = new_root_cmdline(new_root, found[1])
        require_zero_touch(cmdline)
        fix_root_files(host, new_root, subvol, release)
        try:
            report = host.check_root(new_root)
        except Exception as exc:   # noqa: BLE001 - nothing is armed yet: refusing strands nothing
            delete_subvolume(host, top, subvol)
            message = exc.message if isinstance(exc, Fail) else f"{type(exc).__name__}: {exc}"
            record_result(host, state, "refused", reason="root-check-error", message=message, release=release)
            event(host, state, "stage-refused", reason="root-check-error", release=release, message=message)
            save_state(host, state)
            raise Fail(f"release {release} not staged: the root check could not run: {message}",
                       "root-check-error")
        if not report.ok:
            delete_subvolume(host, top, subvol)
            record_result(host, state, "refused", reason="unsafe-root", message=report.summary(),
                          release=release, findings=report.findings[:20])
            event(host, state, "stage-refused", reason="unsafe-root", release=release, count=report.count)
            save_state(host, state)
            print(report.text(), file=sys.stderr)
            raise Fail(f"release {release} refused: {report.summary()}", "unsafe-root")
    # boot files, beside the configured ones (ESP); durable copy on btrfs boot-store.
    trial_uki = layout.trial_uki
    trial_boot = layout.trial_boot
    stage2_src = directory / roles["stage2"]["path"] if layout.uses_aura else None
    uki_src = directory / roles["uki"]["path"]
    if layout.uses_aura and stage2_src is not None:
        copy_atomic(stage2_src, esp / trial_boot, roles["stage2"]["sha256"])
    copy_atomic(uki_src, esp / trial_uki, roles["uki"]["sha256"])
    boot_store_put(
        host, release, uki_src, stage2_src if layout.uses_aura else None,
        roles["uki"]["sha256"], roles["stage2"]["sha256"] if layout.uses_aura else None,
    )
    trial_cmd = trial_cmdline(cmdline, subvol, release)
    cfg_text = ensure_unattended_limine(with_trial_entry(cfg_text, release, trial_uki, trial_cmd))
    write_atomic(esp / "limine.conf", cfg_text.encode(), 0o700)
    state["counter"] = state.get("counter", 0) + 1
    state["esp_budget"] = budget
    state["trial"] = {
        "kind": kind, "release": release, "number": state["counter"], "root": subvol,
        "boot": trial_boot, "uki": trial_uki, "cmdline": with_subvol(cmdline, subvol, release),
        "phase": "staged", "staged_at": host.stamp(), "baseline": baseline, "signed": signed,
        "carried": len(carried), "reached": False, "line": layout.line,
    }
    event(host, state, "started", release=release, previous=state["configured"].get("release"), line=layout.line)
    event(host, state, "files-checked", result="ok", release=release, signed=signed)
    save_state(host, state)
    return state


def find_release_entry(state: dict, number: Optional[int] = None, release: Optional[str] = None) -> dict:
    """Locate a kept release by number or id (configured, previous, or history)."""
    conf = state.get("configured") or {}
    candidates = []
    if conf.get("release"):
        candidates.append(conf)
    if state.get("previous"):
        candidates.append(state["previous"])
    candidates.extend(state.get("history") or [])
    for entry in candidates:
        if not entry:
            continue
        if number is not None and entry.get("number") == number:
            return entry
        if release is not None and entry.get("release") == release:
            return entry
    raise Fail(f"release {'number ' + str(number) if number is not None else release} is not on this room", "not-found")


def promote_previous_as_trial(host: Host, state: dict, entry: Optional[dict] = None) -> dict:
    """A rollback is a trial of a kept release whose files are on disk (ESP or boot-store)."""
    layout = host.layout()
    prev = entry or state.get("previous")
    if not prev:
        raise Fail("there is no previous release on this room", "not-found")
    esp = host.esp()
    # Ensure durable store is populated from any legacy ESP copies first.
    esp_offload_non_essential(host, state, for_trial=True)
    try:
        return _rollback_trial_after_offload(host, state, prev, layout, esp)
    except BaseException:
        # As in stage: a rollback that is refused or fails after the cleanup above puts
        # the previous release's boot files back on the ESP (the room's one fallback).
        with contextlib.suppress(Exception):
            restore_previous_to_esp(host, state)
            save_state(host, state)
        raise


def _rollback_trial_after_offload(host: Host, state: dict, prev: dict, layout: BootLayout, esp: Path) -> dict:
    uki_src, boot_src = resolve_boot_files(host, prev, state=state)
    with host.top() as top:
        if prev["root"] and not subvol_exists(top, prev["root"]):
            raise Fail(f"the previous root {prev['root']} is gone", "not-found")
        if prev["root"] and str(host.conf.get("refuse_unsafe_rollback", "no")).lower() in ("yes", "1", "true"):
            refuse_unsafe_target(host, state, prev, top / prev["root"])
    # Budget: trial files + promote previous reserve (same as an update).
    uki_sz = file_size(uki_src)
    boot_sz = file_size(boot_src) if boot_src else 0
    budget = esp_budget_bytes(host, uki_sz, boot_sz)
    free = esp_free_bytes(esp)
    if free < budget["need"]:
        raise Fail(
            f"the ESP has {free // 2**20} MiB free; rollback trial needs "
            f"{budget['need'] // 2**20} MiB reserved",
            "esp-full",
        )
    cfg_text = (esp / "limine.conf").read_text()
    found = kernel_entry(cfg_text)
    if not found:
        raise Fail("limine.conf has no kernel entry")
    # Its own files keep their names; the trial files are copies so mark-good is the same steps.
    if layout.uses_aura and boot_src is not None:
        copy_atomic(boot_src, esp / layout.trial_boot)
    copy_atomic(uki_src, esp / layout.trial_uki)
    cmdline = with_subvol(found[1], prev["root"] or "@", None if prev["release"] == INSTALLED else prev["release"])
    require_zero_touch(cmdline)
    state["counter"] = state.get("counter", 0) + 1
    state["esp_budget"] = budget
    state["trial"] = {
        "kind": "rollback", "release": prev["release"], "number": prev.get("number", 0), "root": prev["root"],
        "boot": layout.trial_boot, "uki": layout.trial_uki, "cmdline": cmdline,
        "phase": "staged", "staged_at": host.stamp(), "baseline": {"displays": host.displays()},
        "signed": None, "carried": 0, "reached": False, "line": layout.line,
    }
    write_atomic(esp / "limine.conf",
                 with_trial_entry(cfg_text, prev["release"], layout.trial_uki,
                                  cmdline + " " + " ".join(TRIAL_ONLY_PARAMS)).encode(), 0o700)
    event(host, state, "started", release=prev["release"], previous=state["configured"].get("release"), kind="rollback")
    save_state(host, state)
    return state


def refuse_unsafe_target(host: Host, state: dict, entry: dict, root: Path) -> None:
    """refuse_unsafe_rollback=yes: a kept root that fails the invariant is never armed.
    A check that cannot run does not refuse (as on a trial)."""
    try:
        report = host.check_root(root)
    except Exception as exc:   # noqa: BLE001
        message = exc.message if isinstance(exc, Fail) else f"{type(exc).__name__}: {exc}"
        event(host, state, "root-check-error", release=entry.get("release"), message=message[:300])
        save_state(host, state)
        return
    if report.ok:
        return
    record_result(host, state, "refused", reason="unsafe-root", release=entry.get("release"),
                  message=report.summary(), findings=report.findings[:20])
    event(host, state, "rollback-refused", reason="unsafe-root", release=entry.get("release"), count=report.count)
    save_state(host, state)
    raise Fail(f"release {entry.get('release')} not armed: {report.summary()}", "unsafe-root")


def arm_trial(host: Host, state: dict) -> dict:
    trial = state.get("trial")
    if not trial or trial.get("phase") != "staged":
        raise Fail("nothing is staged", "not-found")
    layout = host.layout()
    esp = host.esp()
    # the files must still check out, right before they can be booted
    need = [trial["uki"]]
    if trial.get("boot"):
        need.append(trial["boot"])
    for rel in need:
        if not (esp / rel).is_file():
            raise Fail(f"staged file {rel} is missing")
    text = (esp / "limine.conf").read_text()
    if f"/{TRIAL_ENTRY_NAME}" not in text:
        raise Fail("the Limine trial entry is not in limine.conf")
    host.ensure_watchdog_module()
    # 1. Limine's one-shot
    host.set_oneshot(TRIAL_ENTRY_ID)
    host.save_efi_vars()
    if not host.oneshot_saved():
        host.set_oneshot(None)
        with contextlib.suppress(Fail):
            host.save_efi_vars()
        raise Fail("the Limine one-shot did not persist; nothing is armed")
    # 2. Studio: aura-try last (arms the hardware watchdog and starts the trial image).
    #    Mini: ESP marker under smartroom-release/ (Limine one-shot is the switch).
    if layout.uses_aura:
        write_atomic(esp / MARKER, f"armed\n{trial['boot']}\n".encode(), 0o700)
        event_path = trial["boot"]
    else:
        write_atomic(esp / STATE_DIR / MINI_MARKER, f"armed\n{trial['uki']}\n".encode(), 0o700)
        event_path = trial["uki"]
    trial["phase"] = "armed"
    trial["armed_at"] = host.stamp()
    trial["armed_boot_id"] = host.boot_id()
    event(host, state, "armed", release=trial["release"], path=event_path, line=layout.line)
    save_state(host, state)
    return state


def clear_trial_files(host: Host, state: dict, keep_subvolume: bool = True) -> None:
    layout = host.layout()
    esp = host.esp()
    remove(esp / MARKER)
    remove(esp / STATE_DIR / MINI_MARKER)
    for rel in (layout.trial_boot, layout.trial_uki, TRIAL_BOOT, TRIAL_UKI):
        if rel:
            remove(esp / rel)
    cfg = esp / "limine.conf"
    if cfg.is_file():
        text = cfg.read_text()
        stripped = strip_trial_entry(text)
        if stripped != text:
            write_atomic(cfg, stripped.encode(), 0o700)
    with contextlib.suppress(Exception):
        if host.efivar(ONESHOT).exists():
            host.set_oneshot(None)
            host.save_efi_vars()


def cmd_stage(host: Host, args) -> int:
    require_root(host)
    state = load_state(host)
    directory = fetch(host, args.release)
    stage_release(host, state, directory, args.unsigned)
    print(f"staged {state['trial']['release']} as {state['trial']['root']}; nothing is armed")
    return 0


def cmd_arm(host: Host, args) -> int:
    require_root(host)
    state = load_state(host)
    arm_trial(host, state)
    print(f"armed {state['trial']['release']}: the next boot is the trial")
    if args.reboot:
        host.reboot()
    return 0


def cmd_update(host: Host, args) -> int:
    require_root(host)
    state = load_state(host)
    directory = fetch(host, args.release)
    stage_release(host, state, directory, args.unsigned)
    try:
        arm_trial(host, state)
    except Fail:
        # Nothing is armed. Leave the staged files out of the next boot's way.
        clear_trial_files(host, state)
        state["trial"] = None
        event(host, state, "files-written-not-armed", reason="arm failed")
        save_state(host, state)
        raise
    print(f"armed {state['trial']['release']}: the next boot is the trial")
    if args.reboot:
        host.reboot()
    return 0


def cmd_rollback(host: Host, args) -> int:
    require_root(host)
    state = load_state(host)
    if state.get("trial") and state["trial"].get("phase") in ("armed", "booting"):
        raise Fail("a trial boot is already pending", "trial-pending")
    promote_previous_as_trial(host, state)
    try:
        arm_trial(host, state)
    except Fail:
        clear_trial_files(host, state)
        state["trial"] = None
        save_state(host, state)
        raise
    print(f"armed a trial of the previous release {state['trial']['release']}")
    if args.reboot:
        host.reboot()
    return 0


def cmd_discard(host: Host, args) -> int:
    require_root(host)
    state = load_state(host)
    trial = state.get("trial")
    if trial and trial.get("phase") in ("booting",):
        raise Fail("the trial is running; let the health check finish", "trial-pending")
    clear_trial_files(host, state)
    if trial:
        event(host, state, "discarded", release=trial.get("release"))
        state["trial"] = None
        save_state(host, state)
    with host.top() as top:
        for child in sorted(top.glob("@r-*")):
            keep = {(state.get("configured") or {}).get("root"), (state.get("previous") or {}).get("root"),
                    running_root(host)}
            if child.name not in keep:
                delete_subvolume(host, top, child.name)
    print("discarded")
    return 0


def cmd_restore(host: Host, args) -> int:
    """Room Controller contract: snapshots.rollback -> restore N --no-reboot."""
    require_root(host)
    state = load_state(host)
    if state.get("trial"):
        raise Fail("a trial boot is already pending", "trial-pending")
    entry = find_release_entry(state, number=args.number)
    if entry.get("release") == (state.get("configured") or {}).get("release"):
        raise Fail("that release is already configured", "not-found")
    promote_previous_as_trial(host, state, entry=entry)
    arm_trial(host, state)
    out = {"accepted": True, "trialId": state["trial"]["armed_at"], "fallbackSnapshot": state["configured"].get("number"),
           "rebootAt": host.stamp()}
    print(json.dumps(out))
    if not args.no_reboot:
        host.reboot()
    return 0


# --------------------------------------------------------------------------
# build-release: the producing side, from a room (or later, an image)


def _aside_ephemeral_for_build(host: Host, out: Path) -> list[tuple[Path, Path]]:
    """Park drift archives and leftover local release dirs off the root briefly.

    build-release snapshots the live root; nested prior /root/*release* payloads
    and /var/lib/smartroomos/drift-archive (which can hold multi-GB
    root.btrfs.zst copies) would otherwise inflate every later stream and
    ENOSPC Mini keep-5. Moved aside for the snapshot only, then restored.
    """
    moved: list[tuple[Path, Path]] = []
    aside_root = host.p("/var/lib/smartroomos/build-aside")
    if aside_root.exists():
        shutil.rmtree(aside_root, ignore_errors=True)
    aside_root.mkdir(parents=True, exist_ok=True)
    out_resolved = out.resolve() if out.exists() else out
    candidates: list[Path] = []
    arch = host.p("/var/lib/smartroomos/drift-archive")
    if arch.is_dir():
        candidates.append(arch)
    for parent_name in ("/root", "/home"):
        root_dir = host.p(parent_name)
        if not root_dir.is_dir():
            continue
        for child in sorted(root_dir.iterdir()):
            name = child.name
            if not (name.startswith("ws12-release") or name.startswith("ws13b-rel")
                    or name.startswith("ws13-rel") or name.endswith("-rel")):
                continue
            try:
                if child.resolve() == out_resolved or out_resolved.is_relative_to(child.resolve()):
                    continue
            except (OSError, ValueError):
                continue
            candidates.append(child)
    for i, src in enumerate(candidates):
        dst = aside_root / f"{i}-{src.name}"
        try:
            src.rename(dst)
            moved.append((src, dst))
        except OSError:
            continue
    return moved


def _check_then_send(host: Host, snap: Path, stream: Path) -> None:
    """The root invariant on the read-only snapshot, then send exactly that snapshot."""
    report = host.check_root(snap)
    if not report.ok:
        print(report.text(), file=sys.stderr)
        raise Fail(f"build-release refused, nothing sent or signed: {report.summary()}", "unsafe-root")
    with open(stream, "wb") as sink:
        send = subprocess.Popen(["btrfs", "send", "-q", str(snap)], stdout=subprocess.PIPE)
        comp = subprocess.Popen(["zstd", "-T0", "-3", "-c"], stdin=send.stdout, stdout=sink)
        send.stdout.close()
        comp.wait()
        send.wait()
    if send.returncode != 0 or comp.returncode != 0:
        raise Fail("btrfs send | zstd failed")


def cmd_build_release(host: Host, args) -> int:
    require_root(host)
    release = safe_id(args.id)
    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    stream = out / "root.btrfs.zst"
    # A refused or failed build leaves no manifest or signature, not even an older one.
    for name in (MANIFEST, MANIFEST + ".sig", stream.name):
        remove(out / name)
    source_info = {}
    for item in args.source_info:
        key, sep, value = item.partition("=")
        if not sep or not re.fullmatch(r"[a-z][a-z0-9_-]*", key):
            raise Fail(f"--source-info wants KEY=VALUE, not {item}", "usage")
        source_info[key] = value
    if args.source_path:
        # A build host: release the image's root subvolume, with the boot files given.
        if not args.line or not args.uki_from or (args.line == "studio" and not args.boot_from):
            raise Fail("--source-path needs --line, --uki-from and (studio) --boot-from", "usage")
        layout = LAYOUT_STUDIO if args.line == "studio" else LAYOUT_MINI
        src_uki = Path(args.uki_from)
        src_boot = Path(args.boot_from) if args.boot_from else None
        source = Path(args.source_path)
        if not source.is_dir():
            raise Fail(f"{source} is not a directory", "not-found")
        snap = source.parent / f"@build-{release}"
        if snap.exists():
            delete_subvolume(host, source.parent, snap.name)
        host.run(["btrfs", "subvolume", "snapshot", "-r", str(source), str(snap)])
        try:
            _check_then_send(host, snap, stream)
        finally:
            delete_subvolume(host, source.parent, snap.name)
    else:
        layout = host.layout()
        if args.line and args.line != layout.line:
            raise Fail(f"this room is {layout.line}, not {args.line}", "wrong-line")
        esp = host.esp()
        src_uki = Path(args.uki_from) if args.uki_from else esp / layout.configured_uki
        src_boot = Path(args.boot_from) if args.boot_from else (esp / layout.configured_boot if layout.configured_boot else None)
        moved = _aside_ephemeral_for_build(host, out)
        try:
            with host.top() as top:
                source_name = args.source_subvol or running_root(host)
                snap = top / f"@build-{release}"
                if snap.exists():
                    delete_subvolume(host, top, snap.name)
                host.run(["btrfs", "subvolume", "snapshot", "-r", str(top / source_name), str(snap)])
                try:
                    _check_then_send(host, snap, stream)
                finally:
                    delete_subvolume(host, top, snap.name)
        finally:
            for src, dst in reversed(moved):
                try:
                    if src.exists():
                        shutil.rmtree(src, ignore_errors=True)
                    dst.rename(src)
                except OSError:
                    pass
            aside_root = host.p("/var/lib/smartroomos/build-aside")
            shutil.rmtree(aside_root, ignore_errors=True)
    boot = []
    if layout.uses_aura:
        if src_boot is None or not Path(src_boot).is_file():
            raise Fail("Studio build-release needs the configured stage2 boot file")
        rel = "m1n1/boot.bin"
        dst = out / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        digest = copy_atomic(Path(src_boot), dst)
        boot.append({"role": "stage2", "path": rel, "sha256": digest, "size": dst.stat().st_size})
        uki_rel = "EFI/Linux/omarchy_linux-aurora.efi"
    else:
        uki_rel = "EFI/Linux/smartroomos_linux-t2.efi"
    if not Path(src_uki).is_file():
        raise Fail(f"build-release: UKI missing at {src_uki}")
    dst = out / uki_rel
    dst.parent.mkdir(parents=True, exist_ok=True)
    digest = copy_atomic(Path(src_uki), dst)
    boot.append({"role": "uki", "path": uki_rel, "sha256": digest, "size": dst.stat().st_size})
    manifest = {
        "schema": SCHEMA, "id": release, "created": host.stamp(), "parent": args.parent or None,
        "line": layout.line,
        "root": {"file": "root.btrfs.zst", "sha256": sha256_file(stream), "size": stream.stat().st_size},
        "boot": boot,
    }
    if source_info:
        manifest["source"] = source_info
    write_atomic(out / MANIFEST, (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode(), 0o644)
    if args.sign_key:
        host.run(["gpg", "--batch", "--yes", "--detach-sign", "--local-user", args.sign_key,
                  "--output", str(out / (MANIFEST + ".sig")), str(out / MANIFEST)])
    print(f"release {release} written to {out}")
    return 0



# --------------------------------------------------------------------------
# check-root: the root invariant (one rule for every root a room can boot)
#
# 2026-11-24: the Studio releases 2026.11.24-studio-edge and -edge-b shipped
# about 200 system paths owned by uid/gid 1000 (/, /etc, /usr, /usr/bin,
# /usr/lib, units, initcpio hooks, pacman.conf, /etc/sudoers.d). uid 1000 is
# smartroomcontroller, the kiosk and Room Controller user. sudo ignored its
# rules, and the kiosk user could have become root. A job script had rsynced
# the overlay with the build user's owner, and no gate ran on that path.
#
# This is the only implementation. Every caller runs this code:
#   smartroom-release build-release   the root it is about to send and sign
#   smartroom-release stage/update    the received root, before a trial is armed
#   smartroom-release health-run      the running trial root, before mark-good
#   smartroomos-integrity             the running room (reason unsafe-root)
#   fw builder/image/check-image(-x86_64), installer smartroom/desk-check,
#   fw bin/smartroomos-release-sign   `smartroom-release check-root ...`
# fw overlay/usr/bin/smartroom-release is a byte copy of this file
# (fw test/unit/mini-release-tool.sh), so the Studio and the Mini run the same rule.
#
# A root fails on any of:
#   login-owner      a path outside the exempt trees whose uid or gid is a login
#                    id (>= 1000, except 65534 nobody/nogroup)
#   rc-owner         a path outside the exempt trees owned by the Room Controller
#                    user or group, looked up by name in the root's own
#                    /etc/passwd and /etc/group (whatever number it has)
#   system-owner     a path under /etc, /usr or /opt outside the exempt trees whose
#                    owner is not root (system groups are fine; installer desk-check's rule)
#   system-dir       /, /etc, /usr, a direct child of /usr, /etc/sudoers,
#                    /etc/sudoers.d or a file in it: not root:root, or (not a
#                    symlink) writable by group or other
#   sudoers-mode     /etc/sudoers or a file in /etc/sudoers.d (not a symlink)
#                    has a mode bit beyond 0440 (what plain `visudo -c` enforces)
#   sudoers-missing  no /etc/sudoers
#   visudo           `visudo -c` fails on the root's sudoers and sudoers.d
#   unreadable       a path the check cannot list or stat, or (stream) sudoers,
#                    passwd or group whose contents the stream does not carry:
#                    the check cannot vouch for it
#
# The check stays on the root's own filesystem (on btrfs: its own subvolume,
# exactly what a release contains). A directory on another filesystem or
# subvolume (/boot, the ESP, @log, @home, /mnt, /media, a USB stick, a nested
# subvolume) is neither judged nor walked; `other_filesystems` lists it.
#
# Exit codes of `check-root`: 0 the root passes, 1 the root fails (unsafe),
# 3 the check itself failed (a bad stream, a missing path, a crash): that is
# not a verdict on the root. A room's trial treats 3 as "not proven unsafe"
# (it logs it and shows it on ops, and never refuses on it; a tool bug must
# never strand a room). The build side refuses on any non-zero exit.

RC_USER = "smartroomcontroller"
LOGIN_ID_MIN = 1000
OVERFLOW_ID = 65534  # nobody / nogroup

# Trees where a login id may own paths. Derived 2026-11-24 from the good
# release root 2026.11.21-studio-ws14b, the Mini image 2026.11.21-mini and
# the repaired Home Studio. (path, the path itself is exempt too, why)
ROOT_EXEMPT_TREES = (
    ("home", False,
     "users' homes (kiosk profile, ssh keys). /home itself stays root's."),
    ("opt/smartroom", True,
     "the Room Controller's own directory: it self-updates (agent-next beside agent) and "
     "writes logs/. The firmware gives it to the Room Controller "
     "(usr/lib/tmpfiles.d/smartroom-room-controller.conf)."),
    ("tmp", False, "sticky world-writable scratch (tmpfs on a room, empty in an image)"),
    ("var/tmp", False, "sticky world-writable scratch, as /tmp"),
)
# systemd DynamicUser= ids (61184..65519) own their StateDirectory/CacheDirectory/
# LogsDirectory under these 0700 root directories, where no login reaches them
# (speakersafetyd on the Studio). Only those ids are exempt there.
ROOT_DYNAMIC_IDS = (61184, 65519)
ROOT_DYNAMIC_TREES = ("var/lib/private", "var/cache/private", "var/log/private")
# Not walked below (the path itself is still checked): kernel and runtime
# filesystems of a running room (empty in an image), and snapper history
# (read-only snapshots, never part of a release; old ones may keep owners a
# release has since fixed).
ROOT_NO_DESCEND = ("proc", "sys", "dev", "run", ".snapshots")
ROOT_SYSTEM_DIRS = ("", "etc", "usr", "etc/sudoers.d", "etc/sudoers")
ROOT_SYSTEM_TREES = ("etc", "usr", "opt")
SUDOERS_REL = "etc/sudoers"
SUDOERS_D_REL = "etc/sudoers.d"
ROOT_FINDINGS_CAP = 200
ROOT_OTHER_FS_CAP = 50
SUDOERS_MODE_MAX = 0o440
CHECK_ROOT_ERROR = 3   # check-root's exit code when the check could not run


def _login_id(n: int) -> bool:
    return n >= LOGIN_ID_MIN and n != OVERFLOW_ID


def _root_exempt(rel: str, uid: int, gid: int) -> bool:
    for top, self_too, _why in ROOT_EXEMPT_TREES:
        if rel.startswith(top + "/") or (self_too and rel == top):
            return True
    lo, hi = ROOT_DYNAMIC_IDS
    for top in ROOT_DYNAMIC_TREES:
        if rel.startswith(top + "/"):
            ids = [i for i in (uid, gid) if _login_id(i)]
            if ids and all(lo <= i <= hi for i in ids):
                return True
    return False


def _root_skip_below(rel: str) -> bool:
    if rel in ROOT_NO_DESCEND:
        return True
    return any(rel == top for top, _s, _w in ROOT_EXEMPT_TREES)


def _is_sudoers_file(rel: str) -> bool:
    return rel == SUDOERS_REL or (rel.startswith(SUDOERS_D_REL + "/") and "/" not in rel[len(SUDOERS_D_REL) + 1:])


def _is_system_dir(rel: str) -> bool:
    if rel in ROOT_SYSTEM_DIRS:
        return True
    if rel.startswith("usr/") and "/" not in rel[4:]:
        return True
    return rel.startswith(SUDOERS_D_REL + "/") and "/" not in rel[len(SUDOERS_D_REL) + 1:]


def _id_by_name(data: Optional[bytes], name: str) -> Optional[int]:
    for line in (data or b"").decode("utf-8", "replace").splitlines():
        parts = line.split(":")
        if len(parts) >= 3 and parts[0] == name:
            try:
                return int(parts[2])
            except ValueError:
                return None
    return None


class RootReport:
    def __init__(self, root: str):
        self.root = root
        self.checked = 0
        self.count = 0
        self.findings: list[dict] = []
        self.rc_uid: Optional[int] = None
        self.rc_gid: Optional[int] = None
        self.other_fs: list[dict] = []

    def add(self, rule: str, rel: str, detail: str, uid=None, gid=None, mode=None) -> None:
        self.count += 1
        if len(self.findings) < ROOT_FINDINGS_CAP:
            item = {"rule": rule, "path": "/" + rel, "detail": detail}
            if uid is not None:
                item["owner"] = f"{uid}:{gid}"
            if mode is not None:
                item["mode"] = "%04o" % stat.S_IMODE(mode)
            self.findings.append(item)

    @property
    def ok(self) -> bool:
        return self.count == 0

    def other(self, rel: str, uid: int, gid: int, mode: int) -> None:
        if len(self.other_fs) < ROOT_OTHER_FS_CAP:
            self.other_fs.append({"path": "/" + rel, "owner": f"{uid}:{gid}",
                                  "mode": "%04o" % stat.S_IMODE(mode)})

    def as_dict(self) -> dict:
        rules: dict[str, int] = {}
        for f in self.findings:
            rules[f["rule"]] = rules.get(f["rule"], 0) + 1
        return {"ok": self.ok, "root": self.root, "checked": self.checked, "count": self.count,
                "rules": rules, "findings": self.findings,
                "truncated": self.count > len(self.findings),
                "other_filesystems": self.other_fs,
                "rc_user": {"name": RC_USER, "uid": self.rc_uid, "gid": self.rc_gid}}

    def summary(self, limit: int = 5) -> str:
        if self.ok:
            return f"root invariant ok ({self.checked} paths)"
        head = ", ".join(f"{f['path']} {f['rule']}" + (f" {f['owner']}" if "owner" in f else "")
                         for f in self.findings[:limit])
        more = f" and {self.count - limit} more" if self.count > limit else ""
        return f"root invariant failed: {self.count} problems: {head}{more}"

    def text(self, limit: int = 40) -> str:
        lines = [f"check-root: {self.root}: {'ok' if self.ok else 'FAIL'} "
                 f"({self.checked} paths, {self.count} problems)"]
        for f in self.findings[:limit]:
            owner = f" {f['owner']}" if "owner" in f else ""
            mode = f" mode {f['mode']}" if "mode" in f else ""
            lines.append(f"  {f['rule']:<15} {f['path']}{owner}{mode}  {f['detail']}")
        if self.count > limit:
            lines.append(f"  ... {self.count - limit} more")
        if self.other_fs:
            lines.append("  not checked (other filesystems): " + " ".join(o["path"] for o in self.other_fs))
        return "\n".join(lines)


def _check_root_entry(report: RootReport, rel: str, uid: int, gid: int, mode: int) -> None:
    report.checked += 1
    exempt = _root_exempt(rel, uid, gid)
    rc_ids = (uid == report.rc_uid and report.rc_uid is not None) or \
             (gid == report.rc_gid and report.rc_gid is not None)
    if rc_ids and not exempt:
        report.add("rc-owner", rel, f"owned by the Room Controller user {RC_USER}", uid, gid, mode)
    elif (_login_id(uid) or _login_id(gid)) and not exempt:
        report.add("login-owner", rel, "owned by a login id (>= 1000)", uid, gid, mode)
    elif uid != 0 and not exempt and rel.split("/", 1)[0] in ROOT_SYSTEM_TREES:
        report.add("system-owner", rel, "under /etc, /usr or /opt and not root's", uid, gid, mode)
    if _is_system_dir(rel):
        if uid != 0 or gid != 0:
            report.add("system-dir", rel, "must be root:root", uid, gid, mode)
        elif not stat.S_ISLNK(mode) and stat.S_IMODE(mode) & 0o022:
            report.add("system-dir", rel, "writable by group or other", uid, gid, mode)
    if _is_sudoers_file(rel) and stat.S_ISREG(mode) and stat.S_IMODE(mode) & ~SUDOERS_MODE_MAX:
        report.add("sudoers-mode", rel, "a sudoers file is 0440 (visudo -c)", uid, gid, mode)


_SUDO_INCLUDE = re.compile(r"^(\s*[@#]include(?:dir)?\s+)(\S+)(.*)$")


def visudo_check(files: dict) -> tuple[bool, str]:
    """files: {"etc/sudoers": bytes, "etc/sudoers.d/NAME": bytes}. Runs this host's
    `visudo -c` on a private copy whose includes point into the copy."""
    visudo = shutil.which("visudo") or next(
        (p for p in ("/usr/bin/visudo", "/usr/sbin/visudo") if os.path.exists(p)), None)
    if not visudo:
        return False, "visudo is not installed here; the sudoers cannot be checked"
    tmp = tempfile.mkdtemp(prefix="smartroom-visudo.")
    try:
        os.makedirs(os.path.join(tmp, SUDOERS_D_REL))

        def rewrite(data: bytes) -> bytes:
            out = []
            for line in data.decode("utf-8", "replace").splitlines():
                m = _SUDO_INCLUDE.match(line)
                if m and m.group(2).startswith("/etc/"):
                    line = m.group(1) + tmp + m.group(2) + m.group(3)
                out.append(line)
            return ("\n".join(out) + "\n").encode()

        for rel, data in files.items():
            dest = os.path.join(tmp, rel)
            with open(dest, "wb") as fh:
                fh.write(rewrite(data))
            os.chmod(dest, 0o440)
        done = subprocess.run([visudo, "-c", "-f", os.path.join(tmp, SUDOERS_REL)],
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        return done.returncode == 0, done.stdout.replace(tmp, "").strip()
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def _finish_sudoers(report: RootReport, files: dict, has_sudoers: bool) -> None:
    if not has_sudoers:
        report.add("sudoers-missing", SUDOERS_REL, "no /etc/sudoers (the Room Controller needs sudo)")
        return
    ok, msg = visudo_check(files)
    if not ok:
        report.add("visudo", SUDOERS_REL, "visudo -c failed: " + " | ".join(msg.splitlines()[-6:]))


def _read_small(path: str) -> Optional[bytes]:
    try:
        if os.path.isfile(path) and not os.path.islink(path):
            with open(path, "rb") as fh:
                return fh.read()
    except OSError:
        return None
    return None


def check_root_tree(root: str, translate=None) -> RootReport:
    """The invariant on a directory tree: an image or release root, a staged
    root, or / on a running room. Never follows symlinks. translate(rel, uid,
    gid) -> (uid, gid) is Host.root_ids (the offline tests' fake owners)."""
    root = os.path.abspath(root)
    ids = translate or (lambda _rel, uid, gid: (uid, gid))
    report = RootReport(root)
    report.rc_uid = _id_by_name(_read_small(os.path.join(root, "etc/passwd")), RC_USER)
    report.rc_gid = _id_by_name(_read_small(os.path.join(root, "etc/group")), RC_USER)
    st = os.lstat(root)
    root_dev = st.st_dev
    _check_root_entry(report, "", *ids("", st.st_uid, st.st_gid), st.st_mode)
    stack = [""]
    while stack:
        rel_dir = stack.pop()
        try:
            it = os.scandir(os.path.join(root, rel_dir) if rel_dir else root)
        except (FileNotFoundError, NotADirectoryError):
            continue
        except OSError as exc:
            report.add("unreadable", rel_dir, f"cannot list: {exc.strerror or exc}")
            continue
        with it:
            while True:
                try:
                    entry = next(it)
                except StopIteration:
                    break
                except OSError as exc:
                    report.add("unreadable", rel_dir, f"cannot list: {exc.strerror or exc}")
                    break
                rel = entry.name if not rel_dir else f"{rel_dir}/{entry.name}"
                try:
                    s = entry.stat(follow_symlinks=False)
                except FileNotFoundError:
                    continue
                except OSError as exc:
                    report.add("unreadable", rel, f"cannot stat: {exc.strerror or exc}")
                    continue
                if stat.S_ISDIR(s.st_mode) and s.st_dev != root_dev:
                    # another filesystem or subvolume: not part of this root (nor of a release)
                    report.other(rel, s.st_uid, s.st_gid, s.st_mode)
                    continue
                _check_root_entry(report, rel, *ids(rel, s.st_uid, s.st_gid), s.st_mode)
                if stat.S_ISDIR(s.st_mode) and not _root_skip_below(rel):
                    stack.append(rel)
    files = {}
    data = _read_small(os.path.join(root, SUDOERS_REL))
    if data is not None:
        files[SUDOERS_REL] = data
        d = os.path.join(root, SUDOERS_D_REL)
        if os.path.isdir(d) and not os.path.islink(d):
            for name in sorted(os.listdir(d)):
                more = _read_small(os.path.join(d, name))
                if more is not None:
                    files[f"{SUDOERS_D_REL}/{name}"] = more
    _finish_sudoers(report, files, data is not None)
    return report


# A full btrfs send stream (root.btrfs.zst), replayed for paths, owners and modes
# only, without privileges. File data is kept for sudoers, passwd and group.
_BTRFS_MAGIC = b"btrfs-stream\0"
(_C_SUBVOL, _C_SNAPSHOT, _C_MKFILE, _C_MKDIR, _C_MKNOD, _C_MKFIFO, _C_MKSOCK, _C_SYMLINK,
 _C_RENAME, _C_LINK, _C_UNLINK, _C_RMDIR) = range(1, 13)
_C_WRITE, _C_TRUNCATE, _C_CHMOD, _C_CHOWN, _C_END = 15, 17, 18, 19, 21
# Commands that change a file's contents without plain data: shared-copy
# (clone), no-data sends (update-extent), compressed passthrough (encoded write).
_C_CLONE, _C_UPDATE_EXTENT, _C_ENCODED_WRITE = 16, 22, 25
_A_SIZE, _A_MODE, _A_UID, _A_GID, _A_PATH, _A_PATH_TO, _A_PATH_LINK, _A_OFFSET, _A_DATA = \
    4, 5, 6, 7, 15, 16, 17, 18, 19
_ORPHAN = re.compile(r"^o\d+-\d+-\d+$")
_STREAM_DATA = {SUDOERS_REL, "etc/passwd", "etc/group"}


class _Ino:
    __slots__ = ("kind", "uid", "gid", "mode", "data", "opaque")

    def __init__(self, kind: str):
        self.kind = kind
        self.uid = self.gid = 0
        self.mode = {"d": stat.S_IFDIR | 0o755, "l": stat.S_IFLNK | 0o777}.get(kind, stat.S_IFREG | 0o644)
        self.data: Optional[bytes] = None
        self.opaque = False   # contents arrived in a form this reader does not replay (clone, encoded write)


class _Node:
    __slots__ = ("ino", "kids")

    def __init__(self, ino: _Ino):
        self.ino = ino
        self.kids: Optional[dict] = {} if ino.kind == "d" else None


class _StreamTree:
    def __init__(self):
        self.root = _Node(_Ino("d"))
        self.subvol: Optional[str] = None

    @staticmethod
    def _split(path: str) -> list[str]:
        return [p for p in path.strip("/").split("/") if p and p != "."]

    def lookup(self, path: str) -> _Node:
        node = self.root
        for part in self._split(path):
            if node.kids is None or part not in node.kids:
                raise Fail(f"stream names a missing path: {path}", "bad-stream")
            node = node.kids[part]
        return node

    def _parent(self, path: str) -> tuple[_Node, str]:
        parts = self._split(path)
        if not parts:
            raise Fail("stream creates the root again", "bad-stream")
        node = self.lookup("/".join(parts[:-1]))
        if node.kids is None:
            raise Fail(f"not a directory in stream: {path}", "bad-stream")
        return node, parts[-1]

    def _wants_data(self, path: str) -> bool:
        parts = self._split(path)
        rel = "/".join(parts)
        if rel in _STREAM_DATA or (len(parts) == 3 and rel.startswith(SUDOERS_D_REL + "/")):
            return True
        return bool(parts) and bool(_ORPHAN.match(parts[-1]))

    def apply(self, cmd: int, attrs: dict) -> None:
        path = attrs.get(_A_PATH, b"").decode("utf-8", "surrogateescape")
        u64 = lambda key: struct.unpack("<Q", attrs[key])[0]  # noqa: E731
        if cmd == _C_SUBVOL:
            self.subvol = path
        elif cmd == _C_SNAPSHOT:
            raise Fail("incremental stream (sent with a parent): only a full stream can be checked", "bad-stream")
        elif cmd in (_C_MKDIR, _C_MKFILE, _C_SYMLINK, _C_MKNOD, _C_MKFIFO, _C_MKSOCK):
            kind = {_C_MKDIR: "d", _C_MKFILE: "f", _C_SYMLINK: "l"}.get(cmd, "o")
            parent, name = self._parent(path)
            node = _Node(_Ino(kind))
            if kind == "o" and _A_MODE in attrs:
                node.ino.mode = u64(_A_MODE)
            parent.kids[name] = node
        elif cmd == _C_RENAME:
            sp, sn = self._parent(path)
            node = sp.kids.pop(sn, None)
            if node is None:
                raise Fail(f"stream renames a missing path: {path}", "bad-stream")
            dp, dn = self._parent(attrs[_A_PATH_TO].decode("utf-8", "surrogateescape"))
            dp.kids[dn] = node
        elif cmd == _C_LINK:
            target = self.lookup(attrs[_A_PATH_LINK].decode("utf-8", "surrogateescape"))
            parent, name = self._parent(path)
            parent.kids[name] = _Node(target.ino)
        elif cmd in (_C_UNLINK, _C_RMDIR):
            parent, name = self._parent(path)
            parent.kids.pop(name, None)
        elif cmd == _C_CHOWN:
            ino = self.lookup(path).ino
            ino.uid, ino.gid = u64(_A_UID), u64(_A_GID)
        elif cmd == _C_CHMOD:
            ino = self.lookup(path).ino
            ino.mode = (ino.mode & ~0o7777) | (u64(_A_MODE) & 0o7777)
        elif cmd == _C_WRITE and self._wants_data(path):
            ino = self.lookup(path).ino
            off = u64(_A_OFFSET)
            buf = bytearray(ino.data or b"")
            if len(buf) < off:
                buf.extend(b"\0" * (off - len(buf)))
            chunk = attrs.get(_A_DATA, b"")
            buf[off:off + len(chunk)] = chunk
            ino.data = bytes(buf)
        elif cmd == _C_TRUNCATE:
            ino = self.lookup(path).ino
            if ino.data is not None:
                ino.data = ino.data[:u64(_A_SIZE)]
        elif cmd in (_C_CLONE, _C_UPDATE_EXTENT, _C_ENCODED_WRITE) and self._wants_data(path):
            self.lookup(path).ino.opaque = True
        # utimes, xattrs, clone, fallocate, fileattr: owners and modes untouched

    def walk(self):
        stack = [("", self.root)]
        while stack:
            rel, node = stack.pop()
            yield rel, node
            if node.kids and not _root_skip_below(rel):
                for name, child in node.kids.items():
                    stack.append((name if not rel else f"{rel}/{name}", child))


def _read_btrfs_stream(fh) -> _StreamTree:
    head = fh.read(len(_BTRFS_MAGIC) + 4)
    if len(head) < len(_BTRFS_MAGIC) + 4 or head[:len(_BTRFS_MAGIC)] != _BTRFS_MAGIC:
        raise Fail("not a btrfs send stream", "bad-stream")
    version = struct.unpack("<I", head[len(_BTRFS_MAGIC):])[0]
    if not 1 <= version <= 3:
        raise Fail(f"unknown btrfs send stream version {version}", "bad-stream")
    tree = _StreamTree()
    while True:
        h = fh.read(10)
        if not h:
            raise Fail("stream has no end command (truncated?)", "bad-stream")
        if len(h) < 10:
            raise Fail("stream ends inside a command header", "bad-stream")
        length, cmd, _crc = struct.unpack("<IHI", h)
        payload = fh.read(length)
        if len(payload) < length:
            raise Fail("stream ends inside a command", "bad-stream")
        if cmd == _C_END:
            break
        attrs = {}
        off = 0
        while off < length:
            (atype,) = struct.unpack_from("<H", payload, off)
            if version >= 2 and atype == _A_DATA:
                attrs[atype] = payload[off + 2:]
                break
            (alen,) = struct.unpack_from("<H", payload, off + 2)
            attrs[atype] = payload[off + 4:off + 4 + alen]
            off += 4 + alen
        tree.apply(cmd, attrs)
    if tree.subvol is None:
        raise Fail("stream has no subvolume", "bad-stream")
    return tree


def check_root_stream(path: str) -> RootReport:
    """The invariant on a release's root.btrfs.zst (or an uncompressed stream)."""
    proc = None
    if path.endswith(".zst"):
        if not shutil.which("zstd"):
            raise Fail("zstd is not installed")
        proc = subprocess.Popen(["zstd", "-dcq", path], stdout=subprocess.PIPE, bufsize=1 << 20)
        fh = proc.stdout
    else:
        fh = open(path, "rb")
    try:
        tree = _read_btrfs_stream(fh)
    finally:
        fh.close()
        if proc is not None:
            proc.kill()
            proc.wait()
    report = RootReport(f"{path} (subvolume {tree.subvol})")

    def node_at(rel: str) -> Optional[_Node]:
        try:
            return tree.lookup(rel)
        except Fail:
            return None

    def data(rel: str, required: bool) -> Optional[bytes]:
        """A file's replayed contents. None when it is not a file here. Contents the
        stream does not carry (clone, encoded write; or none at all for a file that
        is never empty) are `unreadable`: an empty sudoers passes visudo, and an
        empty passwd hides the Room Controller user."""
        node = node_at(rel)
        if node is None or node.ino.kind != "f":
            if required and node is not None:
                report.add("unreadable", rel, "not a regular file in the stream")
            return None
        if node.ino.opaque or (required and not node.ino.data):
            report.add("unreadable", rel, "the stream does not carry its contents (shared copy, "
                       "encoded write, or none): the check cannot read it")
        return node.ino.data or b""

    for rel in ("etc/passwd", "etc/group"):
        if node_at(rel) is None:
            report.add("unreadable", rel, "missing: the Room Controller user cannot be looked up")
    report.rc_uid = _id_by_name(data("etc/passwd", True), RC_USER)
    report.rc_gid = _id_by_name(data("etc/group", True), RC_USER)
    for rel, node in tree.walk():
        _check_root_entry(report, rel, node.ino.uid, node.ino.gid, node.ino.mode)
    files = {}
    sudoers = data(SUDOERS_REL, True)
    if sudoers is not None:
        files[SUDOERS_REL] = sudoers
        d = node_at(SUDOERS_D_REL)
        for name, child in sorted(((d.kids or {}) if d else {}).items()):
            if child.ino.kind == "f":
                files[f"{SUDOERS_D_REL}/{name}"] = data(f"{SUDOERS_D_REL}/{name}", False)
    _finish_sudoers(report, files, sudoers is not None)
    return report


def check_root(path: Path, translate=None) -> RootReport:
    """A directory tree, or a btrfs send stream file."""
    if path.is_dir():
        return check_root_tree(str(path), translate)
    return check_root_stream(str(path))


def cmd_check_root(host: Host, args) -> int:
    """0 passes, 1 fails (unsafe), CHECK_ROOT_ERROR when the check could not run."""
    target = Path(args.root) if args.root else host.p("/")
    try:
        if not target.exists():
            raise Fail(f"{target} does not exist", "not-found")
        report = host.check_root(target)
    except Exception as exc:   # noqa: BLE001 - any failure of the check is "check failed", never "unsafe"
        message = exc.message if isinstance(exc, Fail) else f"{type(exc).__name__}: {exc}"
        if args.json:
            print(json.dumps({"ok": None, "error": {"code": "check-failed", "message": message}}))
        print(f"smartroom-release: check-root could not check {target}: {message}", file=sys.stderr)
        return CHECK_ROOT_ERROR
    if args.json:
        print(json.dumps(report.as_dict(), indent=2, sort_keys=True))
    else:
        print(report.text())
    return 0 if report.ok else 1



# --------------------------------------------------------------------------
# health-run: the boot-time service


def record_result(host: Host, state: dict, result: str, **fields: Any) -> None:
    trial = state.get("trial") or {}
    state["last_result"] = {"result": result, "release": trial.get("release"), "number": trial.get("number"),
                            "at": host.stamp(), **fields}


def finish_failed_trial(host: Host, state: dict, reason: str, **fields: Any) -> None:
    if reason not in REASONS:
        raise Fail(f"unknown reason {reason}")
    trial = state.get("trial") or {}
    event(host, state, "rolled-back", reason=reason, release=trial.get("release"),
          to=(state.get("configured") or {}).get("release"), **fields)
    record_result(host, state, "rolled-back", reason=reason, **fields)
    state["trial"] = None
    state["promoting"] = None
    save_state(host, state)
    clear_trial_files(host, state)


def history_push(state: dict, entry: dict) -> None:
    """Keep the last KEEP_GOOD good releases (excluding the configured one)."""
    if not entry or not entry.get("release"):
        return
    hist = [h for h in (state.get("history") or []) if h and h.get("release") != entry.get("release")]
    hist.insert(0, {
        "release": entry["release"], "number": entry.get("number", 0), "root": entry.get("root"),
        "uki": entry.get("uki"), "boot": entry.get("boot"),
    })
    # Configured + history together are the last KEEP_GOOD good releases.
    state["history"] = hist[: max(0, KEEP_GOOD - 1)]
    state["previous"] = state["history"][0] if state["history"] else None


def _promote_steps(host: Host, state: dict) -> None:
    """Mark-good body: fixed, resumable steps. limine.conf is the one switch.

    ESP space for previous was reserved at stage time; durable copies live in boot-store.
    """
    layout = host.layout()
    esp = host.esp()
    trial = state["trial"]
    promo = state.get("promoting") or {"step": 0, "release": trial["release"]}
    state["promoting"] = promo
    if state.get("trial") is None:
        raise Fail("nothing to promote")
    conf = dict(state["configured"])
    configured_uki = layout.configured_uki
    configured_boot = layout.configured_boot
    previous_uki = layout.previous_uki
    previous_boot = layout.previous_boot

    def save(step: int) -> None:
        promo["step"] = step
        save_state(host, state)

    cfg = esp / "limine.conf"
    cmdline = with_subvol(trial["cmdline"], trial["root"] or "@",
                          None if trial["release"] == INSTALLED else trial["release"])
    if promo["step"] < 1:                      # keep the configured set as history/previous
        if conf["release"] != trial["release"]:
            # Durable first (btrfs): promote must not depend on ESP store copies.
            if conf.get("uki") and (esp / conf["uki"]).is_file():
                boot_path = esp / conf["boot"] if layout.uses_aura and conf.get("boot") and (esp / conf["boot"]).is_file() else None
                boot_store_put(host, conf["release"], esp / conf["uki"], boot_path)
                copy_atomic(esp / conf["uki"], esp / previous_uki)
            if layout.uses_aura and conf.get("boot") and (esp / conf["boot"]).is_file():
                copy_atomic(esp / conf["boot"], esp / previous_boot)
            promo["old"] = {"release": conf["release"], "number": conf.get("number", 0), "root": conf["root"],
                            "uki": previous_uki if (esp / previous_uki).is_file() else conf.get("uki"),
                            "boot": previous_boot if layout.uses_aura else conf.get("boot", "")}
        save(1)
    if promo["step"] < 2:                      # the switch: configured entry -> trial UKI + new root
        write_atomic(cfg, set_kernel_entry(strip_trial_entry(cfg.read_text()), trial["uki"], cmdline).encode(), 0o700)
        save(2)
    if promo["step"] < 3:                      # stage 2 (Studio only)
        if layout.uses_aura and trial.get("boot"):
            copy_atomic(esp / trial["boot"], esp / configured_boot)
        save(3)
    if promo["step"] < 4:                      # the UKI under its standard name
        copy_atomic(esp / trial["uki"], esp / configured_uki)
        save(4)
    if promo["step"] < 5:                      # the standard name is now the same bytes: use it
        write_atomic(cfg, set_kernel_entry(cfg.read_text(), configured_uki, cmdline).encode(), 0o700)
        save(5)
    # done: the trial files go, the marker goes, the state names the new configured release
    old = promo.get("old")
    state["configured"] = {"release": trial["release"], "number": trial["number"], "root": trial["root"],
                           "uki": configured_uki, "boot": configured_boot}
    if old:
        history_push(state, old)
    elif state.get("previous"):
        history_push(state, state["previous"])
    # Migration: keep the pre-migration @ root recorded until explicitly discarded.
    if trial.get("kind") == "migrate" and old:
        state["migration"] = {"old_root": old.get("root"), "old_release": old.get("release"),
                              "kept_until_confirmed": True, "at": host.stamp()}
    # Ensure the new configured release is in the boot-store too.
    if (esp / configured_uki).is_file():
        boot_path = esp / configured_boot if layout.uses_aura and configured_boot and (esp / configured_boot).is_file() else None
        with contextlib.suppress(Fail):
            boot_store_put(host, trial["release"], esp / configured_uki, boot_path)
    event(host, state, "marked-good", release=trial["release"], at_uptime=int(host.uptime()))
    record_result(host, state, "committed")
    state["trial"] = None
    state["promoting"] = None
    save_state(host, state)
    clear_trial_files(host, state)
    prune(host, state)
    # Every promotion edit on the live root must finish BEFORE the as-installed
    # snapshot (WS13b): limine defaults, pacman key, integrity manifest/store.
    # Taking the snapshot earlier left /etc/default/limine and the manifest as
    # permanent drift after every update.
    conf_now = state["configured"]
    finalize_promoted_root(host, conf_now["release"], conf_now["root"] or "@")
    import_release_pacman_key(host, host.p("/"))
    host.record_integrity()
    # Frozen "as installed" reference for full-disk drift (WS13). No cleanup
    # algorithm so snapper-cleanup never deletes it; prune of the release root
    # removes the nested .snapshots with the root. Last step on purpose.
    take_as_installed_snapshot(host, conf_now["release"])
    # Home as-installed on @home (survives the next root replace). WS13c.
    take_as_installed_home_snapshot(host, conf_now["release"])


def recover_promote_failure(host: Host, state: dict, exc: Fail) -> None:
    """Leave the room on a release that boots alone; record promote-failed.

    step < 2: Limine still names the configured UKI — fall back to configured, clear trial.
    step >= 2: Limine names the trial UKI — keep trial files and finish naming the trial
    release as configured (bootable via trial paths, then rename when possible).
    """
    layout = host.layout()
    esp = host.esp()
    trial = state.get("trial") or {}
    promo = state.get("promoting") or {}
    step = int(promo.get("step") or 0)
    reason = exc.message
    # Free anything we can; never touch limine until we know the target files exist.
    with contextlib.suppress(Exception):
        esp_offload_non_essential(host, state, for_trial=False)
        migrate_esp_uki_store(host, state)

    if step < 2:
        # Configured files were not switched; fall back cleanly.
        event(host, state, "promote-failed", step=step, reason=reason, action="fallback-configured")
        finish_failed_trial(host, state, "promote-failed", step=step, detail=reason)
        return

    # Limine already points at the trial path + new root. Prefer finishing; if copies
    # fail, keep limine on the trial UKI and record the trial as configured.
    cfg = esp / "limine.conf"
    cmdline = with_subvol(trial.get("cmdline") or "", trial.get("root") or "@",
                          None if trial.get("release") == INSTALLED else trial.get("release"))
    configured_uki = layout.configured_uki
    configured_boot = layout.configured_boot
    try:
        if layout.uses_aura and trial.get("boot") and (esp / trial["boot"]).is_file():
            copy_atomic(esp / trial["boot"], esp / configured_boot)
        if trial.get("uki") and (esp / trial["uki"]).is_file():
            copy_atomic(esp / trial["uki"], esp / configured_uki)
        write_atomic(cfg, set_kernel_entry(strip_trial_entry(cfg.read_text()), configured_uki, cmdline).encode(), 0o700)
        uki_name, boot_name = configured_uki, configured_boot
    except Fail:
        # Stay on trial paths — they boot the new root.
        if trial.get("uki") and (esp / trial["uki"]).is_file():
            write_atomic(cfg, set_kernel_entry(strip_trial_entry(cfg.read_text()), trial["uki"], cmdline).encode(), 0o700)
            uki_name = trial["uki"]
            boot_name = trial.get("boot") or configured_boot
        else:
            # Last resort: previous fallback if present.
            prev_uki = layout.previous_uki
            if (esp / prev_uki).is_file():
                old = promo.get("old") or state.get("previous") or state.get("configured")
                write_atomic(cfg, set_kernel_entry(strip_trial_entry(cfg.read_text()), prev_uki,
                             with_subvol(cmdline, (old or {}).get("root") or "@",
                                         None if (old or {}).get("release") == INSTALLED else (old or {}).get("release"))
                             ).encode(), 0o700)
                state["configured"] = {
                    "release": (old or {}).get("release"), "number": (old or {}).get("number", 0),
                    "root": (old or {}).get("root"), "uki": prev_uki,
                    "boot": layout.previous_boot if layout.uses_aura else "",
                }
                event(host, state, "promote-failed", step=step, reason=reason, action="fallback-previous")
                record_result(host, state, "rolled-back", reason="promote-failed", step=step, detail=reason)
                state["trial"] = None
                state["promoting"] = None
                save_state(host, state)
                clear_trial_files(host, state)
                return
            raise

    old = promo.get("old")
    state["configured"] = {
        "release": trial.get("release"), "number": trial.get("number", 0), "root": trial.get("root"),
        "uki": uki_name, "boot": boot_name,
    }
    if old:
        history_push(state, old)
    event(host, state, "promote-failed", step=step, reason=reason, action="configured-from-trial")
    record_result(host, state, "committed", reason="promote-failed", step=step, detail=reason)
    state["trial"] = None
    state["promoting"] = None
    save_state(host, state)
    # Only remove trial files when limine no longer points at them.
    if uki_name != trial.get("uki"):
        clear_trial_files(host, state)
    else:
        remove(esp / MARKER)
        remove(esp / STATE_DIR / MINI_MARKER)
        cfg_text = cfg.read_text()
        stripped = strip_trial_entry(cfg_text)
        if stripped != cfg_text:
            write_atomic(cfg, stripped.encode(), 0o700)
    prune(host, state)


def promote(host: Host, state: dict) -> None:
    """Mark-good with defined failure: finish or fall back; never half-switched."""
    if state.get("trial") is None and not state.get("promoting"):
        raise Fail("nothing to promote")
    try:
        # One retry after offloading ESP leftovers (covers the WS13d full-ESP case).
        try:
            _promote_steps(host, state)
        except Fail as first:
            if first.code == "esp-full" or "esp full" in first.message.lower() \
                    or "no space" in first.message.lower():
                esp_offload_non_essential(host, state, for_trial=False)
                migrate_esp_uki_store(host, state)
                _promote_steps(host, state)
            else:
                raise
    except Fail as exc:
        recover_promote_failure(host, state, exc)
        raise Fail(exc.message, "promote-failed")


def prune(host: Host, state: dict) -> None:
    keep = {(state.get("configured") or {}).get("root"), running_root(host)}
    if state.get("previous"):
        keep.add(state["previous"].get("root"))
    for entry in state.get("history") or []:
        if entry:
            keep.add(entry.get("root"))
    if state.get("trial"):
        keep.add(state["trial"].get("root"))
    # Migration: never delete the old @ until confirmed.
    mig = state.get("migration") or {}
    if mig.get("kept_until_confirmed") and mig.get("old_root"):
        keep.add(mig["old_root"])
    keep.discard(None)
    keep.discard("")
    with contextlib.suppress(Fail):
        with host.top() as top:
            for child in sorted(top.glob("@r-*")):
                if child.name not in keep:
                    delete_subvolume(host, top, child.name)
            # Also allow pruning of unnamed failed receive leftovers only; never delete @ itself here.
    # Boot files: drop btrfs boot-store and any legacy ESP UKI store copies not kept.
    keep_ids = keep_release_ids(state)
    keep_ids.add(INSTALLED)
    root = boot_store_root(host)
    if root.is_dir():
        for child in sorted(root.iterdir()):
            if child.is_dir() and child.name not in keep_ids and not child.name.startswith("esp-hold-"):
                shutil.rmtree(child, ignore_errors=True)
    esp = host.esp()
    store = esp / STATE_DIR / "uki"
    if store.is_dir():
        for f in store.glob("*.efi"):
            if f.stem not in keep_ids:
                remove(f)
    boot_legacy = esp / STATE_DIR / "boot"
    if boot_legacy.is_dir():
        for f in boot_legacy.glob("*.bin"):
            if f.stem not in keep_ids:
                remove(f)


def healthy_window(samples: list[tuple[float, tuple[int, int, int]]], start: float, now: float,
                   quiet: int, limit: int) -> bool:
    """Five quiet minutes of all-true samples that end within LIMIT seconds of START."""
    horizon = min(now, start + limit)
    run_start = None
    last = None
    for when, flags in samples:
        if when > horizon:
            break
        ok = flags == (1, 1, 1)
        if ok and run_start is None:
            run_start = when
        if not ok:
            run_start = None
        last = when
        if run_start is not None and when - run_start >= quiet:
            return True
    return False


def unsafe_trial(host: Host, state: dict) -> bool:
    """The root invariant on the running trial root. A trial that fails it is never
    kept: record why (ops shows last_result), reboot, the configured release boots.
    A check that cannot run (a tool bug, an error) is not proof of an unsafe root:
    it is logged and shown on ops (status --json rootCheck), and the trial goes on
    as if the check had not run. A tool bug must never strand a room."""
    trial = state.get("trial") or {}
    try:
        report = host.check_root(host.p("/"))
    except Exception as exc:   # noqa: BLE001
        message = exc.message if isinstance(exc, Fail) else f"{type(exc).__name__}: {exc}"
        print(f"smartroom-release: the root check could not run on the trial root: {message}", file=sys.stderr)
        state["root_check"] = {"ok": None, "error": message[:300], "at": host.stamp(),
                               "release": trial.get("release")}
        event(host, state, "root-check-error", release=trial.get("release"), message=message[:300])
        save_state(host, state)
        return False
    state["root_check"] = {"ok": report.ok, "count": report.count, "checked": report.checked,
                           "at": host.stamp(), "release": trial.get("release")}
    if report.ok:
        save_state(host, state)
        return False
    finish_failed_trial(host, state, "unsafe-root", message=report.summary(),
                        count=report.count, findings=report.findings[:20])
    host.reboot()
    host.sleep(120)
    host.hard_reboot()
    return True


def run_health(host: Host, state: dict) -> int:
    trial = state["trial"]
    trial["phase"] = "booting"
    trial["reached"] = True
    trial["reached_at"] = host.stamp()
    event(host, state, "trial-booted", release=trial["release"], uptime=int(host.uptime()))
    save_state(host, state)
    dog = Watchdog(str(host.p(host.conf["watchdog_device"])))
    dog_open = dog.open()
    if not dog_open:
        event(host, state, "watchdog-busy", note="/dev/watchdog was not ours to open; the trial relies on another feeder")
        save_state(host, state)
    stopping = {"flag": False}

    def term(*_a):
        stopping["flag"] = True

    signal.signal(signal.SIGTERM, term)
    if unsafe_trial(host, state):
        return 1
    quiet = host.conf["quiet_seconds"]
    limit = host.conf["limit_seconds"]
    step = host.conf["sample_seconds"]
    start = host.monotonic()
    samples: list[tuple[float, tuple[int, int, int]]] = []
    while True:
        elapsed = host.monotonic() - start
        if stopping["flag"]:
            dog.leave_armed()
            return 0
        flags = healthy_sample(host, trial.get("baseline", {}))
        samples.append((elapsed, flags))
        dog.feed()
        if healthy_window(samples, 0, elapsed, quiet, limit):
            if unsafe_trial(host, state):           # again: the room ran five minutes on it
                return 1
            event(host, state, "health-passed", release=trial["release"], seconds=int(elapsed))
            save_state(host, state)
            try:
                promote(host, state)
            except Fail:
                # Room is on a bootable release (recover_promote_failure). Do not reboot
                # into a half-switched ESP; status JSON already has promote-failed.
                dog.disarm()
                return 1
            dog.disarm()
            return 0
        if elapsed >= limit:
            break
        host.sleep(step)
    # The deadline passed. Stop feeding, record why, and reboot. aura's trial marker is
    # already spent, so the next boot is the configured release.
    last = samples[-1][1] if samples else (0, 0, 0)
    finish_failed_trial(host, state, "health-timeout",
                        connected=bool(last[0]), network=bool(last[1]), displays_ok=bool(last[2]),
                        **({"room_pages_required": room_pages_required(host)} if room_pages_required(host) else {}))
    host.reboot()
    host.sleep(120)
    host.hard_reboot()
    return 1


def cmd_health_run(host: Host, args) -> int:
    state = load_state(host)
    layout = host.layout()
    boot_root = running_root(host)
    trial_boot = host.dt_trial() if layout.uses_aura else None
    if state.get("promoting") and state.get("trial"):
        try:
            promote(host, state)                    # a power cut stopped mark-good half way: finish it
        except Fail as exc:
            # recover_promote_failure already left a bootable release + status reason
            event(host, load_state(host), "promote-gave-up", message=exc.message)
            return 1
        return 0
    trial = state.get("trial")
    if not trial:
        return 0
    if trial.get("phase") == "staged":
        return 0
    if trial.get("armed_boot_id") and trial["armed_boot_id"] == host.boot_id():
        return 0                                    # armed, not rebooted yet
    if layout.uses_aura:
        marker = host.esp() / MARKER
        if marker.is_file() and marker.read_bytes().startswith(b"armed\n") and not host.dt_trial():
            return 0                                # aura has not taken the marker: not attempted yet
    else:
        marker = host.esp() / STATE_DIR / MINI_MARKER
        # Mini: Limine consumes the one-shot on the trial boot; marker stays "armed"
        # until we clear it. Presence alone does not mean "not yet attempted".
    configured_root = (state["configured"] or {}).get("root")
    on_trial_root = boot_root == trial["root"]
    if layout.uses_aura:
        if on_trial_root and trial_boot == trial["boot"]:
            return run_health(host, state)
        if on_trial_root and trial_boot is None and boot_root != configured_root:
            finish_failed_trial(host, state, "trial-did-not-start")
            host.reboot()
            return 1
        if boot_root == configured_root:
            if trial_boot == trial["boot"]:
                finish_failed_trial(host, state, "trial-incomplete")
                return 0
            reason = "lost-after-userspace" if trial.get("reached") else "lost-before-userspace"
            finish_failed_trial(host, state, reason)
            return 0
        return 0
    # Mini: trial = we booted the trial subvolume (one-shot consumed).
    if on_trial_root:
        if marker.is_file() and marker.read_bytes().startswith(b"armed\n"):
            write_atomic(marker, marker.read_bytes().replace(b"armed", b"spent", 1), 0o700)
        return run_health(host, state)
    if boot_root == configured_root:
        reason = "lost-after-userspace" if trial.get("reached") else "lost-before-userspace"
        finish_failed_trial(host, state, reason)
        return 0
    # Bad UKI / firmware hang: rebooted (new boot_id) onto some other root
    # (e.g. factory @) while a trial is still armed. Clear it so the next
    # update/migrate is not blocked by "a trial boot is already pending".
    if trial.get("armed_boot_id") and trial["armed_boot_id"] != host.boot_id():
        reason = "lost-after-userspace" if trial.get("reached") else "lost-before-userspace"
        finish_failed_trial(host, state, reason)
        return 0
    return 0



# --------------------------------------------------------------------------



# --------------------------------------------------------------------------
# migrate: move an OLD Mini install onto a release trial (remote, no USB)


def migrate_preflight(host: Host, force: bool = False) -> dict:
    """Refuse safely when the room is not a known old Mini layout."""
    layout = host.layout()
    if layout.line != "mini":
        raise Fail("migrate is for Intel Minis only (Studio already uses smartroom-release)", "wrong-line")
    esp = host.esp()
    report = {"line": "mini", "checks": []}

    def check(name: str, ok: bool, detail: str = "") -> None:
        report["checks"].append({"name": name, "ok": ok, "detail": detail})
        if not ok and not force:
            raise Fail(f"migrate refused: {name}: {detail or 'failed'}", "migrate-refused")

    # btrfs root (plain @, or snapshot under sd-btrfs-overlayfs)
    if host.prefix:
        fstype = "btrfs"
        check("btrfs-root", True, "prefix")
    else:
        try:
            fstype = host.run(["findmnt", "-no", "FSTYPE", "/"], check=False).stdout.decode().strip()
        except Fail:
            fstype = ""
        try:
            device = host.btrfs_device()
            check("btrfs-root", True, f"{fstype or '?'} via {device}")
        except Fail as e:
            check("btrfs-root", False, f"{fstype or 'unknown'}: {e}")

    # limine.conf + known UKI entry
    cfg = esp / "limine.conf"
    check("limine.conf", cfg.is_file(), str(cfg))
    text = cfg.read_text() if cfg.is_file() else ""
    found = kernel_entry(text) if text else None
    check("limine-uki-entry", found is not None, "no smartroomos_/omarchy_ UKI entry")

    # unexpected / unknown entries: refuse when a password prompt or menu timeout is enabled
    if "timeout:" in text:
        # timeout: 0 or no is fine; positive timeout parks at a menu
        import re as _re
        m = _re.search(r"^timeout:\s*(\S+)", text, _re.M)
        to = (m.group(1) if m else "").strip()
        check("limine-timeout", to in ("0", "no", ""), f"timeout={to}")
    check("no-hash-prompt", "hash_mismatch_panic: yes" not in text, "hash_mismatch_panic would wait for a key")

    # EFI one-shot writable
    efivars = host.p("/sys/firmware/efi/efivars")
    check("efivarfs", host.prefix or efivars.is_dir(), str(efivars))

    # free space: need roughly the size of the current root free on the btrfs device
    with host.top() as top:
        check("top-writable", top.exists() or host.prefix, str(top))
        # require at least 8 GiB free on the filesystem that holds roots
        try:
            free = shutil.disk_usage(top if top.exists() else host.p("/")).free
        except OSError:
            free = 0
        check("free-space", free >= 8 * 1024**3, f"{free // 2**30} GiB free (need >= 8)")

    # firmware password / Secure Boot surprises: if SetupMode is 0 and SecureBoot is 1
    # we still allow Limine one-shot (it uses BootNext-style LoaderEntryOneShot), but
    # refuse when the ESP is not writable.
    try:
        esp_free = shutil.disk_usage(esp).free
    except OSError:
        esp_free = 0
    check("esp-writable", esp_free >= ESP_MARGIN, f"{esp_free // 2**20} MiB ESP free")

    # unknown boot entries: Limine conf should not contain non-SmartRoom OS entries at top level
    for start, end, title in _entry_blocks(text.splitlines() if text else []):
        if title in (TRIAL_ENTRY_NAME,):
            continue
        # nested // entries are fine; top-level / entries that are not SmartRoom* are suspicious
        line0 = text.splitlines()[start] if text else ""
        if line0.startswith("/") and not line0.startswith("//") and not title.lower().startswith("smartroom"):
            # Allow the common Mini title variants
            if title not in ("linux-t2",) and "smartroom" not in title.lower() and "omarchy" not in title.lower():
                check("known-boot-entry", force, f"unexpected Limine entry {title!r}")

    report["ok"] = all(c["ok"] for c in report["checks"])
    return report


def cmd_migrate_check(host: Host, args) -> int:
    require_root(host)
    report = migrate_preflight(host, force=True)  # always report; exit non-zero if any failed
    if args.json:
        print(json.dumps(report, sort_keys=True))
    else:
        for c in report["checks"]:
            print(f"{'ok' if c['ok'] else 'FAIL'}  {c['name']}: {c.get('detail') or ''}")
        print("ready" if report["ok"] else "not-ready")
    return 0 if report["ok"] else 1


def cmd_migrate(host: Host, args) -> int:
    """Install a release beside the old Mini root and arm a trial; old @ is the fallback."""
    require_root(host)
    migrate_preflight(host, force=bool(args.force))
    state = load_state(host)
    # Ensure configured points at the live old root (@) as "installed".
    layout = host.layout()
    live = running_root(host)
    state["configured"] = {
        "release": INSTALLED, "number": 0, "root": live,
        "uki": layout.configured_uki, "boot": layout.configured_boot,
    }
    state["previous"] = None
    state["history"] = state.get("history") or []
    state["migration"] = {"pending": True, "old_root": live, "at": host.stamp()}
    save_state(host, state)
    directory = fetch(host, args.release)
    # Migration may run when the Room Controller is briefly disconnected; still prefer healthy.
    stage_release(host, state, directory, args.unsigned, kind="migrate",
                  require_healthy=not bool(args.force))
    try:
        arm_trial(host, state)
    except Fail:
        clear_trial_files(host, state)
        state["trial"] = None
        event(host, state, "files-written-not-armed", reason="arm failed")
        save_state(host, state)
        raise
    print(f"armed migration trial {state['trial']['release']}: fallback root is {live}")
    if args.reboot:
        host.reboot()
    return 0


def cmd_esp_migrate(host: Host, args) -> int:
    """Move legacy ESP UKI store + ws13d esp-hold files into the btrfs boot-store."""
    require_root(host)
    state = load_state(host)
    hold = Path(args.esp_hold) if getattr(args, "esp_hold", None) else host.p(ESP_HOLD_DEFAULT)
    moved = migrate_esp_uki_store(host, state)
    hold_actions = ingest_esp_hold(host, state, hold=hold)
    # Ensure every kept release is durable, then restore the one ESP fallback.
    # Do not prune boot-store here: migrated orphans (and ws13d hold) stay until
    # a later promote/update prune drops ids outside keep-5.
    esp_offload_non_essential(host, state, for_trial=False)
    with contextlib.suppress(Fail, OSError):
        restore_previous_to_esp(host, state)
    event(host, state, "esp-migrated", moved=len(moved), hold=len(hold_actions))
    save_state(host, state)
    doc = {
        "moved": moved,
        "esp_hold": hold_actions,
        "bootStore": BOOT_STORE,
        "esp": status_doc(host, state).get("esp"),
    }
    if args.json:
        print(json.dumps(doc, sort_keys=True))
    else:
        print(f"boot-store {BOOT_STORE}: moved {len(moved)} ESP store entries, "
              f"{len(hold_actions)} esp-hold actions")
        for line in moved + hold_actions:
            print(f"  {line}")
    return 0


def cmd_confirm_migration(host: Host, args) -> int:
    """After a migrate promotion, allow pruning the old @ once the room is confirmed good."""
    require_root(host)
    state = load_state(host)
    mig = state.get("migration")
    if not mig:
        raise Fail("no migration is pending confirmation", "not-found")
    old = mig.get("old_root")
    state["migration"] = {**mig, "kept_until_confirmed": False, "confirmed_at": host.stamp()}
    event(host, state, "migration-confirmed", old_root=old)
    save_state(host, state)
    prune(host, state)
    # Optionally delete the old @ when it is not the running root and not in history.
    if old and old != "@" and old != running_root(host):
        with host.top() as top:
            if subvol_exists(top, old) and old not in {
                (state.get("configured") or {}).get("root"),
                *((h or {}).get("root") for h in (state.get("history") or [])),
            }:
                delete_subvolume(host, top, old)
    print("migration confirmed")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="smartroom-release", description=__doc__.split("\n\n")[0])
    parser.add_argument("--prefix", default=os.environ.get("SMARTROOM_RELEASE_PREFIX", ""), help=argparse.SUPPRESS)
    parser.add_argument("--json", action="store_true", help="JSON output (status, list); errors too")
    sub = parser.add_subparsers(dest="command", required=True)
    original = sub.add_parser

    def add_parser(name, **kw):
        p = original(name, **kw)
        p.add_argument("--json", action="store_true", dest="json_sub", help=argparse.SUPPRESS)
        return p

    sub.add_parser = add_parser
    for name in ("status", "list"):
        p = sub.add_parser(name)
    for name in ("update", "stage"):
        p = sub.add_parser(name)
        p.add_argument("release")
        p.add_argument("--unsigned", action="store_true", help="development only: skip the signature check")
        p.add_argument("--reboot", action="store_true")
    p = sub.add_parser("arm")
    p.add_argument("--reboot", action="store_true")
    p = sub.add_parser("rollback")
    p.add_argument("--reboot", action="store_true")
    sub.add_parser("discard")
    sub.add_parser("health-run")
    p = sub.add_parser("restore")
    p.add_argument("number", type=int)
    p.add_argument("--no-reboot", action="store_true")
    p = sub.add_parser("build-release")
    p.add_argument("--id", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--source-subvol")
    p.add_argument("--boot-from")
    p.add_argument("--uki-from")
    p.add_argument("--parent")
    p.add_argument("--sign-key")
    p.add_argument("--source-path", help="a btrfs subvolume to release instead of this room's root "
                   "(a build host: the @ of a mounted image root.img)")
    p.add_argument("--line", choices=("studio", "mini"), help="the release's line (default: this room's)")
    p.add_argument("--source-info", action="append", default=[], metavar="KEY=VALUE",
                   help="recorded in manifest source (firmware=COMMIT, pkgs=COMMIT, ...)")
    p = sub.add_parser("check-root", help="the root invariant on a root directory or a root.btrfs.zst "
                       "(exit 0 ok, 1 unsafe, 3 the check could not run)")
    p.add_argument("root", nargs="?", help="directory or btrfs send stream (default: this room's /)")
    p = sub.add_parser("check-kept", help="the root invariant on the kept rollback roots (information; "
                       "cached for status --json)")
    p.add_argument("--max-age", type=int, default=None,
                   help="reuse the last result when younger than this many seconds and the same roots")
    p = sub.add_parser("migrate-check")
    p = sub.add_parser("migrate")
    p.add_argument("release")
    p.add_argument("--unsigned", action="store_true")
    p.add_argument("--reboot", action="store_true")
    p.add_argument("--force", action="store_true", help="override non-fatal preflight refusals (still refuses wrong line)")
    sub.add_parser("confirm-migration")
    p = sub.add_parser("esp-migrate")
    p.add_argument("--esp-hold", help=f"parked ESP files directory (default {ESP_HOLD_DEFAULT})")
    return parser


COMMANDS = {
    "status": cmd_status, "list": cmd_list, "update": cmd_update, "stage": cmd_stage, "arm": cmd_arm,
    "rollback": cmd_rollback, "discard": cmd_discard, "health-run": cmd_health_run, "restore": cmd_restore,
    "build-release": cmd_build_release, "migrate": cmd_migrate, "migrate-check": cmd_migrate_check,
    "confirm-migration": cmd_confirm_migration, "esp-migrate": cmd_esp_migrate,
    "check-root": cmd_check_root, "check-kept": cmd_check_kept,
}


def main(argv: Optional[list[str]] = None, host: Optional[Host] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    args = build_parser().parse_args(argv)
    args.json = bool(args.json or getattr(args, "json_sub", False))
    host = host or Host(args.prefix)
    try:
        return COMMANDS[args.command](host, args)
    except Fail as exc:
        if args.json:
            print(json.dumps({"error": {"code": exc.code, "message": exc.message}}))
        print(f"smartroom-release: {exc.message}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
