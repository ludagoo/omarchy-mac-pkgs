ESP_MARGIN = 32 * 1024 * 1024
# Durable boot files for kept releases live on the system disk (btrfs), not the ESP.
# The ESP only holds what the next boot and its one fallback need (WS14).
BOOT_STORE = "/var/lib/smartroomos/boot-store"
ESP_HOLD_DEFAULT = "/var/lib/srbuild/esp-hold"

# Reasons a trial ends without becoming the configured release.
REASONS = (
    "health-timeout",        # this program saw the deadline pass and rebooted
    "lost-after-userspace",  # reached userspace, then the room reset (panic or watchdog)
    "lost-before-userspace", # never reached userspace (bad file, early panic, loader hang)
    "trial-did-not-start",   # Limine ran the trial entry but the trial boot image never ran
    "trial-incomplete",      # the trial boot image ran but Limine booted the configured entry
    "promote-failed",        # mark-good could not finish; room left on a bootable release
    "unsafe-root",           # the trial root fails the root invariant (check-root): never kept
)


KEEP_GOOD = 5  # last N good releases kept on disk (Lucas decision 3)
# Cap on /var/lib/smartroomos/drift-archive when carried into a new root.
# Archives hold hand-change records Lucas requires; drop content only with a
# content_pruned mark (never silently). 256 MiB keeps Mini updates off ENOSPC.
DRIFT_ARCHIVE_CARRY_MAX = 256 * 1024 * 1024
MINI_MARKER = "trial.marker"  # ESP smartroom-release/trial.marker (Mini; no aura-try)


class BootLayout(NamedTuple):
    """Per-line boot file names. Studio uses aura stage2; Mini uses UKI only."""
    line: str
    configured_uki: str
    trial_uki: str
    previous_uki: str
    configured_boot: str
    trial_boot: str
    previous_boot: str
    uses_aura: bool
    uki_needle: str  # substring that marks the configured Limine kernel entry


