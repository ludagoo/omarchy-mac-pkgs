TRIAL_ENTRY_NAME = "SmartRoom Release Trial"
TRIAL_ENTRY_ID = "SmartRoom-Release-Trial"
BLI_GUID = "4a67b082-0a4c-41cf-b6c7-440b29bb8c4f"
ONESHOT = f"LoaderEntryOneShot-{BLI_GUID}"
EFI_VARS_SAVE = "/usr/lib/omarchy/mac-boot/efi-vars-save"
