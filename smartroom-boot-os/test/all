#!/bin/bash
# smartroom-boot-os tests:
# 1. Simulated aurora-bless (Apple Silicon): --list-volumes, --get-boot [--next],
#    --set-boot NAME [--next] --yes, --clear-next.
# 2. Simulated efibootmgr + efivars (Intel T2 Macmini8,1): BootOrder, BootNext,
#    --create missing firmware entry, recreating missing macOS Boot#### from
#    /boot/smartroomos/macos-boot-device.bin, syncing Apple efi-boot-* efivars,
#    status, refusals, and --reboot.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
fail() { echo "not ok - $*" >&2; exit 1; }

# ---- Part 1: Apple Silicon (aurora-bless) -----------------------------------
cat >"$t/bless" <<'SH'
#!/bin/bash
s=$STATE; next=0; set_name=""; mode=""
while (($#)); do
  case $1 in
    --list-volumes) mode=list ;; --get-boot) mode=get ;; --clear-next) mode=clear ;;
    --set-boot) mode=set; set_name=$2; shift ;; --next|-n) next=1 ;; --yes|-y) ;;
    *) echo "fake bless: $1" >&2; exit 2 ;;
  esac
  shift
done
def=$(cat "$s/boot-volume" 2>/dev/null || true); alt=$(cat "$s/alt-boot-volume" 2>/dev/null || true)
case $mode in
  list) i=0; while IFS= read -r n; do i=$((i + 1)); m=" "; [[ $n == "$def" ]] && m="*"; echo "$m$i) $n"; done <"$s/volumes" ;;
  get) v=$def; ((next)) && [[ -n $alt ]] && v=$alt; [[ -n $v ]] || { echo "Error: Unable to parse current nvram contents" >&2; exit 1; }; echo "$v" ;;
  clear) if [[ -n $alt ]]; then rm -f "$s/alt-boot-volume"; echo "Cleared next boot target"; else echo "Next boot target was already empty"; fi ;;
  set) grep -qixF "$set_name" "$s/volumes" || { echo "Error: Unable to find specified volume" >&2; exit 1; }
       n=$(grep -ixF "$set_name" "$s/volumes" | head -n 1)
       echo "Will set volume $n as the ..."; if ((next)); then echo "$n" >"$s/alt-boot-volume"; else echo "$n" >"$s/boot-volume"; fi ;;
esac
SH
chmod +x "$t/bless"
cat >"$t/systemctl" <<SH
#!/bin/bash
echo "\$*" >>"$t/systemctl.log"
SH
chmod +x "$t/systemctl"
sed -e 's/^(( EUID == 0 )) || die "run as root"$/:/' -e "s|^PATH=/usr/bin:/usr/sbin:/bin|PATH=$t:/usr/bin:/usr/sbin:/bin|" \
  "$here/../smartroom-boot-os" >"$t/sbo"; chmod +x "$t/sbo"
export STATE=$t/s SMARTROOM_BOOT_OS_BLESS=$t/bless SMARTROOM_BOOT_OS_LIMINE_DEFAULTS=$t/limine
# Never the host's own unit role: a test unit is written below when wanted.
export SMARTROOM_BOOT_OS_UNIT_ROLE=$t/unit-role
mkdir -p "$STATE"
printf 'TARGET_OS_NAME="SmartRoom Firmware"\n' >"$t/limine"
reset() { printf '%s\n' "$@" >"$STATE/volumes"; rm -f "$STATE/boot-volume" "$STATE/alt-boot-volume"; }

reset "Macintosh HD" "SmartRoom Firmware"; echo "SmartRoom Firmware" >"$STATE/boot-volume"
out=$("$t/sbo" macos --once) || fail "macos --once: $out"
[[ $(cat "$STATE/alt-boot-volume") == "Macintosh HD" && $(cat "$STATE/boot-volume") == "SmartRoom Firmware" ]] || fail "macos --once state"
[[ $out == "next start: Macintosh HD" ]] || fail "macos --once said: $out"
echo "ok - macos --once sets only the next start"

out=$("$t/sbo" firmware) || fail "firmware: $out"
[[ ! -e $STATE/alt-boot-volume && $(cat "$STATE/boot-volume") == "SmartRoom Firmware" ]] || fail "firmware did not clear the pending next start"
echo "ok - firmware as default clears a pending next start"

# A test unit keeps macOS as its default: firmware only once, or with --force.
printf '# role\ntest\n' >"$t/unit-role"
reset "Macintosh HD" "SmartRoom Firmware"; echo "Macintosh HD" >"$STATE/boot-volume"
if "$t/sbo" firmware 2>"$t/err"; then fail "a test unit took the firmware as its default"; fi
grep -q 'test unit' "$t/err" && [[ $(cat "$STATE/boot-volume") == "Macintosh HD" ]] || fail "test unit refusal: $(cat "$t/err")"
"$t/sbo" firmware --once >/dev/null || fail "a test unit refused a one-shot firmware start"
[[ $(cat "$STATE/alt-boot-volume") == "SmartRoom Firmware" && $(cat "$STATE/boot-volume") == "Macintosh HD" ]] || fail "test unit --once state"
"$t/sbo" firmware --force >/dev/null || fail "--force on a test unit"
[[ $(cat "$STATE/boot-volume") == "SmartRoom Firmware" ]] || fail "--force did not set the default"
printf 'room\n' >"$t/unit-role"; echo "Macintosh HD" >"$STATE/boot-volume"
"$t/sbo" firmware >/dev/null && [[ $(cat "$STATE/boot-volume") == "SmartRoom Firmware" ]] || fail "a room must take the firmware as its default"
rm -f "$t/unit-role"
echo "ok - a test unit keeps macOS as its default (firmware --once, or --force)"

out=$("$t/sbo" macos --reboot) || fail "macos: $out"
[[ $(cat "$STATE/boot-volume") == "Macintosh HD" && $(cat "$t/systemctl.log") == reboot ]] || fail "macos default + reboot"
out=$("$t/sbo" firmware --once) && [[ $(cat "$STATE/alt-boot-volume") == "SmartRoom Firmware" ]] || fail "firmware --once"
st=$("$t/sbo" status); grep -qx 'default: Macintosh HD' <<<"$st" && grep -qx 'next:    SmartRoom Firmware' <<<"$st" || fail "status: $st"
echo "ok - macos as default with --reboot, firmware --once, status"

reset "Macintosh HD" "SmartRoomOS"
"$t/sbo" firmware >/dev/null && [[ $(cat "$STATE/boot-volume") == SmartRoomOS ]] || fail "legacy SmartRoomOS stub"
echo "ok - finds a legacy SmartRoomOS stub"

reset "Macintosh HD" "Macintosh HD 2" "SmartRoom Firmware"
"$t/sbo" macos >"$t/out" 2>&1 && fail "two macOS volumes accepted"
grep -q "cannot tell which startup volume is macOS" "$t/out" || fail "wrong refusal: $(cat "$t/out")"
SMARTROOM_BOOT_OS_MACOS="Macintosh HD 2" "$t/sbo" macos >/dev/null && [[ $(cat "$STATE/boot-volume") == "Macintosh HD 2" ]] || fail "SMARTROOM_BOOT_OS_MACOS"
SMARTROOM_BOOT_OS_MACOS="SmartRoom Firmware" "$t/sbo" macos >/dev/null 2>&1 && fail "the firmware accepted as macOS"
echo "ok - refuses an ambiguous macOS unless named, never takes a Linux volume for macOS"

reset "Room Mac" "SmartRoom Firmware" "Omarchy"
"$t/sbo" macos >/dev/null && [[ $(cat "$STATE/boot-volume") == "Room Mac" ]] || fail "renamed macOS beside Omarchy"
reset "Macintosh HD"
"$t/sbo" firmware >"$t/out" 2>&1 && fail "firmware without a stub accepted"
reset "Macintosh HD" "SmartRoom Firmware" "SmartRoom Firmware"
"$t/sbo" firmware >"$t/out" 2>&1 && fail "two firmware volumes accepted"
"$t/sbo" status --once >/dev/null 2>&1 && fail "status --once accepted"
"$t/sbo" >/dev/null 2>&1 && fail "no target accepted"
echo "ok - a renamed macOS; refuses no stub, two stubs and bad usage"
grep -q '^(( EUID == 0 )) || die "run as root"$' "$here/../smartroom-boot-os" || fail "the root check moved"

# ---- Part 2: Intel T2 Macmini8,1 (efibootmgr + efivars) --------------------
unset STATE SMARTROOM_BOOT_OS_BLESS
efi_state=$t/efi_state.json
efivars=$t/efivars
esp=$t/esp
meta=$esp/smartroomos
mkdir -p "$efivars" "$esp/EFI/BOOT" "$meta"
: >"$esp/EFI/BOOT/BOOTX64.EFI"
: >"$t/systemctl.log"
printf '<array><dict><key>IOMatch</key><dict/></dict></array>\n' >"$meta/macos-boot-device.xml"
printf '\x04\x04\x18\x00\x31\x00\x00\x00\x7f\xff\x04\x00' >"$meta/macos-boot-device.bin"
printf '<array><dict><key>Path</key><string>\\EFI\\BOOT\\BOOTX64.EFI</string></dict></array>\n' >"$meta/firmware-boot-device.xml"
printf '\x04\x01\x2a\x00\x02\x00\x00\x00\x7f\xff\x04\x00' >"$meta/firmware-boot-device.bin"

APPLE_GUID="7c436110-ab2a-4bbb-a880-fe41995c9f82"
GLOBAL_GUID="8be4df61-93ca-11d2-aa0d-00e098032b8c"
# Seed initial Apple efi-boot-device files in efivars as Linux efivarfs shows them
printf '\x07\x00\x00\x00initial' >"$efivars/efi-boot-device-${APPLE_GUID}"
printf '\x07\x00\x00\x00initial' >"$efivars/efi-boot-device-data-${APPLE_GUID}"

cat >"$t/efibootmgr" <<PY
#!/usr/bin/python3
import json, os, pathlib, struct, sys

STATE = "$efi_state"
EFIVARS = pathlib.Path("$efivars")
GLOBAL = "$GLOBAL_GUID"
s = json.load(open(STATE))
a = sys.argv[1:]

# Pick up any BootXXXX efivars written directly by smartroom-boot-os
for p in sorted(EFIVARS.glob(f"Boot*-{GLOBAL}")):
    bid = p.name[4:8].upper()
    if any(e["id"] == bid for e in s["entries"]):
        continue
    raw = p.read_bytes()[4:]  # strip 4-byte efivarfs attributes
    attr, dp_len = struct.unpack_from("<IH", raw, 0)
    desc_bytes = raw[6:len(raw) - dp_len]
    desc = desc_bytes.decode("utf-16le").rstrip("\x00")
    dp = raw[-dp_len:]
    rest = r"VenMedia(be74fcf7-0b7c-49f3-9147-01f4042e6842)/File(\\System\\Library\\CoreServices\\boot.efi)"
    s["entries"].append({"id": bid, "active": bool(attr & 1), "label": desc, "rest": rest, "dp_len": len(dp)})
    json.dump(s, open(STATE, "w"))

if a == ["-v"]:
    if s.get("current"): print(f"BootCurrent: {s['current']}")
    if s.get("next"): print(f"BootNext: {s['next']}")
    print("BootOrder: " + ",".join(s["order"]))
    for e in s["entries"]:
        star = "*" if e.get("active", True) else " "
        print(f"Boot{e['id']}{star} {e['label']}\t{e['rest']}")
    sys.exit(0)

if "--bootnext" in a:
    s["next"] = a[a.index("--bootnext") + 1].upper()
    json.dump(s, open(STATE, "w")); sys.exit(0)
if "--delete-bootnext" in a:
    s["next"] = None
    json.dump(s, open(STATE, "w")); sys.exit(0)
if "--bootorder" in a:
    s["order"] = [x.upper() for x in a[a.index("--bootorder") + 1].split(",") if x]
    json.dump(s, open(STATE, "w")); sys.exit(0)
if "--create" in a:
    label = a[a.index("--label") + 1]
    loader = a[a.index("--loader") + 1]
    used = {e["id"] for e in s["entries"]}
    nid = next(f"{i:04X}" for i in range(0x80, 0x90) if f"{i:04X}" not in used)
    s["entries"].append({
        "id": nid, "active": True, "label": label,
        "rest": f"HD(2,GPT,{s['partuuid']},0x100,0x400)/File({loader})"
    })
    s["order"] = [nid] + s["order"]
    json.dump(s, open(STATE, "w")); sys.exit(0)
sys.stderr.write(f"fake efibootmgr unexpected args: {a}\n")
sys.exit(2)
PY
chmod +x "$t/efibootmgr"

PARTUUID="2abf9f91-1111-2222-3333-444455556666"
cat >"$efi_state" <<EOF
{"current": "0080", "next": null, "order": ["0080"], "partuuid": "$PARTUUID",
 "entries": [
   {"id": "0080", "active": true, "label": "SmartRoom Firmware",
    "rest": "HD(2,GPT,$PARTUUID,0x100,0x400)/File(\\\\EFI\\\\BOOT\\\\BOOTX64.EFI)"}
 ]}
EOF

export SMARTROOM_BOOT_OS_BACKEND=efibootmgr
export SMARTROOM_BOOT_OS_EFIBOOTMGR=$t/efibootmgr
export SMARTROOM_BOOT_OS_ESP_DIR=$esp
export SMARTROOM_BOOT_OS_META_DIR=$meta
export SMARTROOM_BOOT_OS_EFIVARS=$efivars
export SMARTROOM_BOOT_OS_ESP_PARTUUID=$PARTUUID
export SMARTROOM_BOOT_OS_ESP_DISK=/dev/nvme0n1
export SMARTROOM_BOOT_OS_ESP_PART=2

# Scenario A: macOS BootXXXX was overwritten by bless; smartroom-boot-os reconstructs it from saved binary
st=$("$t/sbo" status)
grep -qx 'default: SmartRoom Firmware' <<<"$st" || fail "efi initial status default: $st"
grep -qx 'next:    none' <<<"$st" || fail "efi initial status next: $st"
grep -q '"macOS (saved)"' <<<"$st" || fail "efi status should show saved macOS: $st"

out=$("$t/sbo" macos --once --reboot) || fail "efi macos --once: $out"
[[ $out == "next start: macOS" ]] || fail "efi macos --once output: $out"
[[ $(cat "$t/systemctl.log") == reboot ]] || fail "efi macos --once --reboot did not reboot"
st=$("$t/sbo" status)
grep -qx 'default: SmartRoom Firmware' <<<"$st" || fail "efi default changed on --once: $st"
grep -qx 'next:    macOS' <<<"$st" || fail "efi next not macOS: $st"
[[ -s $efivars/Boot0081-${GLOBAL_GUID} ]] || fail "did not reconstruct Boot0081 efivar"
[[ -s $efivars/efi-boot-next-${APPLE_GUID} && -s $efivars/efi-boot-next-data-${APPLE_GUID} ]] \
  || fail "did not write Apple efi-boot-next* efivars"
echo "ok - Intel Mini: reconstructed Boot0081 from saved macOS metadata, BootNext + Apple efi-boot-next"

# Scenario B: persistent switch to macOS clears BootNext and Apple efi-boot-next*
out=$("$t/sbo" macos) || fail "efi macos default: $out"
[[ $out == "default: macOS" ]] || fail "efi macos output: $out"
st=$("$t/sbo" status)
grep -qx 'default: macOS' <<<"$st" || fail "efi default not macOS: $st"
grep -qx 'next:    none' <<<"$st" || fail "efi next not cleared: $st"
[[ ! -e $efivars/efi-boot-next-${APPLE_GUID} && ! -e $efivars/efi-boot-next-data-${APPLE_GUID} ]] \
  || fail "Apple efi-boot-next* not cleared on persistent switch"
grep -q '^....initial' "$efivars/efi-boot-device-${APPLE_GUID}" && fail "Apple efi-boot-device was not updated"
echo "ok - Intel Mini: macos persistent updates BootOrder, clears BootNext & Apple next vars"

# Scenario C: firmware recreated if missing from NVRAM, then set as default
cat >"$efi_state" <<EOF
{"current": "0000", "next": "0000", "order": ["0000"], "partuuid": "$PARTUUID",
 "entries": [
   {"id": "0000", "active": true, "label": "Mac OS X",
    "rest": "PciRoot(0x0)/VenMedia(be74fcf7-0b7c-49f3-9147-01f4042e6842)/File(\\\\System\\\\Library\\\\CoreServices\\\\boot.efi)"}
 ]}
EOF
out=$("$t/sbo" firmware) || fail "efi firmware recreate: $out"
[[ $out == "default: SmartRoom Firmware" ]] || fail "efi firmware output: $out"
st=$("$t/sbo" status)
grep -qx 'default: SmartRoom Firmware' <<<"$st" || fail "efi recreated firmware not default: $st"
grep -qx 'next:    none' <<<"$st" || fail "efi recreated firmware left BootNext: $st"
echo "ok - Intel Mini: creates missing SmartRoom Firmware entry via efibootmgr --create"

# Scenario D: auto-detects efibootmgr on x86_64 without SMARTROOM_BOOT_OS_BACKEND
printf '#!/bin/bash\necho x86_64\n' >"$t/uname"; chmod +x "$t/uname"
st=$(env -u SMARTROOM_BOOT_OS_BACKEND "$t/sbo" status)
grep -qx 'default: SmartRoom Firmware' <<<"$st" || fail "x86_64 auto-detect status failed: $st"
echo "ok - auto-detects efibootmgr on x86_64 without env override"
